# Old conditions lived at /blog/conditions/<slug>-physiotherapy; new at /conditions/<slug>.
# Format: /source  /destination  <status>. Specific rules first, wildcards last.

/blog/conditions/prenatal-physiotherapy            /conditions/prenatal-care            301
/blog/conditions/diastasis-recti-physiotherapy     /conditions/diastasis-recti          301
/blog/conditions/caesarean-recovery-physiotherapy  /conditions/caesarean-recovery       301
/blog/conditions/perineal-tear-physiotherapy       /conditions/perineal-tear            301
/blog/conditions/urinary-incontinence-physiotherapy /conditions/urinary-incontinence    301
/blog/conditions/pelvic-organ-prolapse-physiotherapy /conditions/pelvic-organ-prolapse  301
/blog/conditions/pelvic-pain-physiotherapy         /conditions/pelvic-pain              301
/blog/conditions/pelvic-girdle-pain-physiotherapy  /conditions/pelvic-girdle-pain       301
