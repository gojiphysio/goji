---
/**
 * BerrySprig — Lycium barbarum (Goji berry) botanical motif.
 *
 * Filled botanical illustration style based on the A. Moreau plate:
 * - Leaves: filled oval shapes with midrib (22% opacity to distinguish from berries)
 * - Flowers: filled 6-petal star with dark centre (55% opacity, botanical)
 * - Berries: fully filled pendant ovals (100% opacity)
 * - Branches: fine line strokes
 *
 * animate={true} lifecycle animation:
 *   0.00–0.60 s  Branches draw in (stroke-dashoffset)
 *   0.30–0.65 s  Leaves fade in
 *   0.60–1.40 s  6-petal flowers bloom (scale 0 → bud → open star → fade)
 *   1.10–2.00 s  Berries ripen (fill-opacity 0 → 1 with spring)
 */
interface Props {
  animate?: boolean;
  class?: string;
  "aria-hidden"?: boolean;
  width?: number | string;
  height?: number | string;
}
const {
  animate = false,
  class: className,
  "aria-hidden": ariaHidden = true,
  width = 120,
  height = "auto",
} = Astro.props;
---

<svg
  class:list={["berry-sprig", animate && "berry-sprig--animated", className]}
  viewBox="0 0 115 185"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  width={width}
  height={height}
  aria-hidden={ariaHidden}
  role="img"
>
  <!-- ══════════════════════════════════════════════════════════
       BRANCHES  (pathLength="1" for draw-in animation)
       ══════════════════════════════════════════════════════════ -->
  <path class="branch" style="--d:0s"
    d="M 20 180 C 24 150 32 115 39 85 C 44 60 48 38 50 16"
    pathLength="1" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/>
  <path class="branch" style="--d:0.1s"
    d="M 46 40 C 62 30 78 22 96 18"
    pathLength="1" stroke="currentColor" stroke-width="0.6" stroke-linecap="round"/>
  <path class="branch" style="--d:0.15s"
    d="M 38 86 C 54 76 70 69 88 65"
    pathLength="1" stroke="currentColor" stroke-width="0.6" stroke-linecap="round"/>
  <path class="branch" style="--d:0.2s"
    d="M 32 112 C 22 106 12 102 5 99"
    pathLength="1" stroke="currentColor" stroke-width="0.5" stroke-linecap="round"/>
  <path class="branch" style="--d:0.25s"
    d="M 26 144 C 36 138 42 134 48 132"
    pathLength="1" stroke="currentColor" stroke-width="0.45" stroke-linecap="round"/>
  <!-- Pedicels -->
  <path class="branch" style="--d:0.4s" d="M 5 99 L 5 88"     pathLength="1" stroke="currentColor" stroke-width="0.35" stroke-linecap="round"/>
  <path class="branch" style="--d:0.4s" d="M 88 65 L 90 54"   pathLength="1" stroke="currentColor" stroke-width="0.35" stroke-linecap="round"/>
  <path class="branch" style="--d:0.4s" d="M 64 71 L 64 60"   pathLength="1" stroke="currentColor" stroke-width="0.35" stroke-linecap="round"/>
  <path class="branch" style="--d:0.4s" d="M 96 18 L 99 6"    pathLength="1" stroke="currentColor" stroke-width="0.35" stroke-linecap="round"/>
  <path class="branch" style="--d:0.4s" d="M 72 24 L 72 13"   pathLength="1" stroke="currentColor" stroke-width="0.35" stroke-linecap="round"/>
  <path class="branch" style="--d:0.4s" d="M 50 16 L 46 5"    pathLength="1" stroke="currentColor" stroke-width="0.35" stroke-linecap="round"/>
  <path class="branch" style="--d:0.4s" d="M 48 132 L 52 122" pathLength="1" stroke="currentColor" stroke-width="0.35" stroke-linecap="round"/>
  <path class="branch" style="--d:0.4s" d="M 30 152 L 26 142" pathLength="1" stroke="currentColor" stroke-width="0.35" stroke-linecap="round"/>

  <!-- ══════════════════════════════════════════════════════════
       LEAVES — filled broad-oval shapes with midrib.
       Each leaf is drawn in local coords (0,0 = attachment point,
       pointing in the -y direction), then translate+rotated into place.
       fill-opacity 0.22 makes leaves visually distinct from berries.
       ══════════════════════════════════════════════════════════ -->

  <!-- Main stem — alternating left / right (like Lycium phyllotaxis) -->
  <g class="leaf" style="--ld:0.30s" transform="translate(24,127) rotate(-35)">
    <ellipse rx="3.5" ry="8" fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="0.4" stroke-opacity="0.5"/>
    <line x1="0" y1="-7" x2="0" y2="7" stroke="currentColor" stroke-width="0.3" stroke-opacity="0.4"/>
  </g>
  <g class="leaf" style="--ld:0.32s" transform="translate(42,91) rotate(30)">
    <ellipse rx="3.5" ry="8" fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="0.4" stroke-opacity="0.5"/>
    <line x1="0" y1="-7" x2="0" y2="7" stroke="currentColor" stroke-width="0.3" stroke-opacity="0.4"/>
  </g>
