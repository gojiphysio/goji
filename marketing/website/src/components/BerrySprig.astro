<style>
  /* ── STATIC STATE ── */
  .flower-node { display: none; }

  /* ── ANIMATED STATE ── */
  @media (prefers-reduced-motion: no-preference) {

    /* 1. Branches draw in */
    .berry-sprig--animated .branch {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: sprig-draw 0.65s cubic-bezier(0.4, 0, 0.2, 1) var(--d, 0s) both;
    }

    /* 2. Leaves fade in after branches */
    .berry-sprig--animated .leaf {
      opacity: 0;
