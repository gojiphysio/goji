---
/**
 * Commercial hub for the national query "women's health physiotherapy
 * Singapore". The topic was previously split across the homepage, /services
 * and the individual service and condition pages, leaving Google no single
 * URL to rank for the broad term (2026-08 SEO review; ../../seo/seo-geo-review.md).
 *
 * This page is a HUB: it summarises each area in a few lines and hands off to
 * the page that owns that keyword. Every card links down to a service or
 * condition page, and those pages link back up here — the internal-link
 * structure is the point.
 *
 * Since 2026-11 it is also an answer-first explainer for the generic query
 * ("women's health physiotherapy", GSC pos ~54): question-shaped H2s (what is
 * it, which conditions, first appointment, referral, cost). The conditions
 * table only RESTATES each condition page's "What does a session involve"
 * section; any new clinical claim here needs a primary source linked inline
 * and listed in `sources` (emitted as `citation` in the JSON-LD).
 *
 * Compliance (Lane A, ../../strategy/03-compliance-guardrails.md): education
 * first, no superlatives, no comparisons, no cure or outcome guarantees, no
 * testimonials, plain prices. The 2026-08 review suggested adding patient
 * testimonials — deliberately NOT done, they are off-limits by default on the
 * clinical side.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqList from "../components/FaqList.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import { SITE } from "../lib/site.ts";
import { clinicRef } from "../lib/schema.ts";

const title = "Women's Health Physiotherapy Singapore | Goji Physio";
const description =
  "Women's health physiotherapy in Singapore for pelvic floor, pregnancy, postnatal recovery, pelvic pain and menopause. Female AHPC-registered physios at Lentor.";

/** The four appointment types that make up the women's health service. */
const services = [
  {
    href: "/services/pelvic-floor-physiotherapy/",
    name: "Pelvic Floor Physiotherapy",
    mins: 55,
    price: 260,
    lead:
      "Assessment and treatment for bladder, bowel, pelvic floor or pelvic pain concerns, whether your symptoms are new, longstanding or changing around menopause.",
  },
  {
    href: "/services/prenatal-physiotherapy/",
    name: "Prenatal Physiotherapy",
    mins: 55,
    price: 260,
    lead:
      "Support to move comfortably through pregnancy, manage pain and pelvic floor symptoms, and prepare your body for birth.",
  },
  {
    href: "/services/postpartum-physiotherapy/",
    name: "Postpartum Physiotherapy",
    mins: 55,
    price: 260,
    lead:
      "A check of how your body is recovering after a vaginal or Caesarean birth, and a plan for returning to movement, exercise and sport.",
  },
  {
    href: "/services/mummy-baby-assessment/",
    name: "Mummy & Baby Assessment",
    mins: 85,
    price: 330,
    lead:
      "A combined appointment covering your own postpartum recovery and your baby's early movement and development, from 0-12 months.",
  },
];

/**
 * Conditions we assess, grouped so a searcher finds their own words fast.
 * `concern` is the searcher's words; `involves` restates the condition page's
 * own "What does a session at Goji involve?" section (reviewed copy) - edit
 * that page first, then mirror it here, never the other way round.
 */
const conditionGroups = [
  {
    heading: "Bladder, bowel and prolapse",
    items: [
      {
        href: "/conditions/urinary-incontinence/",
        name: "Urinary incontinence and leakage",
        concern: "Leaking when you cough, sneeze or exercise, or a sudden urge to go",
        involves:
          "A bladder history, a pelvic floor muscle assessment and load testing, then a programme designed for your pelvic floor.",
      },
      {
        href: "/conditions/pelvic-organ-prolapse/",
        name: "Pelvic organ prolapse",
        concern: "Heaviness, pressure or dragging in the pelvis",
        involves:
          "A pelvic floor assessment and symptom mapping, then progressive pelvic floor strengthening, movement strategies and lifestyle advice.",
      },
      {
        href: "/conditions/bowel-dysfunction/",
        name: "Bowel dysfunction and constipation",
        concern: "Constipation, straining, or difficulty controlling your bowels or wind",
        involves:
          "A bowel history and pelvic floor assessment. Treatment may include pelvic floor downtraining, toilet position advice and a graded bowel retraining programme.",
      },
    ],
  },
  {
    heading: "Pregnancy and birth",
    items: [
      {
        href: "/conditions/prenatal-care/",
        name: "Prenatal care and birth preparation",
        concern: "Aches in pregnancy, or preparing your body for birth",
        involves:
          "A musculoskeletal screen, a pelvic floor assessment when relevant, movement advice, and birth preparation such as perineal massage and breathing strategies.",
      },
      {
        href: "/conditions/pelvic-girdle-pain/",
        name: "Pelvic girdle pain and mummy's wrist",
        concern: "Pelvic, hip or back pain in pregnancy, or thumb and wrist pain from holding and feeding your baby",
        involves:
          "Clinical tests and a movement assessment, then reducing load, restoring movement and graded strengthening for your stage.",
      },
      {
        href: "/conditions/perineal-tear/",
        name: "Perineal tear, scar and birth trauma",
        concern: "A painful, tight or sensitive perineal scar after birth",
        involves:
          "Once the scar has healed, scar desensitisation and mobilisation, a massage technique to continue at home, and pelvic floor rehabilitation, paced to your readiness.",
      },
      {
        href: "/conditions/caesarean-recovery/",
        name: "Caesarean recovery and scar management",
        concern: "Recovering from a C-section, or a scar that feels tight, numb or pulls",
        involves:
          "A scar, abdominal wall and pelvic floor assessment, scar management once the scar is fully closed, and advice on what to start and what to build up to.",
      },
    ],
  },
  {
    heading: "Postnatal recovery",
    items: [
      {
        href: "/conditions/diastasis-recti/",
        name: "Diastasis recti",
        concern: "A gap, or a cone or ridge down the middle of your tummy, after pregnancy",
        involves:
          "Measuring the gap and the tension along the linea alba, load testing and a pelvic floor screen, then a progressive plan if it is affecting function.",
      },
      {
        href: "/conditions/blocked-ducts-mastitis/",
        name: "Blocked ducts and mastitis",
        concern: "A blocked duct or mastitis while breastfeeding",
        involves:
          "Therapeutic ultrasound, breast massage techniques and advice on positioning and feeding, alongside your GP or a lactation consultant.",
      },
    ],
  },
  {
    heading: "Pain and life stage",
    items: [
      {
        href: "/conditions/pelvic-pain/",
        name: "Pelvic pain and dyspareunia",
        concern: "Ongoing pelvic pain, or pain during sex",
        involves:
          "A largely conversational first session, then external assessment, an optional internal assessment and a back and hip screen. Treatment may include manual therapy, relaxation techniques and progressive load.",
      },
      {
        href: "/conditions/menopause/",
        name: "Perimenopause, menopause and bone health",
        concern: "Changes around perimenopause and menopause, or bone density",
        involves:
          "A strength, balance and (if relevant) pelvic floor assessment, then a progressive exercise programme for bone and muscle.",
      },
    ],
  },
];

/**
 * Primary sources cited in the body. Each was fetched and checked on
 * 2026-11-16; the body never says more than the source does.
 */
const sources = [
  {
    name: "Pelvic Health - Singapore General Hospital Physiotherapy",
    url: "https://www.sgh.com.sg/our-specialties/physiotherapy/pelvic-health",
    publisher: "Singapore General Hospital",
  },
  {
    name:
      "Pelvic floor muscle training versus no treatment, or inactive control treatments, for urinary incontinence in women (Dumoulin, Cacciari, Hay-Smith, 2018)",
    url: "https://doi.org/10.1002/14651858.CD005654.pub4",
    publisher: "Cochrane Database of Systematic Reviews",
  },
  {
    name: "Conservative prevention and management of pelvic organ prolapse in women (Hagen, Stark, 2011)",
    url: "https://doi.org/10.1002/14651858.CD003882.pub4",
    publisher: "Cochrane Database of Systematic Reviews",
  },
];

const faqs = [
  {
    q: "What is women's health physiotherapy?",
    a: "Women's health physiotherapy is the assessment and treatment of conditions affecting the pelvic floor, abdomen and musculoskeletal system across a woman's life - through pregnancy, after birth, and around perimenopause and menopause. It covers bladder and bowel symptoms, prolapse, pelvic and abdominal pain, diastasis recti, scar recovery and return to exercise. Pelvic floor muscle training is recommended as a first-line treatment for common conditions such as stress urinary incontinence in international clinical guidelines.",
  },
  {
    q: "Do I need a doctor's referral to see a women's health physiotherapist in Singapore?",
    a: "No referral is needed. You can book directly with us. If your assessment suggests input from a gynaecologist, urogynaecologist, colorectal specialist or another doctor would help, we will say so and can work alongside them.",
  },
  {
    q: "What happens at the first appointment?",
    a: "Your first session starts with a conversation about your history, your symptoms and what you want to get back to. Your physiotherapist then carries out a physical assessment, explains what they found, and sets out a plan with you - usually a combination of in-clinic sessions and a home programme. A pelvic floor appointment is 55 minutes; a Mummy and Baby assessment is 85 minutes.",
  },
  {
    q: "Is an internal examination always required?",
    a: "No. An internal vaginal examination is the most accurate way to assess pelvic floor muscle function, but it is always optional and only ever carried out with your informed consent, after your physiotherapist has explained what it involves. If you prefer not to have one, or it is not appropriate on the day, the assessment is adapted using external and functional measures instead.",
  },
  {
    q: "Are your physiotherapists female?",
    a: "Yes. Our physiotherapists are female and AHPC-registered, with postgraduate training and clinical experience in women's and pelvic health.",
  },
  {
    q: "How much does women's health physiotherapy cost in Singapore?",
    a: "At Goji, a 55-minute women's health physiotherapy appointment costs $260 at the clinic. A women's health physiotherapy home visit costs $380. The 85-minute Mummy and Baby assessment costs $330 at the clinic, and a Mummy and Baby home visit costs $450. Prices are per session and include the assessment, treatment and your plan.",
  },
  {
    q: "How many sessions will I need?",
    a: "It depends on your symptoms, your goals and your starting point. Your physiotherapist will recommend a plan after the first assessment. International guidelines for pelvic floor muscle training generally suggest a supervised programme of around three months before formally reassessing progress.",
  },
  {
    q: "Can I be seen at home instead of the clinic?",
    a: "Yes. We offer home-visit physiotherapy across Singapore, which many patients use in the early weeks after birth or when getting to a clinic is difficult. The clinic itself is at Lentor Modern, a one-minute walk from Lentor MRT on the Thomson-East Coast Line.",
  },
  {
    q: "I gave birth years ago. Is it too late?",
    a: "No. Pelvic floor muscles respond to training at any age and any stage: soon after birth, years after your last birth, or during perimenopause. Longstanding symptoms are still worth assessing.",
  },
];

const origin = Astro.site ?? new URL(Astro.url.origin);
const pageURL = new URL(Astro.url.pathname, origin).href;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    name: "Women's Health Physiotherapy in Singapore",
    description,
    url: pageURL,
    about: { "@type": "MedicalSpecialty", name: "Physiotherapy" },
    audience: { "@type": "PeopleAudience", suggestedGender: "female" },
    provider: clinicRef(origin),
    citation: sources.map((src) => ({
      "@type": "CreativeWork",
      name: src.name,
      url: src.url,
      publisher: { "@type": "Organization", name: src.publisher },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: origin.href },
      {
        "@type": "ListItem",
        position: 2,
        name: "Women's Health Physiotherapy Singapore",
        item: pageURL,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} schema={schema} searchType="Page">
  <section class="wh-hero">
    <div class="container">
      <h1>Women's Health Physiotherapy in Singapore</h1>
      <p class="wh-hero__lead">
        Physiotherapy for the pelvic floor, pregnancy, recovery after birth,
        pelvic pain and the changes around menopause - with female,
        AHPC-registered physiotherapists. We see patients at our clinic at
        Lentor Modern, one minute from Lentor MRT, and at home across Singapore.
      </p>
      <div class="wh-hero__cta">
        <Button slug="web-book" variant="primary" size="lg">Book an appointment</Button>
        <Button slug="web-wa" variant="whatsapp" size="lg">Ask us on WhatsApp</Button>
      </div>
      <p class="wh-hero__note">
        No doctor's referral needed. $260 for a 55-minute clinic appointment.
      </p>
    </div>
  </section>

  <Section tone="surface">
    <div class="container--narrow wh-body">
      <h2>What is women's health physiotherapy?</h2>
      <p>
        Women's health physiotherapy - also called pelvic health physiotherapy -
        assesses and treats the muscles, nerves and connective tissue that
        support the bladder, bowel and pelvic organs, along with the
        musculoskeletal changes that come with pregnancy, birth and menopause.
        It covers bladder and bowel symptoms, prolapse, pelvic pain, pain in
        pregnancy, recovery after a vaginal or Caesarean birth, diastasis recti
        and bone health around menopause.
      </p>
      <p>
        In Singapore, the
        <a href="https://www.sgh.com.sg/our-specialties/physiotherapy/pelvic-health" rel="noopener">pelvic health physiotherapy service at Singapore General Hospital</a>,
        for example, covers continence, pelvic organ prolapse, and antenatal and postnatal
        care. A
        <a href="https://doi.org/10.1002/14651858.CD005654.pub4" rel="noopener">2018 Cochrane review</a>
        found that pelvic floor muscle training can improve the symptoms of stress urinary incontinence and other types of urinary
        incontinence in women, and could be included in first-line conservative
        management. A
        <a href="https://doi.org/10.1002/14651858.CD003882.pub4" rel="noopener">2011 Cochrane review</a>
        found some evidence that it helps prolapse symptoms and severity.
      </p>
      <p>
        Symptoms such as leaking with a cough or a run, heaviness or dragging in
        the pelvis, pain with sex, a tummy gap that has not closed, or back and
        pelvic pain in pregnancy are common - but common is not the same as
        something you have to live with. Most are assessable, and physiotherapy
        can help with many of them.
      </p>

      <h2>Which appointment do I need?</h2>
      <p>
        It depends on your stage and symptoms. If you are pregnant, book
        <a href="/services/prenatal-physiotherapy/">Prenatal Physiotherapy</a>.
        If you are recovering after a vaginal or Caesarean birth, book
        <a href="/services/postpartum-physiotherapy/">Postpartum Physiotherapy</a>,
        or the <a href="/services/mummy-baby-assessment/">Mummy &amp; Baby Assessment</a>
        if you would also like your baby's movement and development checked
        (0-12 months). For leaking, urgency, bowel symptoms, prolapse, pelvic
        pain or changes around menopause, book
        <a href="/services/pelvic-floor-physiotherapy/">Pelvic Floor Physiotherapy</a>.
        Not sure? Message us on WhatsApp and we will point you to the right
        appointment.
      </p>
      <p>
        Your session is one-to-one, in a private room, for the full appointment
        time.
      </p>
    </div>
  </Section>

  <Section tone="linen">
    <div class="container">
      <div class="section-head">
        <h2>Appointments</h2>
      </div>
      <div class="wh-grid">
        {services.map((s) => (
          <a href={s.href} class="wh-card">
            <h3>{s.name}</h3>
            <p class="wh-card__meta">{s.mins} min · ${s.price}</p>
            <p class="wh-card__lead">{s.lead}</p>
            <span class="wh-card__cta">Learn more</span>
          </a>
        ))}
      </div>
      <p class="wh-note">
        Home visits are available across Singapore for each of these
        appointments. See <a href="/services/">all services</a> for paediatrics,
        musculoskeletal physiotherapy, Schroth therapy for scoliosis, clinical
        Pilates and strength and conditioning.
      </p>
    </div>
  </Section>

  <Section tone="surface">
    <div class="container">
      <div class="section-head">
        <h2>Which conditions does women's health physiotherapy help with?</h2>
      </div>
      <p class="wh-intro">
        These are the women's health concerns we assess, in the words people
        usually use for them, with what physiotherapy typically involves. Each
        condition page explains the condition, the session and when to see a
        doctor instead.
      </p>
      <table class="wh-table">
        <thead>
          <tr>
            <th scope="col">Concern</th>
            <th scope="col">What physiotherapy typically involves</th>
            <th scope="col">Condition page</th>
          </tr>
        </thead>
        {conditionGroups.map((g) => (
          <tbody>
            <tr class="wh-table__group">
              <th scope="colgroup" colspan="3">{g.heading}</th>
            </tr>
            {g.items.map((c) => (
              <tr>
                <td class="wh-table__concern">{c.concern}</td>
                <td>{c.involves}</td>
                <td><a href={c.href}>{c.name}</a></td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
      <p class="wh-note">
        Every condition page is written and reviewed by one of our
        physiotherapists. Browse <a href="/conditions/">all conditions</a>.
      </p>
    </div>
  </Section>

  <Section tone="linen">
    <div class="container--narrow wh-body">
      <h2>What happens at a first women's health physiotherapy appointment?</h2>
      <p>
        The first session starts with a conversation, not an examination. Your
        physiotherapist will ask about your history, your symptoms and what you
        want to get back to - running, lifting your child, sleeping through the
        night, sex without pain.
      </p>
      <p>
        A physical assessment follows, focused on your concerns. It may include
        your breathing, abdominal muscles and movement, your back, hips and
        pelvis, and functional tasks such as lifting or squatting. Where
        relevant, the pelvic floor is assessed by transabdominal ultrasound,
        external observation or an internal vaginal examination.
      </p>
      <p>
        Any internal pelvic floor examination will be explained beforehand and
        is entirely optional. It will only be performed with your informed
        consent, and you may decline or stop the examination at any time without
        affecting your care. Our physiotherapy team is currently all-female.
      </p>
      <p>
        You will leave with an explanation of what was found and a plan you have
        agreed to, usually combining in-clinic sessions with a home programme.
        Read more about the
        <a href="/services/pelvic-floor-physiotherapy/">pelvic floor assessment</a>
        or what to expect at a
        <a href="/blog/what-happens-at-your-first-physiotherapy-visit/">first physiotherapy visit</a>.
      </p>

      <h2>Do I need a doctor's referral for women's health physiotherapy?</h2>
      <p>
        No referral is needed. You can book directly with us. If your assessment
        suggests input from a gynaecologist, urogynaecologist, colorectal
        specialist or another doctor would help, we will say so and can work
        alongside them.
      </p>

      <h2>Who will I see?</h2>
      <p>
        Our physiotherapists are female and registered with the Allied Health
        Professions Council (AHPC), with postgraduate training and hospital
        experience in women's and pelvic health. You can read their full
        backgrounds on their profiles:
        <a href="/team/cheryl-long/">Cheryl Long</a>,
        <a href="/team/claire-ng/">Claire Ng</a> and
        <a href="/team/kristy-ng/">Kristy Ng</a>.
      </p>

      <h2>How much does women's health physiotherapy cost, and where?</h2>
      <p>
        A 55-minute women's health appointment costs $260 at the clinic, and a
        women's health home visit costs $380. The 85-minute Mummy and Baby
        assessment costs $330 at the clinic, and a Mummy and Baby home visit
        costs $450. Prices as of {SITE.pricesAsOf}. No referral is required.
      </p>
      <p>
        The clinic is at {SITE.address.line1}, {SITE.address.line2}, a
        one-minute walk from Exit 1 of Lentor MRT on the Thomson-East Coast
        Line. See <a href="/getting-here/">getting here</a>, or read more about
        <a href="/physiotherapy-lentor/">physiotherapy in Lentor</a> and the
        neighbourhoods around us.
      </p>

      <h2>Frequently asked questions</h2>
      <FaqList items={faqs} />

      <h2>Sources</h2>
      <ul class="wh-sources">
        {sources.map((src) => (
          <li><a href={src.url} rel="noopener">{src.name}</a>. {src.publisher}.</li>
        ))}
      </ul>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wh-cta">
      <div>
        <h2>Not sure which appointment you need?</h2>
        <p>
          Message us on WhatsApp and describe what you are experiencing - we
          will point you to the right appointment type before you book.
        </p>
      </div>
      <div class="wh-cta__btns">
        <Button slug="web-book" variant="primary" size="lg">Book an appointment</Button>
        <Button slug="web-wa" variant="whatsapp" size="lg">Ask us on WhatsApp</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .wh-hero {
    background: var(--bg-page);
    padding-block: clamp(2.5rem, 2rem + 3vw, 5rem);
    border-bottom: 1px solid var(--color-border);
  }
  .wh-hero__lead {
    margin-top: var(--space-4);
    max-width: 62ch;
    color: var(--text-muted);
    line-height: var(--lh-body);
  }
  .wh-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .wh-hero__note {
    margin-top: var(--space-4);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .wh-body :global(h2) {
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }
  .wh-body :global(h2:first-child) { margin-top: 0; }
  .wh-body p {
    color: var(--text-muted);
    margin-bottom: var(--space-4);
    line-height: var(--lh-body);
  }
  .wh-body a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Appointment cards. Single column on a phone — most of our reach. */
  .wh-grid {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .wh-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .wh-card {
    display: block;
    padding: var(--space-5);
    background: var(--bg-content);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
  }
  .wh-card:hover { border-color: var(--color-primary); }
  .wh-card h3 { margin-bottom: var(--space-2); }
  .wh-card__meta {
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }
  .wh-card__lead {
    color: var(--text-muted);
    line-height: var(--lh-body);
    margin-bottom: var(--space-3);
  }
  .wh-card__cta {
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
  }


  .wh-intro {
    color: var(--text-muted);
    line-height: var(--lh-body);
    max-width: 62ch;
    margin-bottom: var(--space-5);
  }

  /* Conditions table. Stacked rows on a phone (no sideways scroll), a real
     three-column table from 760px. */
  .wh-table {
    display: block;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: var(--lh-body);
  }
  .wh-table thead { display: none; }
  .wh-table tbody,
  .wh-table tr,
  .wh-table td,
  .wh-table th { display: block; }
  .wh-table th,
  .wh-table td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-1) 0;
  }
  .wh-table tbody tr {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .wh-table .wh-table__group th {
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    font-size: var(--fs-body);
    padding-top: var(--space-5);
  }
  .wh-table__concern { font-weight: var(--weight-semibold); }
  .wh-table td { color: var(--text-muted); }
  .wh-table a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (min-width: 760px) {
    .wh-table { display: table; }
    .wh-table thead { display: table-header-group; }
    .wh-table tbody { display: table-row-group; }
    .wh-table tr { display: table-row; }
    .wh-table td,
