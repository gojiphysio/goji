---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqList from "../../components/FaqList.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import { SITE } from "../../lib/site.ts";

const allServices = await getCollection("services", ({ data }) => !data.draft);
allServices.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Group by category (index order = display order).
const categories = [
  "Women's Health Physiotherapy",
  "Paediatric Physiotherapy (0-18Y)",
  "Musculoskeletal Physiotherapy",
  "Holistic Care",
] as const;

type Category = (typeof categories)[number];

/** Anchor ids for each category section (targets of the picker chips). */
const categoryId: Record<Category, string> = {
  "Women's Health Physiotherapy": "womens-health",
  "Paediatric Physiotherapy (0-18Y)": "paediatric",
  "Musculoskeletal Physiotherapy": "pain-injury",
  "Holistic Care": "pilates-strength",
};

/**
 * "Which do I need?" picker. Most visitors arrive knowing the problem, not
 * the clinical name, so each chip jumps to the category that answers it.
 */
const picker: { label: string; cat: Category }[] = [
  { label: "I'm pregnant or postpartum", cat: "Women's Health Physiotherapy" },
  { label: "My baby or child", cat: "Paediatric Physiotherapy (0-18Y)" },
  { label: "Pain or injury", cat: "Musculoskeletal Physiotherapy" },
  { label: "Pilates or strength", cat: "Holistic Care" },
];

/** Same deep link the service page's Book button uses (preselects the option). */
const bookHref = (data: any) =>
  !data.bookingService
    ? "/book/"
    : data.bookingFocus
      ? `/book/?service=${data.bookingService}&focus=${data.bookingFocus}`
      : `/book/?service=${data.bookingService}`;

const grouped = categories.reduce(
  (acc, cat) => {
    acc[cat] = allServices.filter((s) => s.data.category === cat);
    return acc;
  },
  {} as Record<Category, typeof allServices>,
);

/** "$X" using the lower of clinic/home price. */
const fromPrice = (clinic: number, home?: number) =>
  `$${Math.min(clinic, home ?? clinic)}`;

/** For paediatric physio only (not Schroth), show the lowest variant price ("From $160"). */
const displayPrice = (service: any) => {
  if (service.slug === "paediatric-physiotherapy") {
    return "From $160";  // lowest paediatric variant
  }
  const price = fromPrice(service.data.priceClinic, service.data.priceHome);
  return service.data.priceUsual ? `${price} introductory (usual $${service.data.priceUsual})` : price;
};

/** For paediatric physio only (not Schroth), show the shortest variant duration ("From 30 min"). */
const displayDuration = (service: any) => {
  if (service.slug === "paediatric-physiotherapy") {
    return "From 30 min";  // shortest paediatric variant
  }
  return `${service.data.durationMin} min`;
};

/**
 * General "before you book" questions (aeo-queries.json cluster
 * general-question). Answer first in plain terms, then Goji's specifics.
 * Goji facts here only restate copy already published elsewhere on the site
 * (homepage FAQ, women's health hub, service FAQs); prices must match the
 * services collection and llms.txt. Rendered visibly below and emitted as
 * FAQPage JSON-LD from the same array, so the two cannot drift.
 */
const faqs = [
  {
    q: "What happens at a first physiotherapy appointment?",
    a: "A first physiotherapy appointment is mostly an assessment. It starts with a conversation about your history, your current concerns and your goals, followed by a physical assessment. Your physiotherapist then walks you through what they found and you leave with a plan for what comes next. At Goji, a first physiotherapy session is 55 minutes, and the Mummy and Baby assessment is 85 minutes. Wear comfortable clothing you can move in, such as activewear, loose shorts or leggings. For pelvic floor concerns an internal examination may be offered, but it is always optional and only carried out with your informed consent.",
  },
  {
    q: "How much does physiotherapy cost in Singapore?",
    a: `Physiotherapy fees in Singapore vary with the provider, the setting (a private clinic, a polyclinic or public hospital, or a home visit) and the length of the appointment, so check the per-session price before you book. At Goji, a 55-minute physiotherapy session is $260 at the clinic or $380 as a home visit. The 85-minute Mummy and Baby assessment is $330 at the clinic or $450 as a home visit. Prices are as of ${SITE.pricesAsOf}. We do not do direct billing: most patients pay first and claim from their insurer afterwards, depending on their policy's physiotherapy coverage.`,
  },
  {
    q: "Do I need a doctor's referral to see a physiotherapist in Singapore?",
    a: "Not for private physiotherapy. In Singapore you can book a private physiotherapist directly, without a doctor's referral. Subsidised physiotherapy at a polyclinic or public hospital generally needs a referral from a doctor. No referral is needed for our women's health appointments: you can book directly with us, and if your assessment suggests input from a doctor would help, we will say so and can work alongside them. Some insurance providers require a referral letter from a doctor before they reimburse physiotherapy, so check with your insurer before your first visit if you plan to claim.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Our Services | Goji Physiotherapy Singapore"
  description="Physio near Lentor MRT: prenatal, postpartum and pelvic floor, paediatric and scoliosis care, sports injuries and clinical Pilates. In-clinic or home visits."
  schema={schema}
>
  <section class="services-hero">
    <div class="container">
      <h1>Our services</h1>
      <p class="services-hero__lead">
        Physiotherapy and rehabilitation, Pilates and strength training, for
        women, children and families. Prices as of {SITE.pricesAsOf}.
      </p>
      <div class="services-hero__cta">
        <Button slug="web-wa" variant="whatsapp" size="lg">Ask us on WhatsApp</Button>
        <Button slug="web-book" variant="secondary" size="lg">Book an appointment</Button>
      </div>
      <nav class="svc-picker" aria-labelledby="svc-picker-label">
        <p class="svc-picker__label" id="svc-picker-label">Which do I need?</p>
        <ul class="svc-picker__list">
          {picker.map((p) => (
            <li><a class="svc-picker__chip" href={`#${categoryId[p.cat]}`}>{p.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  {
    categories.filter((cat) => grouped[cat].length).map((cat, i) => {
      const items = grouped[cat];
      return (
        <Section tone={i % 2 ? "linen" : "surface"} id={categoryId[cat]} class="svc-section">
          <div class="section-head">
            <h2>{cat}</h2>
            {cat === "Women's Health Physiotherapy" && (
              <p class="svc-hub-link">
                New to this?{" "}
                <a href="/womens-health-physiotherapy-singapore/">
                  Read the overview of women's health physiotherapy in Singapore
                </a>{" "}
                - what it covers, what happens at a first appointment, and how to
                choose between these appointments.
              </p>
            )}
          </div>
          <div class="svc-grid">
            {items.map((s) => (
              <article class="svc-card">
                {s.data.heroImage && (
                  <div class="svc-card__media">
                    <img src={s.data.heroImage} alt={s.data.heroAlt ?? ""} width="480" height="300" loading="lazy" />
                  </div>
                )}
                <div class="svc-card__body">
                  <h3 class="svc-card__title">
                    <a href={`/services/${s.slug}/`} class="svc-card__link">{s.data.cardTitle ?? s.data.title}</a>
                  </h3>
                  <p class="svc-card__meta">
                    {displayDuration(s)} · {displayPrice(s)}
                  </p>
                  <p class="svc-card__lead">{s.data.cardLead}</p>
                  <div class="svc-card__actions">
                    <Button href={bookHref(s.data)} variant="primary" size="md" class="svc-card__book">Book</Button>
                    <span class="svc-card__cta" aria-hidden="true">Learn more</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </Section>
      );
    })
  }

  <Section tone="surface" id="faq">
    <!-- NEEDS CHERYL: confirm no referral is needed for every Goji appointment (MSK, paediatric, Schroth), not only women's health; if yes, the referral answer can say "any of our appointments". -->
    <!-- NEEDS CHERYL: a typical Singapore price range was left out of the cost answer (no MOH/HealthHub/AHPC source found). Add one only with a primary source. -->
    <!-- NEEDS CHERYL: when /blog/what-happens-at-your-first-physiotherapy-visit/ is approved and published, link the first-appointment answer to it. -->
    <div class="svc-faq-wrap">
      <h2>Frequently asked questions</h2>
      <FaqList items={faqs} />
    </div>
  </Section>

  <Section tone="linen" id="contact-cta">
    <div class="contact-strip">
      <h2>Not sure where to start?</h2>
      <p>Chat with our team and we'll help you find the right fit.</p>
      <Button slug="web-wa" variant="whatsapp" size="lg">Ask us on WhatsApp</Button>
    </div>
  </Section>

</BaseLayout>

<style>
  .services-hero {
    background: var(--bg-page);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    border-bottom: 1px solid var(--color-border);
  }
  .services-hero__lead {
    max-width: 56ch;
    color: var(--text-muted);
    margin-top: var(--space-4);
  }
  .services-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .svc-picker {
    margin-top: var(--space-6);
  }
  .svc-picker__label {
    font-weight: var(--weight-semibold);
    color: var(--text-default);
    margin-bottom: var(--space-3);
  }
  .svc-picker__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .svc-picker__chip {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--bg-content);
    color: var(--text-default);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .svc-picker__chip:hover,
  .svc-picker__chip:focus-visible {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Chip jumps land below the sticky header, not under it. */
  :global(.svc-section) {
    scroll-margin-top: 5rem;
  }

  .section-head {
    margin-bottom: var(--space-5);
  }
  /* Entry point to the women's health hub, so it is reachable from the main
     nav path (Services) and not only from the individual service pages. */
  .svc-hub-link {
    margin-top: var(--space-3);
    max-width: 62ch;
    color: var(--text-muted);
    line-height: var(--lh-body);
  }
  .svc-hub-link a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .svc-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .svc-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 980px) {
    .svc-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-content);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .svc-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .svc-card__media {
    background: var(--color-linen);
  }
  .svc-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    transition: transform var(--dur) var(--ease);
  }
  .svc-card:hover .svc-card__media img {
    transform: scale(1.03);
  }
  .svc-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border-top: 3px solid var(--color-primary);
    flex: 1;
  }
  .svc-card__title {
    font-size: var(--fs-h3);
    color: var(--text-default);
  }
  /* Stretched link: the whole card opens the service page, while the Book
     button sits above it as its own target (links can't nest). */
  .svc-card__link {
    color: inherit;
    text-decoration: none;
  }
  .svc-card__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .svc-card__link:focus-visible {
    outline: none;
  }
  .svc-card:has(.svc-card__link:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
  .svc-card__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
  .svc-card__actions :global(.svc-card__book) {
    position: relative;
    z-index: 1;
  }
  .svc-card__meta {
    font-size: var(--fs-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .svc-card__lead {
    font-size: var(--fs-body);
    color: var(--text-muted);
    flex: 1;
    line-height: var(--lh-snug);
  }
  .svc-card__cta {
    font-size: var(--fs-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .svc-faq-wrap {
    max-width: 68ch;
  }
  .svc-faq-wrap h2 {
    margin-bottom: var(--space-4);
  }

  .contact-strip {
    max-width: 44ch;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .contact-strip p {
    color: var(--text-muted);
  }

</style>
