---
/**
 * /blog — the education surface, newest first.
 *
 * Deliberately a single flat index: at this size, per-category index pages
 * would be thin and would compete with the posts themselves. Categories are
 * shown as badges so the shape of the archive is still readable.
 *
 * The collection is currently EMPTY - the first drafts are with Cheryl for
 * clinical review (see src/content/blog/.gitkeep). Rather than hardcode a
 * placeholder page, this template branches on `posts.length`: with no posts it
 * renders "Coming soon", noindexed and kept out of site search; drop an
 * approved .md into the collection and it becomes a real index on the next
 * build, with no code change needed.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import BerrySprig from "../../components/BerrySprig.astro";
import { formatDate, isoDate } from "../../lib/dates.ts";
import { clinicRef } from "../../lib/schema.ts";
import { existsSync } from "node:fs";

// Cards show the 800px copy of a hero photo (`<name>-800.webp`, made with
// `cwebp -q 78 -resize 800 0`) when there is one; the full file is 2-4x heavier.
const small = (src: string) => {
  const v = src.replace(/\.webp$/, "-800.webp");
  return existsSync(`public${v}`) ? v : src;
};

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const hasPosts = posts.length > 0;

// Mosaic: posts fill rows on a 6-column grid, cycling through row shapes so
// each card gets its own layout instead of one big feature over a uniform
// grid. Spans in a row always total 6, so the desktop grid never has holes.
type Variant = "spread" | "portrait" | "tile" | "classic" | "wide";
const SPAN: Record<Variant, number> = { spread: 4, portrait: 2, tile: 2, classic: 2, wide: 6 };
const ROWS: Variant[][] = [
  ["spread", "portrait"],
  ["tile", "classic", "classic"],
  ["portrait", "spread"],
  ["classic", "classic", "tile"],
];
const cards: { post: (typeof posts)[number]; variant: Variant; flip: boolean }[] = [];
for (let i = 0, r = 0; i < posts.length; r++) {
  let row = ROWS[r % ROWS.length];
  const left = posts.length - i;
  // A short last row: one post spans the width, two take a spread + portrait.
  if (left < row.length) row = left === 1 ? ["wide"] : ["spread", "portrait"];
  row.forEach((variant, j) => {
    cards.push({ post: posts[i + j], variant, flip: variant === "spread" && j > 0 });
  });
  i += row.length;
}

// Each category gets its own wash, so neighbouring cards read as different.
const TINT: Record<string, string> = {
  "Pelvic & Perinatal Health": "blush",
  "Movement & Fitness": "sage",
  "Active Ageing & Family": "ochre",
  "Clinic News": "lilac",
};
const tint = (category: string) => TINT[category] ?? "blush";

const origin = Astro.site ?? new URL(Astro.url.origin);
const pageURL = new URL("/blog/", origin).href;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: origin.href },
    { "@type": "ListItem", position: 2, name: "Blog", item: pageURL },
  ],
};

// An empty blog gets no Blog schema - there is nothing to describe yet.
const schema = hasPosts
  ? [
      {
        "@context": "https://schema.org",
        "@type": "Blog",
        name: "Goji Physiotherapy Blog",
        description:
          "Plain-language physiotherapy education for women and families from the team at Goji, Lentor MRT Singapore.",
        url: pageURL,
        inLanguage: "en-SG",
        blogPost: posts.map((post) => ({
          "@type": "BlogPosting",
          headline: post.data.title,
          description: post.data.description,
          url: new URL(`/blog/${post.slug}/`, origin).href,
          datePublished: isoDate(post.data.pubDate),
          author: post.data.author
            ? { "@type": "Person", name: post.data.author.name }
            : clinicRef(origin),
        })),
      },
      breadcrumb,
    ]
  : [breadcrumb];
---

<BaseLayout
  title="Blog | Physiotherapy Education | Goji Physiotherapy Singapore"
  description="Physiotherapy articles on pelvic health, pregnancy and postnatal recovery, and getting back to movement, from the team at Goji, Lentor MRT."
  schema={schema}
  noindex={!hasPosts}
  searchable={hasPosts}
  searchType="Article"
>
  <section class="blog-hero">
    <div class="container">
      <h1>Blog</h1>
      <p class="blog-hero__lead">
        Answers to common physiotherapy questions, and news from our
        events. Press coverage is on <a href="/press/">Goji in the media</a>.
      </p>
    </div>
  </section>

  {
    !hasPosts && (
      <Section tone="surface">
        <div class="blog-soon">
          <div class="blog-soon__text">
            <h2>The first articles are being written</h2>
            <p class="blog-soon__lead">
              Our physiotherapists are drafting them now, and every one gets a
              clinical review before it goes up. In the meantime, the condition
              and service pages cover what we treat and what each appointment
              involves.
            </p>
            <div class="blog-soon__links">
              <Button href="/conditions/" variant="primary">Conditions we treat</Button>
              <Button href="/services/" variant="secondary">Our services</Button>
            </div>
            <p class="blog-soon__note">
              Have a question you would like us to write about? Tell us and we
              will put it on the list.
            </p>
          </div>
          <div class="blog-soon__sprig" aria-hidden="true">
            <BerrySprig />
          </div>
        </div>
      </Section>
    )
  }

  {
    hasPosts && (
      <Section tone="linen">
        <div class="blog-mosaic">
          {cards.map(({ post, variant, flip }, i) => (
            <a
              href={`/blog/${post.slug}/`}
              class:list={["blog-card", `blog-card--${variant}`, `tint-${tint(post.data.category)}`, { "blog-card--flip": flip }]}
              style={`--span: ${SPAN[variant]}`}
            >
              {post.data.heroImage && (
                <div class:list={["blog-card__media", { "is-thumb": variant === "tile" }]}>
                  <img
                    src={variant === "tile" || variant === "classic" || variant === "portrait" ? small(post.data.heroImage) : post.data.heroImage}
                    srcset={(variant === "spread" || variant === "wide") && small(post.data.heroImage) !== post.data.heroImage ? `${small(post.data.heroImage)} 800w, ${post.data.heroImage} 1600w` : undefined}
                    sizes={variant === "spread" || variant === "wide" ? "(min-width: 980px) 40vw, 100vw" : undefined}
                    alt={post.data.heroAlt ?? ""}
                    width="800"
                    height="533"
                    loading={i === 0 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : undefined}
                  />
                </div>
              )}
              <div class="blog-card__body">
                {i === 0 || variant === "spread" || variant === "wide" || variant === "tile" ? (
                  <h2 class="blog-card__title">{post.data.cardTitle ?? post.data.title}</h2>
                ) : (
                  <h2 class="blog-card__title blog-card__title--sm">{post.data.cardTitle ?? post.data.title}</h2>
                )}
                <p class="blog-card__lead">{post.data.cardLead}</p>
                <p class="blog-meta">
                  <span>{post.data.category}</span>
                  <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
                </p>
              </div>
            </a>
          ))}
        </div>
      </Section>
    )
  }

  <Section tone="surface" id="contact-cta">
    <div class="contact-strip">
      <h2>Have a question we have not covered?</h2>
      <p>
        Message us on WhatsApp - describe what you are experiencing and we will
        help you find the right appointment type.
      </p>
      <Button slug="web-wa" variant="whatsapp" size="lg">Ask us on WhatsApp</Button>
    </div>
  </Section>
</BaseLayout>

<style>
  .blog-hero {
    background: var(--bg-page);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    border-bottom: 1px solid var(--color-border);
  }
  .blog-hero__lead {
    max-width: 56ch;
    color: var(--text-muted);
    margin-top: var(--space-4);
  }
  .blog-hero__lead a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Coming-soon placeholder. Removed automatically once a post exists. */
  .blog-soon {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  .blog-soon__text {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-3);
    max-width: 52ch;
  }
  /* The sprig is decoration only: it gets its own column when there is room,
     and is dropped entirely on a phone rather than sitting behind the copy. */
  .blog-soon__sprig { display: none; }
  @media (min-width: 900px) {
    .blog-soon {
      grid-template-columns: minmax(0, 1fr) 200px;
      gap: var(--space-7);
    }
    .blog-soon__sprig {
      display: block;
      opacity: 0.5;
      pointer-events: none;
    }
  }
  .blog-soon__lead { color: var(--text-muted); }
  .blog-soon__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .blog-soon__note {
    margin-top: var(--space-3);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .blog-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin-top: auto;
    padding-top: var(--space-3);
  }

  /* Mosaic. One column on a phone, two on a tablet (the wide cards span
     both, and dense flow back-fills any gap), six on desktop, where each
     card spans --span columns and every row adds up to 6. */
  .blog-mosaic {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .blog-mosaic { grid-template-columns: 1fr 1fr; grid-auto-flow: dense; }
    .blog-card--spread, .blog-card--wide { grid-column: span 2; }
  }
  @media (min-width: 980px) {
    .blog-mosaic { grid-template-columns: repeat(6, 1fr); grid-auto-flow: row; }
    .blog-card { grid-column: span var(--span); }
  }

  /* Category washes: decorative pigments mixed into paper. */
  .tint-blush { --wash: var(--blush); }
  .tint-sage { --wash: color-mix(in srgb, var(--sage) 22%, var(--color-paper)); }
  .tint-ochre { --wash: color-mix(in srgb, var(--ochre) 24%, var(--color-paper)); }
  .tint-lilac { --wash: color-mix(in srgb, var(--lilac) 28%, var(--color-paper)); }

  .blog-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-4);
    background: var(--bg-content);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .blog-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .blog-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    padding: 0 var(--space-2) var(--space-2);
  }
  .blog-card__title {
    font-size: var(--fs-h2);
    line-height: 1.12;
    color: var(--text-default);
  }
  .blog-card__title--sm { font-size: var(--fs-h3); }
  .blog-card:hover .blog-card__title { color: var(--text-accent); }
  .blog-card__lead {
    color: var(--text-muted);
    line-height: var(--lh-snug);
    max-width: 52ch;
  }

  /* Photos sit inside the card in the petal frame (never an arch). */
  .blog-card__media {
    overflow: hidden;
    background: var(--blush);
    border-radius: 72px var(--radius-md) 72px var(--radius-md);
  }
  .blog-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* Spread: photo beside the copy on a white card. */
  @media (min-width: 640px) {
    .blog-card--spread, .blog-card--wide {
      flex-direction: row;
      align-items: stretch;
      padding: var(--space-5);
      gap: var(--space-6);
    }
    .blog-card--spread .blog-card__media,
    .blog-card--wide .blog-card__media { flex: 0 0 48%; }
    .blog-card--spread .blog-card__media img,
    .blog-card--wide .blog-card__media img { aspect-ratio: auto; min-height: 300px; }
    .blog-card--spread .blog-card__body,
    .blog-card--wide .blog-card__body { justify-content: center; padding: var(--space-3) 0; }
    .blog-card--spread .blog-card__title,
    .blog-card--wide .blog-card__title { font-size: var(--fs-h1); }
    .blog-card--spread .blog-card__lead,
    .blog-card--wide .blog-card__lead { font-size: var(--fs-lead); }
    .blog-card--flip { flex-direction: row-reverse; }
    .blog-card--flip .blog-card__media { border-radius: var(--radius-md) 72px var(--radius-md) 72px; }
  }

  /* Portrait: a tall photo on the category wash. */
  .blog-card--portrait {
    background: var(--wash);
    border-color: transparent;
  }
  .blog-card--portrait .blog-card__media { border-radius: var(--radius-md) 72px var(--radius-md) 72px; }
  @media (min-width: 980px) {
    .blog-card--portrait .blog-card__media img { aspect-ratio: 1; }
  }

  /* Tile: words first on the wash, with a small petal thumbnail. */
  .blog-card--tile {
    background: var(--wash);
    border-color: transparent;
    padding: var(--space-6) var(--space-5) var(--space-5);
  }
  .blog-card--tile .blog-card__media {
    order: 2;
    width: 104px;
    border-radius: 40px var(--radius-sm) 40px var(--radius-sm);
    align-self: flex-end;
  }
  .blog-card--tile .blog-card__media img { aspect-ratio: 1; }
  .blog-card--tile .blog-card__body { padding: 0; }

  /* Classic: photo on top of a white card. */
  .blog-card--classic .blog-card__media img { aspect-ratio: 8 / 5; }

  .contact-strip {
    max-width: 44ch;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .contact-strip p { color: var(--text-muted); }
</style>
