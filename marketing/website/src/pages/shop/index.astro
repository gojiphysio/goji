---
/**
 * /shop — packages, gift vouchers and merch, as curated collections
 * (catalogue: lib/shop.ts). A `buy` option is a tracked `web-pay-*` go-link to
 * the item's Stripe Payment Link; `ask` and `soon` options route to WhatsApp.
 * Packages of existing services, physio-containing ones included, are allowed
 * under the AHPC floor in marketing/strategy/03-compliance-guardrails.md: plain
 * prices, no outcome claims, no pressure framing. Deliberately not a product
 * grid: one photo-led block per collection, options as a quiet price list.
 * The exception is merch with product shots (options with `photos`): those
 * render as product cards, at the top, with a thumbnail switcher.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import PetalPhoto from "../../components/watercolor/PetalPhoto.astro";
import Bloom from "../../components/watercolor/Bloom.astro";
import { SHOP } from "../../lib/shop.ts";

const buyable = SHOP.flatMap((c) =>
  c.options.flatMap((o) =>
    (o.variants ?? [o]).filter((v) => v.status === "buy").map((v) => ({ c, o: v === o ? o : { ...v, name: `${o.name}, ${v.label}` } })),
  ),
);
const schema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "Goji shop",
  url: "https://www.gojiphysio.com/shop/",
  itemListElement: buyable.map(({ c, o }) => ({
    "@type": "Offer",
    name: `${c.title}: ${o.name}`,
    priceCurrency: "SGD",
    ...(o.price?.startsWith("$") ? { price: o.price.replace(/[$,]/g, "") } : {}),
    url: `https://www.gojiphysio.com/shop/#${c.id}`,
  })),
};
---

<BaseLayout
  title="Shop: Pilates packages and gift vouchers | Goji Physiotherapy"
  description="Goji Girl and Goji Gang grip socks, Pilates packages and Goji gift vouchers, online by card or PayNow."
  schema={schema}
>
  <section class="shop-hero">
    <div class="container shop-hero__grid">
      <div class="shop-hero__text">
        <h1>Shop</h1>
        <p class="shop-hero__lead">
          Packages, courses, gift vouchers and a little Goji merch. Pay online by
          card or PayNow, and we'll WhatsApp you within one working day to
          arrange your first session.
        </p>
        <nav class="shop-jump" aria-label="Shop collections">
          {SHOP.map((c) => <a href={`#${c.id}`}>{c.title}</a>)}
        </nav>
      </div>
      <div class="shop-hero__sprig">
        <Bloom preset="sprig" seed={7} speed={2.25} class="shop-hero__bloom" />
      </div>
    </div>
  </section>

  {SHOP.map((c, i) => {
    const soon = c.options.every((o) => o.status === "soon");
    if (c.options.some((o) => o.photos)) return (
      <section id={c.id} class:list={["shop-coll", i % 2 ? "shop-coll--linen" : "shop-coll--surface"]}>
        <div class="container">
          <div class="shop-prods__head">
            <h2>{c.title}</h2>
            <p class="shop-coll__lead">{c.lead}</p>
          </div>
          <div class="shop-prods">
            {c.options.map((o, j) => (
              <article class="shop-prod" data-shop-gallery>
                <div class:list={["gj-frame gj-frame--petal shop-prod__frame", j % 2 === 1 && "gj-frame--flip"]}>
                  <img
                    src={o.photos![0].src}
                    alt={o.photos![0].alt}
                    width="800"
                    height="800"
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                    data-shop-main
                  />
                </div>
                <div class="shop-prod__thumbs" role="group" aria-label={`${o.name} photos`}>
                  {o.photos!.map((ph, k) => (
                    <button type="button" class="shop-prod__thumb" aria-pressed={k === 0 ? "true" : "false"} data-src={ph.src} data-alt={ph.alt}>
                      <img src={ph.src} alt="" width="64" height="64" loading="lazy" decoding="async" />
                      <span class="visually-hidden">Photo {k + 1}</span>
                    </button>
                  ))}
                </div>
                <h3 class="shop-prod__name">{o.name}</h3>
                {o.blurb && <p class="shop-prod__blurb">{o.blurb}</p>}
                {o.variants && (
                  <fieldset class="shop-prod__variants">
                    <legend class="visually-hidden">{o.name}: choose a sole</legend>
                    {o.variants.map((v, k) => (
                      <label class="shop-prod__variant">
                        <input type="radio" name={`${o.key}-variant`} value={v.key} checked={k === 0} />
                        <span>{v.label}</span>
                      </label>
                    ))}
                  </fieldset>
                )}
                {(o.variants ?? [{ ...o, label: "" }]).map((v, k) => (
                  <div class="shop-prod__buy" data-variant={o.variants ? v.key : undefined} hidden={k > 0}>
                    <div>
                      <p class="shop-opt__price">{v.price ?? "Coming soon"}</p>
                      {o.detail && <p class="shop-opt__detail">{o.detail}</p>}
                    </div>
                    {v.status === "buy" && v.slug && <Button slug={v.slug}>Buy</Button>}
                    {v.status !== "buy" && <Button slug="web-wa" variant="secondary">Ask us</Button>}
                  </div>
                ))}
              </article>
            ))}
          </div>
        </div>
      </section>
    );
    return (
      <section id={c.id} class:list={["shop-coll", i % 2 ? "shop-coll--linen" : "shop-coll--surface"]}>
        <div class:list={["container shop-coll__grid", i % 2 && "shop-coll__grid--flip"]}>
          <div class="shop-coll__media">
            {c.photo ? (
              <PetalPhoto src={c.photo.src} alt={c.photo.alt} position={c.photo.position} flip={i % 2 === 1} paint class="shop-coll__frame" />
            ) : (
              <figure class:list={["gj-frame gj-frame--petal shop-coll__frame shop-art", i % 2 === 1 && "gj-frame--flip"]}>
                <Bloom preset={c.bloom ?? "berry"} seed={i + 4} speed={2.3} class="shop-art__bloom" />
                {c.artCaption && <figcaption class="shop-art__caption">{c.artCaption}</figcaption>}
              </figure>
            )}
          </div>
          <div class="shop-coll__body">
            <h2>{c.title}</h2>
            <p class="shop-coll__lead">{c.lead}</p>
            {c.note && <p class="shop-coll__note">{c.note}</p>}
            <ul class="shop-opts">
              {c.options.map((o) => (
                <li class="shop-opt">
                  <div class="shop-opt__text">
                    <h3 class="shop-opt__name">{o.name}</h3>
                    {o.detail && <p class="shop-opt__detail">{o.detail}</p>}
                  </div>
                  <p class:list={["shop-opt__price", !o.price && "shop-opt__price--muted"]}>
                    {o.price ?? (o.status === "ask" ? "Price on request" : "Coming soon")}
                  </p>
                  <div class="shop-opt__action">
                    {o.status === "buy" && o.slug && <Button slug={o.slug}>Buy</Button>}
                    {o.status === "ask" && <Button slug="web-wa" variant="secondary">Ask us</Button>}
                  </div>
                </li>
              ))}
            </ul>
            {soon && (
              <div class="shop-coll__interest">
                <Button slug="web-wa" variant="whatsapp">Register your interest</Button>
              </div>
            )}
          </div>
        </div>
      </section>
    );
  })}

  <Section tone="linen" narrow>
    <div class="shop-help">
      <h2>Not sure which to choose?</h2>
      <p>
        Tell us what you'd like to work on and we'll suggest a package, or help
        you pick a gift.
      </p>
      <Button slug="web-wa" variant="whatsapp">Message us on WhatsApp</Button>
    </div>
  </Section>
</BaseLayout>

<script>
  // Thumbnails swap the main shot; the sole picker swaps the price and Buy link
  // (photos stay the same). Without JS the first shot and first variant show.
  document.querySelectorAll<HTMLElement>("[data-shop-gallery]").forEach((card) => {
    const main = card.querySelector<HTMLImageElement>("[data-shop-main]");
    const thumbs = card.querySelectorAll<HTMLButtonElement>(".shop-prod__thumb");
    const show = (t: HTMLButtonElement) => {
      if (!main) return;
      main.src = t.dataset.src!;
      main.alt = t.dataset.alt!;
      thumbs.forEach((x) => x.setAttribute("aria-pressed", String(x === t)));
    };
    thumbs.forEach((t) => t.addEventListener("click", () => show(t)));
    card.querySelectorAll<HTMLInputElement>(".shop-prod__variant input").forEach((r) =>
      r.addEventListener("change", () => {
        card.querySelectorAll<HTMLElement>(".shop-prod__buy[data-variant]").forEach((el) => {
          el.hidden = el.dataset.variant !== r.value;
        });
      }),
    );
  });
</script>

<style>
  /* Hero: same shape as the postpartum pathway hero. */
  .shop-hero {
    background: var(--bg-page);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }
  .shop-hero__grid { display: grid; gap: clamp(var(--space-5), 4vw, var(--space-7)); align-items: center; }
  .shop-hero__text { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .shop-hero__lead { color: var(--text-muted); line-height: var(--lh-body); max-width: 54ch; }
  .shop-hero__sprig { display: none; justify-self: center; width: min(100%, 380px); }
  .shop-jump { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .shop-jump a {
    font-size: var(--fs-small);
    font-weight: var(--weight-medium);
    color: var(--text-default);
    text-decoration: none;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--bg-content);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }
  .shop-jump a:hover { border-color: var(--color-primary); }

  /* Collections: photo-led blocks, alternating sides and surfaces. */
  .shop-coll { padding-block: var(--section-y); scroll-margin-top: 80px; }
  .shop-coll--surface { background: var(--bg-content); }
  .shop-coll--linen { background: var(--bg-page); }
  .shop-coll__grid { display: grid; gap: clamp(var(--space-5), 4vw, var(--space-8)); align-items: center; }
  .shop-coll__media { max-width: 420px; width: 100%; }
  /* Landscape on a phone so the prices aren't a screen below the photo. */
  .shop-coll :global(.shop-coll__frame) { aspect-ratio: 3 / 2; width: 100%; }
  .shop-art :global(.shop-art__bloom) { width: 48%; }
  .shop-art { margin: 0; display: grid; place-items: center; background: var(--blush); }
  .shop-art__caption {
    position: absolute;
    bottom: var(--space-5);
    left: 0;
    right: 0;
    text-align: center;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .shop-coll__body h2 { margin-bottom: var(--space-3); }
  .shop-coll__lead { color: var(--text-muted); line-height: var(--lh-body); max-width: 54ch; }
  .shop-coll__note { color: var(--text-muted); font-size: var(--fs-small); margin-top: var(--space-2); }

  /* Options: a quiet price list on the page ground, not cards. */
  .shop-opts { list-style: none; padding: 0; margin-top: var(--space-5); border-top: 1px solid var(--rule); }
  .shop-opt {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "text price" "text action";
    gap: var(--space-2) var(--space-4);
    align-items: center;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }
  .shop-opt__text { grid-area: text; }
  .shop-opt__name { font-family: var(--font-body); font-weight: var(--weight-semibold); font-size: var(--fs-body); }
  .shop-opt__detail { color: var(--text-muted); font-size: var(--fs-small); margin-top: 2px; }
  .shop-opt__price { grid-area: price; font-family: var(--font-body); font-weight: var(--weight-semibold); font-size: var(--fs-lead); text-align: right; white-space: nowrap; }
  .shop-opt__price--muted { font-size: var(--fs-small); font-weight: var(--weight-medium); color: var(--text-muted); }
  .shop-opt__action { grid-area: action; display: flex; justify-content: flex-end; }
  .shop-opt__action:empty { display: none; }
  .shop-coll__interest { margin-top: var(--space-5); }

  /* Merch: product cards; shots sit on a light clay backdrop (#CC8D81), edge to edge. */
  .shop-prods__head { max-width: 60ch; margin-bottom: var(--space-6); }
  .shop-prods__head h2 { margin-bottom: var(--space-3); }
  /* Capped so each shot tops out around 420px, like the other collections' media. */
  .shop-prods { display: grid; gap: var(--space-7) clamp(var(--space-5), 4vw, var(--space-8)); max-width: 900px; }
  .shop-prod { display: flex; flex-direction: column; min-width: 0; }
  .shop-prod__frame { aspect-ratio: 1 / 1; width: 100%; background: var(--clay); }
  .shop-prod__frame img { width: 100%; height: 100%; object-fit: cover; }
  .shop-prod__thumbs { display: flex; gap: var(--space-2); margin-top: var(--space-3); }
  .shop-prod__thumb {
    width: 64px;
    height: 64px;
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--clay);
    border: 2px solid transparent;
    cursor: pointer;
  }
  .shop-prod__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .shop-prod__thumb[aria-pressed="true"] { border-color: var(--color-primary); }
  .shop-prod__thumb:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .shop-prod__name { font-family: var(--font-body); font-weight: var(--weight-semibold); font-size: var(--fs-lead); margin-top: var(--space-4); }
  .shop-prod__blurb { color: var(--text-muted); line-height: var(--lh-body); margin-top: var(--space-2); margin-bottom: var(--space-4); }
  .shop-prod__buy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .shop-prod__buy .shop-opt__price { text-align: left; }
  .shop-prod__buy[hidden] { display: none; }
  .shop-prod__variants { display: flex; gap: var(--space-2); border: 0; padding: 0; margin: auto 0 var(--space-4); }
  .shop-prod__variant span {
    display: inline-block;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--bg-content);
    font-size: var(--fs-small);
    font-weight: var(--weight-medium);
    cursor: pointer;
  }
  .shop-prod__variant { position: relative; }
  /* Visually hidden but focusable; the global input width must not leak out. */
  .shop-prod__variant input { position: absolute; inset: 0; width: 1px; height: 1px; margin: 0; opacity: 0; pointer-events: none; }
  .shop-prod__variant input:checked + span { border-color: var(--color-primary); background: var(--blush); color: var(--color-primary); }
  .shop-prod__variant input:focus-visible + span { outline: 2px solid var(--color-primary); outline-offset: 2px; }

  .shop-help { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .shop-help p { color: var(--text-muted); line-height: var(--lh-body); }

  @media (min-width: 640px) {
    .shop-opt { grid-template-columns: 1fr auto auto; grid-template-areas: "text price action"; }
    .shop-opt__action { min-width: 92px; }
  }
  @media (min-width: 760px) {
    .shop-prods { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 860px) {
    .shop-hero__grid { grid-template-columns: 1.1fr 0.9fr; }
    .shop-hero__sprig { display: block; }
    .shop-coll__grid { grid-template-columns: 0.85fr 1.15fr; }
    .shop-coll :global(.shop-coll__frame) { aspect-ratio: 4 / 5; }
    .shop-art :global(.shop-art__bloom) { width: 78%; }
    .shop-coll__grid--flip { grid-template-columns: 1.15fr 0.85fr; }
    .shop-coll__grid--flip .shop-coll__media { order: 2; justify-self: end; }
  }
</style>
