---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Bloom from "../components/watercolor/Bloom.astro";
import PaintedWord from "../components/watercolor/PaintedWord.astro";
import PetalPhoto from "../components/watercolor/PetalPhoto.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../lib/site.ts";
import { services } from "../lib/services.ts";

// Service cards that have a matching explanatory page under /services link to it.
// Physiotherapy spans several sub-types, so it points at the index.
const serviceLearnMore: Record<string, string> = {
  physiotherapy: "/services/",
  "paediatric-physiotherapy": "/services/",
  "mummy-baby": "/services/mummy-baby-assessment/",
  "clinical-pilates": "/services/clinical-pilates/",
  "private-pilates": "/services/private-pilates/",
  "strength-conditioning": "/services/strength-conditioning/",
};

// FAQ — single source for both the on-page accordion and the FAQPage JSON-LD
// (so AI answer engines and Google rich results read the same Q&A).
const faqs = [
  {
    q: "What should I expect at my first visit?",
    a: "Your first session starts with a conversation. We'll ask about your history, your current concerns, and your goals. Then we'll do a physical assessment and walk you through what we find. You'll leave with a clear understanding of what's going on and a plan for what comes next. First sessions typically run 55 minutes.",
  },
  {
    q: "What should I wear to my appointment?",
    a: "Comfortable clothing that allows movement. Think activewear, loose shorts, or leggings. We'll provide anything else you need during your session.",
  },
  {
    q: "Can I see a physio during pregnancy?",
    a: "Absolutely. Prenatal physiotherapy is safe and recommended. We treat common pregnancy concerns like pelvic girdle pain, lower back pain, and pelvic floor changes. We also help you prepare physically for birth and postpartum recovery.",
  },
  {
    q: "Do you treat children? What ages?",
    a: "Yes. We see children from infancy through to 18. Our paediatric physiotherapy covers developmental concerns, movement milestones, sports injuries, scoliosis, and paediatric pelvic health. Sessions are designed to be comfortable for kids and informative for parents.",
  },
  {
    q: "How is Goji different from other physio clinics?",
    a: "We specialise in providing a continuum of care for women. We built Goji so you can trust one clinic for your pelvic health, your postpartum recovery, and your child's physio needs. You don't have to start over with a new provider when your family's needs change.",
  },
  {
    q: "Do you accept insurance?",
    a: "We do not do direct billing. We recommend checking with your insurer before your first visit. Most of our patients pay first and claim later with their relevant corporate and personal insurance providers. Some insurance providers require a referral letter from a doctor.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// Trust line under the hero CTAs, each led by the berry dot.
const tickerItems = [
  "1 min from Lentor MRT",
  "AHPC-registered physiotherapists",
  "Home visits available",
];

// Condition lists mirror the clinic-vetted old-site copy. Items link through to
// the real condition pages under /conditions where one exists; the few without
// a dedicated page yet are plain text. Group names must match the `category`
// enum in src/content/config.ts and the `categories` array on /conditions.
const careAreas = [
  {
    title: "Women's Health",
    guideHref: "/conditions/",
    points: [
      { text: "Prenatal care and birth preparation", href: "/conditions/prenatal-care/" },
      { text: "Antenatal and postnatal musculoskeletal concerns (pelvic girdle pain and mummy's wrist)", href: "/conditions/pelvic-girdle-pain/" },
      "Postpartum recovery and return to sport",
      { text: "Diastasis recti", href: "/conditions/diastasis-recti/" },
      { text: "Caesarean recovery and scar management", href: "/conditions/caesarean-recovery/" },
      { text: "Perineal tear, scar, and birth trauma", href: "/conditions/perineal-tear/" },
      { text: "Blocked ducts and mastitis", href: "/conditions/blocked-ducts-mastitis/" },
      "Pelvic floor dysfunction",
      { text: "Pelvic organ prolapse (POP)", href: "/conditions/pelvic-organ-prolapse/" },
      { text: "Pelvic pain and dyspareunia", href: "/conditions/pelvic-pain/" },
      { text: "Osteopenia / osteoporosis and fragility fractures management", href: "/conditions/menopause/" },
      { text: "Urinary incontinence", href: "/conditions/urinary-incontinence/" },
      { text: "Bowel dysfunction and constipation", href: "/conditions/bowel-dysfunction/" },
    ],
  },
  {
    title: "Paediatrics",
    guideHref: "/conditions/",
    points: [
      { text: "Congenital torticollis", href: "/conditions/congenital-torticollis/" },
      { text: "Postural / structural congenital talipes equinovarus (CTEV)", href: "/conditions/clubfoot-ctev/" },
      { text: "Developmental dysplasia of the hip (DDH)", href: "/conditions/hip-dysplasia-ddh/" },
      { text: "Developmental concerns and early intervention", href: "/conditions/developmental-concerns/" },
      { text: "Neurodevelopmental conditions", href: "/conditions/neurodevelopmental-conditions/" },
      { text: "Adolescent idiopathic scoliosis and Schroth therapy", href: "/conditions/adolescent-scoliosis-schroth/" },
      { text: "Paediatric pelvic health (bedwetting, soiling, and constipation)", href: "/conditions/paediatric-pelvic-health/" },
      { text: "Musculoskeletal and sports injury", href: "/conditions/paediatric-sports-injuries/" },
      { text: "Post-fracture rehabilitation", href: "/conditions/post-fracture-rehab/" },
    ],
  },
  {
    title: "Musculoskeletal & Sports",
    guideHref: "/conditions/",
    points: [
      { text: "Injuries", href: "/conditions/musculoskeletal-pain-and-injuries/" },
      { text: "Persistent or recurrent pain", href: "/conditions/persistent-pain/" },
      { text: "Adult scoliosis", href: "/conditions/adult-scoliosis/" },
      { text: "Sports rehabilitation and performance", href: "/conditions/sports-rehabilitation/" },
      { text: "Post-operation recovery and rehabilitation", href: "/conditions/post-surgery-rehabilitation/" },
      { text: "Functional movement assessment", href: "/conditions/functional-movement-assessment/" },
      { text: "Dry needling", href: "/conditions/dry-needling/" },
    ],
  },
  {
    title: "Vestibular Rehabilitation",
    guideHref: "/conditions/",
    points: [
      { text: "Vertigo", href: "/conditions/vertigo/" },
      { text: "Dizziness", href: "/conditions/dizziness/" },
      { text: "Balance difficulties", href: "/conditions/balance-problems/" },
      { text: "Benign paroxysmal positional vertigo (BPPV)", href: "/conditions/bppv/" },
      { text: "Fall prevention and age-related instability", href: "/conditions/fall-prevention/" },
    ],
  },
  {
    title: "Lymphatic Health",
    guideHref: "/conditions/",
    points: [
      { text: "Lymphoedema", href: "/conditions/lymphoedema/" },
      { text: "Swelling management", href: "/conditions/swelling-management/" },
      { text: "Lipoedema", href: "/conditions/lipoedema/" },
      { text: "Breast cancer post-op rehabilitation", href: "/conditions/breast-cancer-rehabilitation/" },
      { text: "Chronic venous insufficiency (CVI)", href: "/conditions/chronic-venous-insufficiency/" },
    ],
  },
];

const team = [
  {
    name: "Cheryl Long",
    role: "Clinical Director",
    interests:
      "Women's health, paediatric orthopaedic conditions, pelvic health (women's & paediatric), pre & postnatal care, musculoskeletal rehabilitation, scoliosis management, clinical Pilates, dry needling.",
    slug: "cheryl-long",
  },
  {
    name: "Claire Ng",
    role: "Senior Physiotherapist",
    interests:
      "Pelvic health, pre & postnatal care, women's rehabilitation, musculoskeletal, sports, lymphoedema, vestibular physiotherapy, clinical Pilates.",
    slug: "claire-ng",
  },
  {
    name: "Kristy Ng",
    role: "Senior Physiotherapist",
    interests:
      "Pelvic health, pre & postnatal care, women's rehabilitation, sports, paediatric physiotherapy including neuro cases.",
    slug: "kristy-ng",
  },
  {
    name: "Camille Tan",
    role: "Pilates Instructor",
    interests:
      "STOTT PILATES® certified mat and reformer instruction, core strength and stability, mobility and flexibility, body awareness, mindful movement, posture and alignment.",
    slug: "camille-tan",
  },
];

// COMPLIANCE NOTE: Outcome/superlative phrases trimmed per SG healthcare ad rules.
// Trimmed: "Cheryl is the best", "She is truly a gem" (superlatives); Zachary W. outcome sentence
// and referral solicitation removed. All reviews are authentic public Google Reviews.
// Order: Cheryl → Cheryl → Kristy → Claire → general → Cheryl, so all three physios appear early
const reviews = [
  {
    name: "Jennifer O.",
    text: "Cheryl has been instrumental in helping me in my pre and postnatal recovery. She has given me so much more confidence in my body post partum and helped me tremendously in preparing for birth. She is also just in general really sweet and lovely which makes our sessions very enjoyable.",
  },
  {
    name: "Sulwyn N.",
    text: "I've had a wonderful experience with Cheryl at Goji. She is incredibly supportive, knowledgeable and always takes a gentle yet thoughtful approach to treatment. What stands out most is that Goji isn't just a physio clinic — the entire team has built a welcoming and encouraging community that genuinely cares about your progress.",
  },
  {
    name: "Grace S.",
    text: "Did a postpartum physio check with Kristy! She was very knowledgeable and shared what she's checking for and how. Also gave me tips on breath work to incorporate in my usual workouts to activate my deep core. Very useful and practical for me!",
  },
  {
    name: "Alison K.",
    text: "Had a physio session with Claire after hurting my back as a postpartum mum getting back into strength training. She is really able to balance the sports side and women's health sides of physio. Would highly recommend!",
  },
  {
    name: "Nadjib S.",
    text: "Love the ambience of the newly opened clinic. Was attended by Chris and handled by Cheryl. Cheryl guided me to a personalised exercise suitable for my current injury and was very professional. I enjoyed my sessions there. Overall satisfied!",
  },
  {
    name: "Zachary W.",
    text: "Cheryl is an extremely patient and amicable physiotherapist who has helped me with my injuries through the process of dry needling. Cheryl explains the procedures cohesively so that I was able to understand the dry needling process.",
  },
];

---

<BaseLayout
  title="Women's & Family Physiotherapy in Lentor | Goji Physio"
  description="Women's & family physiotherapy at Lentor Modern, Singapore: pelvic health, pregnancy and postpartum care, paediatrics and strength. One minute from Lentor MRT."
  schema={faqSchema}
>
  {/* ---- Hero: copy left, petal photo + ripening bloom right, dawn wash behind.
       Everything here is visible on first paint; only the paint moves. ---- */}
  <section class="hero gj-washed">
    <div class="gj-wc gj-wc--multiply gj-wc-wash" data-gj-wash="dawn" data-seed="5" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="hero__tagline">Care that <PaintedWord>grows</PaintedWord> with you.</p>
        <h1 class="hero__h1">Women's and Family Physiotherapy in Lentor, Singapore</h1>
        <p class="hero__lead">
          Expert care for pelvic health, pregnancy and postpartum recovery,
          paediatrics and everyday strength.
        </p>
        <div class="hero__actions">
          <Button slug="web-wa" variant="whatsapp" size="lg">WhatsApp us</Button>
          <Button href="/book/" variant="secondary" size="lg">Book now</Button>
        </div>
        <ul class="hero__trust" aria-label="Why families choose Goji">
          {tickerItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="hero__media">
        <PetalPhoto
          src="/photos/services/prenatal-physiotherapy-warm.webp"
          alt="A Goji physiotherapist guiding a pregnant woman through an assisted side stretch on a mat"
          flip
          priority
          position="50% 30%"
          class="hero__photo"
        />
        <Bloom preset="ripen" class="hero__bloom" label="A watercolour goji flower opening and ripening into a red berry" />
      </div>
    </div>
  </section>

  {/* ---- About ---- */}
  <section class="about" id="about">
    <div class="container about__inner">
      <div class="about__text gj-reveal">
        <h2>What is Goji Physio?</h2>
        <p>
          Goji Women's and Family Physiotherapy (Goji Physio) is a physiotherapy
          clinic at Lentor Modern, Singapore, one minute from Lentor MRT. Our
          female, AHPC-registered physiotherapists care for women through
          pelvic floor concerns, pregnancy and postpartum recovery, and for
          children from infancy to 18, in the clinic or at home across Singapore.
        </p>
        <p>
          Women make careful decisions about their bodies, especially during
          pregnancy, recovery, and caring for their children. Finding the right
          physio should not mean starting over at every life stage.
        </p>
        <p>
          You are heard before you are treated, with care that combines clinical
          expertise and real understanding. The same trusted support can extend to
          your children and family too.
        </p>
      </div>
      <div class="about__media">
        <PetalPhoto
          src="/photos/space/reception-warm.webp"
          alt="Goji reception at Lentor Modern: a red oval table and cushioned wooden stools beneath the Goji Women's and Family Physiotherapy sign"
          paint
          class="about__photo"
        />
        <Bloom preset="sprig" seed={4} class="about__bloom" />
      </div>
    </div>
  </section>

  {/* ---- Services: white (tappable) cards; a snap-scroll row on phones ---- */}
  <section class="services" id="services">
    <div class="container">
      <header class="sec-head gj-reveal">
        <h2>Care for the whole family, under one roof</h2>
      </header>
      <div class="service-grid">
        {
          services.map((s, i) => (
            <article class="service-card gj-reveal" style={`--i:${i % 3}`}>
              <span class="service-card__icon" aria-hidden="true">
                <Icon name={s.icon} size={22} />
              </span>
              <h3 class="service-card__name">{s.title}</h3>
              <p class="service-card__meta">{s.meta.join(" · ")}</p>
              <p class="service-card__price">
                {s.price && <strong>${s.price}</strong>}
              </p>
              <p class="service-card__lead">{s.lead}</p>
              <div class="service-card__cta">
                <Button href="/book/" variant="secondary" class="service-card__book">Book {s.title}</Button>
                {serviceLearnMore[s.id] && (
                  <a href={serviceLearnMore[s.id]} class="service-card__learn">
                    Learn more
                    <Icon name="tabler:arrow-up-right" size={16} />
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---- Conditions we treat (accordion) ---- */}
  <section class="care" id="care">
    <div class="container care__inner">
      <header class="sec-head care__head gj-reveal">
        <h2>Conditions we treat</h2>
        <p class="sec-head__lead">
          Care tailored to the individual, their stage of life, and what matters
          to them.
        </p>
        <a href="/conditions/" class="care__all">View all conditions</a>
      </header>
      <div class="accordion">
        {
          careAreas.map((c) => (
            <details class="accordion__item">
              <summary class="accordion__trigger">
                <span class="accordion__name">{c.title}</span>
                <span class="accordion__toggle" aria-hidden="true" />
              </summary>
              <div class="accordion__body">
                <ul class="care-list">
                  {c.points.map((p) =>
                    typeof p === "string" ? (
                      <li>{p}</li>
                    ) : (
                      <li>
                        <a href={p.href} class="care-list__link">
                          {p.text}
                          <span class="visually-hidden"> — read more</span>
                        </a>
                      </li>
                    ),
                  )}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---- Stats: facts on the ground with hairlines, never card-shaped ---- */}
  <section class="stats" aria-label="Goji at a glance">
    <div class="container">
      <dl class="stats__grid">
        {[
          { value: "1 min", label: "walk from Lentor MRT", caption: "Ground floor, stroller-friendly" },
          { value: "3", label: "specialist physios", caption: "AHPC-registered clinicians" },
          { value: "20+", label: "years combined experience", caption: "Across pelvic health, sports, and paediatrics" },
          { value: "1000+", label: "patients collectively served", caption: "And growing" },
        ].map((st, i) => (
          <div class="stat gj-reveal" style={`--i:${i}`}>
            <dt class="stat__label">{st.label}</dt>
            <dd class="stat__value">{st.value}</dd>
            <dd class="stat__caption">{st.caption}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ---- Team ---- */}
  <section class="team" id="team">
    <div class="container">
      <header class="sec-head gj-reveal">
        <h2>Practitioners who get it</h2>
      </header>
      <div class="team-grid">
        {
          team.map((t, i) => (
            <a href={`/team/${t.slug}/`} class="person">
              <PetalPhoto
                src={`/photos/team/${t.slug}.webp`}
                alt={`${t.name}, ${t.role} at Goji Physiotherapy`}
                paint
                flip={i % 2 === 1}
                position="50% 28%"
                class="person__photo"
              />
              <span class="person__role">{t.role}</span>
              <h3 class="person__name">{t.name}</h3>
              <p class="person__interests">{t.interests}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---- For every stage of growth: bud, flower, ripe berry ---- */}
  <section class="growth gj-washed">
    <div class="container growth__inner">
      <div class="growth__stages" role="img" aria-label="Watercolour paintings of a goji plant at three stages: a lilac bud, an open flower, and a ripe red berry">
        <div class="gj-wc gj-wc--multiply gj-wc-bloom" data-gj-bloom="node-bud" data-seed="7" aria-hidden="true"></div>
        <div class="gj-wc gj-wc--multiply gj-wc-bloom" data-gj-bloom="node-flower" data-seed="8" data-delay="900" aria-hidden="true"></div>
        <div class="gj-wc gj-wc--multiply gj-wc-bloom" data-gj-bloom="node-berry" data-seed="9" data-delay="1900" aria-hidden="true"></div>
      </div>
      <div class="growth__text gj-reveal">
        <h2>For every stage of growth</h2>
        <p>
          Goji takes its name from a berry that ripens in its own time. Bodies are
          the same. They grow, change, and recover in stages, and care should meet
          you at each one.
        </p>
        <p>
          From pregnancy and birth to postpartum recovery, from your children's
          early milestones to the changes of menopause, the same trusted team is
          here for every stage.
        </p>
      </div>
    </div>
  </section>

  {/* ---- Google Reviews carousel ---- */}
  <section class="reviews">
    <div class="container">
      <div class="reviews__head">
        <header class="sec-head gj-reveal">
          <h2>The Goji community</h2>
        </header>
        <div class="reviews__rating">
          <a href="https://maps.app.goo.gl/wBaCkBiDNfF7JCGv8" target="_blank" rel="noopener noreferrer">See all reviews on Google</a>
        </div>
      </div>
      <div class="reviews__wrap">
        <div class="reviews__track" id="reviewsTrack">
          {reviews.map((r) => (
            <blockquote class="review">
              <div class="review__stars" aria-label="5 stars">★★★★★</div>
              <p class="review__text">{r.text}</p>
              <footer class="review__name">{r.name}</footer>
            </blockquote>
          ))}
        </div>
        <div class="reviews__nav">
          <button class="round-btn" id="reviewsPrev" aria-label="Previous review" disabled>
            <Icon name="tabler:arrow-left" size={20} />
          </button>
          <button class="round-btn" id="reviewsNext" aria-label="Next review">
            <Icon name="tabler:arrow-right" size={20} />
          </button>
        </div>
      </div>
      <p class="reviews__disclaimer">All reviews sourced from <a href="https://maps.app.goo.gl/wBaCkBiDNfF7JCGv8" target="_blank" rel="noopener noreferrer">Google Maps</a>. Individual experiences may vary.</p>
    </div>
  </section>

  {/* ---- FAQ ---- */}
  <section class="faq" id="faq">
    <div class="container faq__inner">
      <header class="sec-head gj-reveal">
        <h2>Frequently asked questions</h2>
      </header>
      <div class="faq__list">
        {faqs.map((item) => (
          <details class="faq__item">
            <summary class="faq__q">
              {item.q}
              <span class="accordion__toggle" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ---- Closing promise: the page's one burgundy surface ---- */}
  <section class="promise-sec">
    <div class="container">
      <figure class="promise gj-washed">
        <div class="gj-wc gj-wc-wash" data-gj-wash="dusk" data-seed="9" aria-hidden="true"></div>
        <img class="promise__logo" src="/brand/logo_light_transparent.webp" alt="Goji" width="343" height="168" loading="lazy" />
        <blockquote class="promise__text">{SITE.promise}</blockquote>
        <figcaption class="promise__by">The Goji promise</figcaption>
        <div class="promise__actions" data-search-ignore>
          <Button slug="web-wa" variant="light" size="lg">WhatsApp us</Button>
          <Button href="/book/" variant="secondary" size="lg" class="promise__book">Book an appointment</Button>
        </div>
      </figure>
    </div>
  </section>

</BaseLayout>

<script>
  // Reviews: arrow buttons scroll by one card and disable at either end.
  const track = document.getElementById("reviewsTrack");
  const prev = document.getElementById("reviewsPrev") as HTMLButtonElement | null;
  const next = document.getElementById("reviewsNext") as HTMLButtonElement | null;
  if (track && prev && next) {
    const step = () => {
      const card = track.firstElementChild as HTMLElement | null;
      return card ? card.offsetWidth + parseInt(getComputedStyle(track).columnGap || "0") : 0;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };
    prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }
</script>

<style>
  section { scroll-margin-top: 88px; }
  .sec-head { display: grid; gap: var(--space-4); max-width: 44rem; }
  .sec-head h2 { margin: 0; }
  .sec-head__lead { font-size: var(--fs-body); color: var(--text-muted); max-width: 34em; }

  /* ======================================================
     Hero
     ====================================================== */
  .hero {
    padding-block: clamp(2.5rem, 1rem + 5vw, 6rem) clamp(4rem, 2rem + 6vw, 8rem);
  }
  .hero__inner {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4.5rem);
    align-items: center;
  }
  .hero__text { display: grid; gap: var(--space-4); align-content: center; }
  .hero__tagline { margin-bottom: var(--space-2) !important; }
  .hero__h1 { font-family: var(--font-body); font-size: var(--fs-body); line-height: 1.45; font-weight: var(--weight-semibold); letter-spacing: 0; margin: 0; }
  .hero__lead { color: var(--text-muted); }
  .hero__tagline {
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-axes);
    /* sized so "Care that grows" holds one line beside the photo */
    font-size: clamp(2.25rem, 1.7rem + 2.2vw, 3.25rem);
    font-weight: var(--weight-display);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
    color: var(--text-default);
    text-wrap: balance;
    margin: 0;
  }
  .hero__lead { font-size: var(--fs-body); max-width: 34em; margin: 0; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
  .hero__trust { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-top: var(--space-2); }
