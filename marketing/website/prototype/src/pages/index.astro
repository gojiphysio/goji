    </div>
  </section>

  {/* ---- Team carousel ---- */}
  <Section tone="surface" id="team">
    <header class="section-head">
      <p class="eyebrow">Meet the team</p>
      <h2>Clinicians who get it</h2>
    </header>
    <div class="team-wrap">
      <div class="team-track" id="teamTrack">
        {
          team.map((t) => (
            <div class="team-slide">
              <PractitionerCard name={t.name} role={t.role} interests={t.interests} href={`/team/${t.slug}`} />
            </div>
