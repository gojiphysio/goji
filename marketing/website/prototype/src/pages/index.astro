---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import PractitionerCard from "../components/PractitionerCard.astro";
import QuoteSurface from "../components/QuoteSurface.astro";
import ContactBlock from "../components/ContactBlock.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../lib/site.ts";

const services = [
  {
    icon: "tabler:stretching",
    title: "Physiotherapy",
    lead: "Assessment and treatment for pain, injury, recovery, pelvic health, women's health, paediatric, vestibular, and lymphatic concerns.",
    meta: ["55 min initial consult", "In-clinic & home visits"],
  },
  {
    icon: "tabler:baby-carriage",
    title: "Mummy & Baby Assessment",
    lead: "A joint assessment for postpartum mothers and babies aged 0–6 months, supporting recovery, development, and early physical needs.",
    meta: ["90 min", "In-clinic & home visits"],
  },
  {
    icon: "tabler:yoga",
    title: "Clinical Pilates",
    lead: "Physiotherapist-led reformer Pilates for rehabilitation, movement retraining, strength, and a safe return to activity or sport.",
    meta: ["55 min", "1:1 or 2:1 reformer"],
  },
  {
    icon: "tabler:heart",
    title: "Private Pilates",
    lead: "Instructor-led reformer Pilates for building strength, mobility, body awareness, and confidence in movement.",
    meta: ["55 min", "1:1 or 2:1 reformer"],
  },
  {
    icon: "tabler:barbell",
    title: "Strength & Conditioning",
    lead: "Build strength and resilience through tailored exercise, with guidance from professionals to sustain your momentum.",
    meta: ["55 min", "1:1 or 2:1 sessions"],
  },
];

// Women's Health links through to the real condition pages under /conditions.
// Other areas describe the clinic's wider scope (plain text, no page yet).
const careAreas = [
  {
    title: "Women's Health",
    guideHref: "/conditions",
    points: [
      "Prenatal care and birth preparation",
      "Postpartum, diastasis recti, and Caesarean scar care",
      "Pelvic floor dysfunction, prolapse, and pelvic pain",
      "Bladder and bowel concerns",
      "Perimenopause, menopause, and bone health",
    ],
  },
  {
    title: "Paediatrics",
    points: [
      "Congenital torticollis and early intervention",
      "Developmental concerns and milestones",
      "Scoliosis and Schroth therapy",
      "Paediatric pelvic health",
      "Musculoskeletal and sports injury",
    ],
  },
  {
    title: "Musculoskeletal & Sports",
    points: [
      "Injuries and persistent or recurrent pain",
      "Sports rehabilitation and performance",
      "Post-operation recovery",
      "Functional movement assessment",
      "Dry needling",
    ],
  },
  {
    title: "Vestibular Rehabilitation",
    points: [
      "Vertigo, dizziness, and balance disorders",
      "BPPV and fall prevention",
      "Post-concussion vestibular rehabilitation",
      "Benign positional vertigo",
      "Vestibular migraine management",
    ],
  },
  {
    title: "Lymphatic Health",
    points: [
      "Lymphoedema assessment and management",
      "Oncology rehabilitation",
      "Post-surgical lymphatic drainage",
    ],
  },
];

const team = [
  {
    name: "Cheryl Long",
    role: "Clinical Director",
    interests:
      "Pelvic health, women's rehabilitation, musculoskeletal, sports, dry needling, clinical Pilates.",
    slug: "cheryl-long",
  },
  {
    name: "Claire Ng",
    role: "Senior Physiotherapist",
    interests:
      "Pelvic health, pre & postnatal care, women's rehabilitation, musculoskeletal, lymphoedema, vestibular.",
    slug: "claire-ng",
  },
  {
    name: "Kristy Ng",
    role: "Senior Physiotherapist",
    interests:
      "Pelvic health, pre & postnatal care, women's rehabilitation, sports, paediatric physiotherapy including neuro cases.",
    slug: "kristy-ng",
  },
];

// COMPLIANCE NOTE: Outcome/superlative phrases trimmed per SG healthcare ad rules.
// Trimmed: "Cheryl is the best", "She is truly a gem" (superlatives); Zachary W. outcome sentence
// and referral solicitation removed. All reviews are authentic public Google Reviews.
// Order: Cheryl → Cheryl → Kristy → Claire → general → Cheryl, so all three physios appear early
const reviews = [
  {
    name: "Jennifer O.",
    text: "Cheryl has been instrumental in helping me in my pre and postnatal recovery. She has given me so much more confidence in my body post partum and helped me tremendously in preparing for birth. She is also just in general really sweet and lovely which makes our sessions very enjoyable.",
  },
  {
    name: "Sulwyn N.",
    text: "I've had a wonderful experience with Cheryl at Goji. She is incredibly supportive, knowledgeable and always takes a gentle yet thoughtful approach to treatment. What stands out most is that Goji isn't just a physio clinic — the entire team has built a welcoming and encouraging community that genuinely cares about your progress.",
  },
  {
    name: "Grace S.",
    text: "Did a postpartum physio check with Kristy! She was very knowledgeable and shared what she's checking for and how. Also gave me tips on breath work to incorporate in my usual workouts to activate my deep core. Very useful and practical for me!",
  },
  {
    name: "Alison K.",
    text: "Had a physio session with Claire after hurting my back as a postpartum mum getting back into strength training. She is really able to balance the sports side and women's health sides of physio. Would highly recommend!",
  },
  {
    name: "Nadjib S.",
    text: "Love the ambience of the newly opened clinic. Was attended by Chris and handled by Cheryl. Cheryl guided me to a personalised exercise suitable for my current injury and was very professional. I enjoyed my sessions there. Overall satisfied!",
  },
  {
    name: "Zachary W.",
    text: "Cheryl is an extremely patient and amicable physiotherapist who has helped me with my injuries through the process of dry needling. Cheryl explains the procedures cohesively so that I was able to understand the dry needling process.",
  },
];

---

<BaseLayout
  title="Women's Physiotherapy at Lentor Modern | Goji Health"
  description="Expert women's and family physiotherapy at Lentor Modern, Singapore. Pelvic health, pregnancy and postpartum care, paediatrics, and everyday strength — one minute from Lentor MRT."
>
  {/* ---- Hero (copy left, clinic photos right) ---- */}
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="hero__tagline">{SITE.tagline}</p>
        <p class="hero__lead">
          Expert, unhurried care for pelvic health, pregnancy and postpartum
          recovery, paediatrics, and everyday strength.
        </p>
        <div class="hero__actions">
          <Button slug="web-plato" variant="primary" size="lg">Book an appointment</Button>
          <Button slug="web-wa" variant="secondary" size="lg">WhatsApp us</Button>
        </div>
      </div>
      <div class="hero__media">
        <div class="hero-shots" role="img" aria-label="Inside the Goji clinic at Lentor Modern - reception, the reformer studio, and a session in progress">
          {[
            { src: "/photos/space/reception.webp" },
            { src: "/photos/space/studio.webp" },
            { src: "/photos/space/session.webp" },
          ].map((img) => (
            <img
              src={img.src}
              class="hero-shot"
              alt=""
              aria-hidden="true"
              loading="eager"
              decoding="async"
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ---- About (text-only, no photo placeholder) ---- */}
  <section class="about-sec" id="about">
    <div class="container about-sec__inner">
      <h2>A clinic women can trust through it all</h2>
      <div class="about-sec__body">
        <p>
          Women make careful decisions about their bodies, especially during
          pregnancy, recovery, and caring for their children. Finding the right
          physio should not mean starting over at every life stage.
        </p>
        <p>
          You are heard before you are treated, with care that combines clinical
          expertise and real understanding. The same trusted support can extend to
          your children and family too.
        </p>
      </div>
    </div>
  </section>

  {/* ---- Services (accordion with Tabler icons) ---- */}
  <section class="services-sec" id="services">
    <div class="container">
      <div class="sec-two-col">
      <header class="section-head">
        <h2>Care for the whole family, under one roof</h2>
      </header>
      <div class="accordion">
        {
          services.map((s) => (
            <details class="accordion__item">
              <summary class="accordion__trigger">
                <span class="accordion__icon-wrap" aria-hidden="true">
                  <Icon name={s.icon} size={20} />
                </span>
                <span class="accordion__info">
                  <span class="accordion__name">{s.title}</span>
                  <span class="accordion__meta">{s.meta.join(" · ")}</span>
                </span>
                <span class="accordion__toggle" aria-hidden="true" />
              </summary>
              <div class="accordion__body">
                <div class="accordion__body-inner">
                  <p>{s.lead}</p>
                </div>
              </div>
            </details>
          ))
        }
      </div>
      </div>
    </div>
  </section>

  {/* ---- Areas of care (accordion, berry icon per row, linked conditions) ---- */}
  <section class="care-sec" id="care">
    <div class="container">
      <div class="sec-two-col">
      <header class="section-head">
        <h2>Conditions and concerns we commonly assess and treat</h2>
        <p class="section-head__sub">
          Care tailored to the individual, their stage of life, and what matters
          to them.
        </p>
      </header>
      <div class="accordion">
        {
          careAreas.map((c) => (
            <details class="accordion__item">
              <summary class="accordion__trigger accordion__trigger--care">
                <span class="care-berry" aria-hidden="true"></span>
                <span class="accordion__name">{c.title}</span>
                <span class="accordion__toggle" aria-hidden="true" />
              </summary>
              <div class="accordion__body">
                <div class="accordion__body-inner">
                  <ul class="care-list">
                    {c.points.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                  {c.guideHref && (
                    <a href={c.guideHref} class="care-link">
                      View all conditions
                    </a>
                  )}
                </div>
              </div>
            </details>
          ))
        }
      </div>
      </div>
    </div>
  </section>

  {/* ---- Stats: 4 items (2×2 on mobile, 4-col on desktop) ---- */}
  <section class="stats-strip">
    <div class="container stats-strip__inner">
      <div class="stat-item">
        <span class="stat-item__value">1 min</span>
        <span class="stat-item__label">walk from Lentor MRT</span>
        <span class="stat-item__caption">Ground floor, stroller-friendly</span>
      </div>
      <div class="stat-item">
        <span class="stat-item__value">3</span>
        <span class="stat-item__label">specialist physios</span>
        <span class="stat-item__caption">AHPC-registered clinicians</span>
      </div>
      <div class="stat-item">
        <span class="stat-item__value">20+</span>
        <span class="stat-item__label">years combined experience</span>
        <span class="stat-item__caption">Across pelvic health, sports, and paediatrics</span>
      </div>
      <div class="stat-item">
        <span class="stat-item__value">1000+</span>
        <span class="stat-item__label">patients served</span>
        <span class="stat-item__caption">And growing</span>
      </div>
    </div>
  </section>

  {/* ---- Team carousel ---- */}
  <Section tone="surface" id="team">
    <header class="section-head">
      <h2>Clinicians who get it</h2>
    </header>
    <div class="team-wrap">
      <div class="team-track" id="teamTrack">
        {
          team.map((t) => (
            <div class="team-slide">
              <PractitionerCard name={t.name} role={t.role} interests={t.interests} image={`/photos/team/${t.slug}.webp`} href={`/team/${t.slug}`} />
            </div>
          ))
        }
      </div>
      <button class="carousel-btn carousel-btn--prev" id="teamPrev" aria-label="Previous clinician" disabled>
        <Icon name="tabler:chevron-left" size={22} />
      </button>
      <button class="carousel-btn carousel-btn--next" id="teamNext" aria-label="Next clinician">
        <Icon name="tabler:chevron-right" size={22} />
      </button>
    </div>
    <div class="team-dots" id="teamDots" aria-hidden="true">
      {team.map((_, i) => <span class:list={["team-dot", { "team-dot--active": i === 0 }]} />)}
    </div>
  </Section>

  {/* ---- For every stage of growth (brand bloom) ---- */}
  <section class="space-sec">
    <div class="container space-sec__inner">
      <div class="space-sec__image">
        <div class="bloom-wrap" role="img" aria-label="A goji flower growing from green bud to ripe berry">
          {[1, 2, 3, 4, 5, 6, 7].map((n) => (
            <img
              src={`/illustrations/bloom-${n}.png`}
              class="bloom-frame"
              alt=""
              aria-hidden="true"
              width="300"
              height="300"
              decoding="async"
            />
          ))}
        </div>
      </div>
      <div class="space-sec__text">
        <h2>For every stage of growth</h2>
        <p>
          Goji takes its name from a berry that ripens in its own time. Bodies are
          the same. They grow, change, and recover in stages, and care should meet
          you at each one.
        </p>
        <p>
          From pregnancy and birth to postpartum recovery, from your children's
          early milestones to the changes of menopause, the same trusted team is
          here for every stage.
        </p>
      </div>
    </div>
  </section>

  {/* ---- Google Reviews carousel ---- */}
  <section class="reviews-sec">
    <div class="container">
      <div class="reviews-header">
        <h2 class="reviews-title">The Goji community</h2>
        <div class="reviews-rating">
          <span class="reviews-stars" aria-hidden="true">★★★★★</span>
          <span class="reviews-score">5.0</span>
          <a
            href="https://maps.app.goo.gl/wBaCkBiDNfF7JCGv8"
            class="reviews-source"
            target="_blank"
            rel="noopener noreferrer"
          >
            See all on Google
          </a>
        </div>
      </div>
      <div class="reviews-wrap">
        <div class="reviews-track" id="reviewsTrack">
          {reviews.map((r) => (
            <blockquote class="review-card">
              <div class="review-card__stars" aria-label="5 stars">★★★★★</div>
              <p class="review-card__text">{r.text}</p>
              <footer class="review-card__footer">
                <span class="review-card__name">{r.name}</span>
              </footer>
            </blockquote>
          ))}
        </div>
        <button class="reviews-btn reviews-btn--prev" id="reviewsPrev" aria-label="Previous review" disabled>
          <Icon name="tabler:chevron-left" size={22} />
        </button>
        <button class="reviews-btn reviews-btn--next" id="reviewsNext" aria-label="Next review">
          <Icon name="tabler:chevron-right" size={22} />
        </button>
      </div>
      <p class="reviews-disclaimer">All reviews sourced from <a href="https://maps.app.goo.gl/wBaCkBiDNfF7JCGv8" target="_blank" rel="noopener noreferrer">Google Maps</a>. Individual experiences may vary.</p>
    </div>
  </section>

  {/* ---- FAQ ---- */}
  <Section tone="surface" id="faq">
    <div class="sec-two-col">
    <header class="section-head">
      <h2>Frequently asked questions</h2>
    </header>
    <div class="faq-list">
      {[
        {
          q: "Do I need a referral to see a physiotherapist at Goji?",
          a: "No referral is needed. You can book directly online or message us on WhatsApp and we'll help you find the right session.",
        },
        {
          q: "What should I expect at my first session?",
          a: "Your first session is a full assessment — we spend time understanding your history, what's going on in your body, and what you want to achieve. Treatment may begin in the same session depending on what we find.",
        },
        {
          q: "Is physiotherapy covered by insurance?",
          a: "Many health insurance plans cover physiotherapy. We recommend checking with your insurer beforehand. We issue itemised receipts you can submit for reimbursement.",
        },
        {
          q: "Do you offer home visits?",
          a: "Yes — home visits are available for physiotherapy and Mummy & Baby Assessment sessions. Let us know when you enquire and we'll arrange the details.",
        },
        {
          q: "What is pelvic floor physiotherapy and who is it for?",
          a: "Pelvic floor physiotherapy addresses the muscles, ligaments, and connective tissue that support the bladder, bowel, and uterus. It is relevant across all life stages — not just postpartum. Common reasons to see us include leakage, pelvic pain, prolapse, or simply wanting a postnatal check.",
        },
        {
          q: "How many sessions will I need?",
          a: "This varies by condition and how your body responds. We will give you a realistic picture after your first assessment and review progress with you as we go.",
        },
      ].map((item) => (
        <details class="faq-item">
          <summary class="faq-q">
            {item.q}
            <span class="faq-toggle" aria-hidden="true" />
          </summary>
          <div class="faq-a">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
    </div>
  </Section>

  {/* ---- Closing promise ---- */}
  <Section tone="closing">
    <QuoteSurface />
  </Section>

  {/* ---- Contact ---- */}
  <Section tone="linen" id="contact">
    <ContactBlock />
  </Section>
</BaseLayout>

<script>
  const track = document.getElementById("teamTrack") as HTMLElement | null;
  const prev = document.getElementById("teamPrev") as HTMLButtonElement | null;
  const next = document.getElementById("teamNext") as HTMLButtonElement | null;
  const dots = document.querySelectorAll(".team-dot");

  if (track && prev && next) {
    function slideWidth(): number {
      const slide = track!.firstElementChild as HTMLElement | null;
      return slide ? slide.offsetWidth + parseInt(getComputedStyle(track!).gap || "0") : 0;
    }

    function currentIndex(): number {
      const sw = slideWidth();
      return sw > 0 ? Math.round(track!.scrollLeft / sw) : 0;
    }

    function updateUI() {
      const maxScroll = track!.scrollWidth - track!.clientWidth;
      prev!.disabled = track!.scrollLeft <= 1;
      next!.disabled = track!.scrollLeft >= maxScroll - 1;
      const idx = currentIndex();
      dots.forEach((d, i) => d.classList.toggle("team-dot--active", i === idx));
    }

    prev.addEventListener("click", () => {
      track.scrollBy({ left: -slideWidth(), behavior: "smooth" });
    });
    next.addEventListener("click", () => {
      track.scrollBy({ left: slideWidth(), behavior: "smooth" });
    });
    track.addEventListener("scroll", updateUI, { passive: true });
    updateUI();
  }

  // Reviews carousel
  const rTrack = document.getElementById("reviewsTrack") as HTMLElement | null;
  const rPrev = document.getElementById("reviewsPrev") as HTMLButtonElement | null;
  const rNext = document.getElementById("reviewsNext") as HTMLButtonElement | null;

  if (rTrack && rPrev && rNext) {
    function rSlideWidth(): number {
      const slide = rTrack!.firstElementChild as HTMLElement | null;
      return slide ? slide.offsetWidth + parseInt(getComputedStyle(rTrack!).gap || "0") : 0;
    }
    function rUpdateUI() {
      const maxScroll = rTrack!.scrollWidth - rTrack!.clientWidth;
      rPrev!.disabled = rTrack!.scrollLeft <= 1;
      rNext!.disabled = rTrack!.scrollLeft >= maxScroll - 1;
    }
    rPrev.addEventListener("click", () => {
      rTrack.scrollBy({ left: -rSlideWidth(), behavior: "smooth" });
    });
    rNext.addEventListener("click", () => {
      rTrack.scrollBy({ left: rSlideWidth(), behavior: "smooth" });
    });
    rTrack.addEventListener("scroll", rUpdateUI, { passive: true });
    rUpdateUI();
  }
</script>

<style>
  /* ======================================================
     Hero
     ====================================================== */
  .hero {
    background: var(--bg-page);
    display: flex;
    align-items: center;
    /* Fill the fold so only the cream hero shows above it. */
    min-height: calc(100svh - 68px);
    padding-block: var(--space-7);
  }
  .hero__inner {
    display: grid;
    gap: var(--space-7);
    width: 100%;
    align-items: center;
  }
  @media (min-width: 820px) {
    .hero__inner {
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--space-9);
    }
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    max-width: 15ch;
    margin-bottom: var(--space-5);
    text-wrap: balance;
  }
  .hero__lead {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--text-muted);
    max-width: 46ch;
    margin-bottom: var(--space-6);
    line-height: var(--lh-body);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Hero clinic-photo crossfade (3 frames, 21s loop) */
  .hero-shots {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-linen-deep) 70%, var(--bg-page));
    box-shadow: var(--shadow-md);
  }
  .hero-shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: hero-fade 21s infinite;
  }
  .hero-shot:nth-child(1) { animation-delay: 0s; }
  .hero-shot:nth-child(2) { animation-delay: 7s; }
  .hero-shot:nth-child(3) { animation-delay: 14s; }
  @keyframes hero-fade {
    0%   { opacity: 0; }
    8%   { opacity: 1; }
    33%  { opacity: 1; }
    41%  { opacity: 0; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-shot { animation: none; }
    .hero-shot:nth-child(1) { opacity: 1; }
  }

  /* ======================================================
     About — text only
     ====================================================== */
  .about-sec {
    background: var(--bg-content);
    padding-block: var(--section-y);
  }
  .about-sec__inner {
    max-width: var(--container-narrow);
  }
  .about-sec__inner h2 { margin: var(--space-2) 0 var(--space-5); }
  .about-sec__body {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .about-sec__body {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }
  .about-sec__inner p { color: var(--text-muted); }

  /* ======================================================
     Services section
     ====================================================== */
  .services-sec {
    background: var(--bg-page);
    padding-block: var(--section-y);
  }

  /* ======================================================
     Care section
     ====================================================== */
  .care-sec {
    background: var(--bg-content);
    padding-block: var(--section-y);
  }

  /* ======================================================
     Shared accordion
     ====================================================== */
  .accordion { border-top: 1px solid var(--rule); }
  .accordion__item { border-bottom: 1px solid var(--rule); }

  .accordion__trigger {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .accordion__trigger::-webkit-details-marker { display: none; }

  .accordion__icon-wrap {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }
  .accordion__icon-wrap [data-icon] { display: block; }

  .accordion__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  .accordion__name {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--fs-body);
    color: var(--text-default);
  }
  .accordion__trigger--care .accordion__name { flex: 1; }

  .accordion__meta {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  /* + / × toggle */
  .accordion__toggle {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    position: relative;
    margin-left: auto;
  }
