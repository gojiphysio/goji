    </div>
    </div>
  </Section>

  {/* ---- Closing promise ---- */}
  <Section tone="closing">
    <QuoteSurface />
  </Section>

  {/* ---- Contact ---- */}
  <Section tone="linen" id="contact">
    <ContactBlock />
  </Section>
</BaseLayout>

<script>
  const track = document.getElementById("teamTrack") as HTMLElement | null;
  const prev = document.getElementById("teamPrev") as HTMLButtonElement | null;
  const next = document.getElementById("teamNext") as HTMLButtonElement | null;
  const dots = document.querySelectorAll(".team-dot");

  if (track && prev && next) {
    function slideWidth(): number {
      const slide = track!.firstElementChild as HTMLElement | null;
      return slide ? slide.offsetWidth + parseInt(getComputedStyle(track!).gap || "0") : 0;
    }

    function currentIndex(): number {
      const sw = slideWidth();
      return sw > 0 ? Math.round(track!.scrollLeft / sw) : 0;
    }

    function updateUI() {
      const maxScroll = track!.scrollWidth - track!.clientWidth;
      prev!.disabled = track!.scrollLeft <= 1;
      next!.disabled = track!.scrollLeft >= maxScroll - 1;
      const idx = currentIndex();
      dots.forEach((d, i) => d.classList.toggle("team-dot--active", i === idx));
    }

    prev.addEventListener("click", () => {
      track.scrollBy({ left: -slideWidth(), behavior: "smooth" });
    });
    next.addEventListener("click", () => {
      track.scrollBy({ left: slideWidth(), behavior: "smooth" });
    });
    track.addEventListener("scroll", updateUI, { passive: true });
    updateUI();
  }

  // Blog carousel
  const bTrack = document.getElementById("blogTrack") as HTMLElement | null;
  const bPrev = document.getElementById("blogPrev") as HTMLButtonElement | null;
  const bNext = document.getElementById("blogNext") as HTMLButtonElement | null;
  if (bTrack && bPrev && bNext) {
    function bSlideWidth(): number {
      const slide = bTrack!.firstElementChild as HTMLElement | null;
      return slide ? slide.offsetWidth + parseInt(getComputedStyle(bTrack!).gap || "0") : 0;
    }
    function bUpdateUI() {
      const maxScroll = bTrack!.scrollWidth - bTrack!.clientWidth;
      bPrev!.disabled = bTrack!.scrollLeft <= 1;
      bNext!.disabled = bTrack!.scrollLeft >= maxScroll - 1;
    }
    bPrev.addEventListener("click", () => { bTrack.scrollBy({ left: -bSlideWidth(), behavior: "smooth" }); });
    bNext.addEventListener("click", () => { bTrack.scrollBy({ left: bSlideWidth(), behavior: "smooth" }); });
    bTrack.addEventListener("scroll", bUpdateUI, { passive: true });
    bUpdateUI();
  }

  // Reviews carousel
  const rTrack = document.getElementById("reviewsTrack") as HTMLElement | null;
  const rPrev = document.getElementById("reviewsPrev") as HTMLButtonElement | null;
  const rNext = document.getElementById("reviewsNext") as HTMLButtonElement | null;

  if (rTrack && rPrev && rNext) {
    function rSlideWidth(): number {
      const slide = rTrack!.firstElementChild as HTMLElement | null;
      return slide ? slide.offsetWidth + parseInt(getComputedStyle(rTrack!).gap || "0") : 0;
    }
    function rUpdateUI() {
      const maxScroll = rTrack!.scrollWidth - rTrack!.clientWidth;
      rPrev!.disabled = rTrack!.scrollLeft <= 1;
      rNext!.disabled = rTrack!.scrollLeft >= maxScroll - 1;
    }
    rPrev.addEventListener("click", () => {
      rTrack.scrollBy({ left: -rSlideWidth(), behavior: "smooth" });
    });
    rNext.addEventListener("click", () => {
      rTrack.scrollBy({ left: rSlideWidth(), behavior: "smooth" });
    });
    rTrack.addEventListener("scroll", rUpdateUI, { passive: true });
    rUpdateUI();
  }
</script>

<style>
  /* ======================================================
     Hero
     ====================================================== */
  .hero {
    background: var(--bg-page);
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5rem);
    text-align: center;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Flipbook: 1.75s cycle (0.25s per frame), bud → ripe berry.
     delay = (N-1)*0.25 - 1.75 so frame 1 (bud) shows first, 7 (berry) last. */
  .hero__bloom-wrap {
    position: relative;
    width: clamp(140px, 22vw, 200px);
    height: clamp(140px, 22vw, 200px);
    margin-inline: auto;
    margin-bottom: var(--space-5);
    flex-shrink: 0;
  }
  .bloom-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    animation: bloom-appear 1.75s linear infinite;
  }
  .bloom-frame:nth-child(1) { animation-delay: -1.75s; }
  .bloom-frame:nth-child(2) { animation-delay: -1.5s; }
  .bloom-frame:nth-child(3) { animation-delay: -1.25s; }
  .bloom-frame:nth-child(4) { animation-delay: -1s; }
  .bloom-frame:nth-child(5) { animation-delay: -0.75s; }
  .bloom-frame:nth-child(6) { animation-delay: -0.5s; }
