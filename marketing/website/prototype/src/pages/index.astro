---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import PractitionerCard from "../components/PractitionerCard.astro";
import QuoteSurface from "../components/QuoteSurface.astro";
import ContactBlock from "../components/ContactBlock.astro";
import BloomFlipbook from "../components/BloomFlipbook.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../lib/site.ts";
import { services } from "../lib/services.ts";

// Service cards that have a matching explanatory page under /services link to it.
// Physiotherapy spans several sub-types, so it points at the index.
const serviceLearnMore: Record<string, string> = {
  physiotherapy: "/services/",
  "paediatric-physiotherapy": "/services/",
  "mummy-baby": "/services/mummy-baby-assessment/",
  "clinical-pilates": "/services/clinical-pilates/",
  "strength-conditioning": "/services/strength-conditioning/",
};

// FAQ — single source for both the on-page accordion and the FAQPage JSON-LD
// (so AI answer engines and Google rich results read the same Q&A).
const faqs = [
  {
    q: "What should I expect at my first visit?",
    a: "Your first session starts with a conversation. We'll ask about your history, your current concerns, and your goals. Then we'll do a physical assessment and walk you through what we find. You'll leave with a clear understanding of what's going on and a plan for what comes next. First sessions typically run 55 minutes.",
  },
  {
    q: "What should I wear to my appointment?",
    a: "Comfortable clothing that allows movement. Think activewear, loose shorts, or leggings. We'll provide anything else you need during your session.",
  },
  {
    q: "Can I see a physio during pregnancy?",
    a: "Absolutely. Prenatal physiotherapy is safe and recommended. We treat common pregnancy concerns like pelvic girdle pain, lower back pain, and pelvic floor changes. We also help you prepare physically for birth and postpartum recovery.",
  },
  {
    q: "Do you treat children? What ages?",
    a: "Yes. We see children from infancy through to 18. Our paediatric physiotherapy covers developmental concerns, movement milestones, sports injuries, scoliosis, and paediatric pelvic health. Sessions are designed to be comfortable for kids and informative for parents.",
  },
  {
    q: "How is Goji different from other physio clinics?",
    a: "We specialise in providing a continuum of care for women. We built Goji so you can trust one clinic for your pelvic health, your postpartum recovery, and your child's physio needs. You don't have to start over with a new provider when your family's needs change.",
  },
  {
    q: "Do you accept insurance?",
    a: "We do not do direct billing. We recommend checking with your insurer before your first visit. Most of our patients pay first and claim later with their relevant corporate and personal insurance providers. Some insurance providers require a referral letter from a doctor.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// Trust marquee items, repeated in the loop so the track always exceeds the
// viewport width (prevents a blank gap in the scroll).
const tickerItems = [
  "1 min from Lentor MRT",
  "AHPC-registered physiotherapists",
  "5.0 on Google",
  "Home visits available",
];

// Condition lists mirror the clinic-vetted old-site copy. Women's Health items
// link through to the real condition pages under /conditions where one exists;
// everything else is plain text (no dedicated page yet).
const careAreas = [
  {
    title: "Women's Health",
    guideHref: "/conditions/",
    points: [
      { text: "Prenatal care and birth preparation", href: "/conditions/prenatal-care/" },
      { text: "Antenatal and postnatal musculoskeletal concerns (pelvic girdle pain and mummy's wrist)", href: "/conditions/pelvic-girdle-pain/" },
      "Postpartum recovery and return to sport",
      { text: "Diastasis recti", href: "/conditions/diastasis-recti/" },
      { text: "Caesarean recovery and scar management", href: "/conditions/caesarean-recovery/" },
      { text: "Perineal tear, scar, and birth trauma", href: "/conditions/perineal-tear/" },
      { text: "Blocked ducts and mastitis", href: "/conditions/blocked-ducts-mastitis/" },
      "Pelvic floor dysfunction",
      { text: "Pelvic organ prolapse (POP)", href: "/conditions/pelvic-organ-prolapse/" },
      { text: "Pelvic pain and dyspareunia", href: "/conditions/pelvic-pain/" },
      { text: "Osteopenia / osteoporosis and fragility fractures management", href: "/conditions/menopause/" },
      { text: "Urinary incontinence", href: "/conditions/urinary-incontinence/" },
      { text: "Bowel dysfunction and constipation", href: "/conditions/bowel-dysfunction/" },
    ],
  },
  {
    title: "Paediatrics",
    guideHref: "/conditions/",
    points: [
      { text: "Congenital torticollis", href: "/conditions/congenital-torticollis/" },
      { text: "Postural / structural congenital talipes equinovarus (CTEV)", href: "/conditions/clubfoot-ctev/" },
      { text: "Developmental dysplasia of the hip (DDH)", href: "/conditions/hip-dysplasia-ddh/" },
      { text: "Developmental concerns and early intervention", href: "/conditions/developmental-concerns/" },
      { text: "Neurodevelopmental conditions", href: "/conditions/neurodevelopmental-conditions/" },
      { text: "Adolescent idiopathic scoliosis and Schroth therapy", href: "/conditions/adolescent-scoliosis-schroth/" },
      { text: "Paediatric pelvic health (bedwetting, soiling, and constipation)", href: "/conditions/paediatric-pelvic-health/" },
      { text: "Musculoskeletal and sports injury", href: "/conditions/paediatric-sports-injuries/" },
      { text: "Post-fracture rehabilitation", href: "/conditions/post-fracture-rehab/" },
    ],
  },
  {
    title: "Musculoskeletal & Sports",
    points: [
      "Injuries",
      "Persistent or recurrent pain",
      "Adult scoliosis",
      "Sports rehabilitation and performance",
      "Post-operation recovery and rehabilitation",
      "Functional movement assessment",
      "Dry needling",
    ],
  },
  {
    title: "Vestibular Rehabilitation",
    points: [
      "Vertigo",
      "Dizziness",
      "Balance difficulties",
      "Benign paroxysmal positional vertigo (BPPV)",
      "Fall prevention and age-related instability",
    ],
  },
  {
    title: "Lymphatic Health",
    points: [
      "Lymphoedema",
      "Swelling management",
      "Lipedema",
      "Breast cancer post-op rehabilitation",
      "Chronic venous insufficiency (CVI)",
    ],
  },
];

const team = [
  {
    name: "Cheryl Long",
    role: "Clinical Director",
    interests:
      "Women's health, paediatric orthopaedic conditions, pelvic health (women's & paediatric), pre & postnatal care, musculoskeletal rehabilitation, scoliosis management, clinical Pilates, dry needling.",
    slug: "cheryl-long",
  },
  {
    name: "Claire Ng",
    role: "Senior Physiotherapist",
    interests:
      "Pelvic health, pre & postnatal care, women's rehabilitation, musculoskeletal, sports, lymphoedema, vestibular physiotherapy, clinical Pilates.",
    slug: "claire-ng",
  },
  {
    name: "Kristy Ng",
    role: "Senior Physiotherapist",
    interests:
      "Pelvic health, pre & postnatal care, women's rehabilitation, sports, paediatric physiotherapy including neuro cases.",
    slug: "kristy-ng",
  },
];

// COMPLIANCE NOTE: Outcome/superlative phrases trimmed per SG healthcare ad rules.
// Trimmed: "Cheryl is the best", "She is truly a gem" (superlatives); Zachary W. outcome sentence
// and referral solicitation removed. All reviews are authentic public Google Reviews.
// Order: Cheryl → Cheryl → Kristy → Claire → general → Cheryl, so all three physios appear early
const reviews = [
  {
    name: "Jennifer O.",
    text: "Cheryl has been instrumental in helping me in my pre and postnatal recovery. She has given me so much more confidence in my body post partum and helped me tremendously in preparing for birth. She is also just in general really sweet and lovely which makes our sessions very enjoyable.",
  },
  {
    name: "Sulwyn N.",
    text: "I've had a wonderful experience with Cheryl at Goji. She is incredibly supportive, knowledgeable and always takes a gentle yet thoughtful approach to treatment. What stands out most is that Goji isn't just a physio clinic — the entire team has built a welcoming and encouraging community that genuinely cares about your progress.",
  },
  {
    name: "Grace S.",
    text: "Did a postpartum physio check with Kristy! She was very knowledgeable and shared what she's checking for and how. Also gave me tips on breath work to incorporate in my usual workouts to activate my deep core. Very useful and practical for me!",
  },
  {
    name: "Alison K.",
    text: "Had a physio session with Claire after hurting my back as a postpartum mum getting back into strength training. She is really able to balance the sports side and women's health sides of physio. Would highly recommend!",
  },
  {
    name: "Nadjib S.",
    text: "Love the ambience of the newly opened clinic. Was attended by Chris and handled by Cheryl. Cheryl guided me to a personalised exercise suitable for my current injury and was very professional. I enjoyed my sessions there. Overall satisfied!",
  },
  {
    name: "Zachary W.",
    text: "Cheryl is an extremely patient and amicable physiotherapist who has helped me with my injuries through the process of dry needling. Cheryl explains the procedures cohesively so that I was able to understand the dry needling process.",
  },
];

---

<BaseLayout
  title="Women's & Family Physiotherapy in Lentor | Goji Physio"
  description="Expert women's and family physiotherapy at Lentor Modern, Singapore. Pelvic health, pregnancy and postpartum care, paediatrics, and everyday strength — one minute from Lentor MRT."
  schema={faqSchema}
>
  {/* ---- Hero (copy left, clinic photos right) ---- */}
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="hero__tagline">{SITE.tagline}</p>
        <p class="hero__sub">Women's and Family Physiotherapy in Lentor, Singapore</p>
        <p class="hero__lead">
          Expert care for pelvic health, pregnancy and postpartum recovery,
          paediatrics and everyday strength.
        </p>
        <div class="hero__actions">
          <Button slug="web-wa" variant="whatsapp" size="lg">WhatsApp us</Button>
          <Button href="/book" variant="primary" size="lg">Book now</Button>
        </div>
      </div>
      <div class="hero__media">
        <div class="hero-shots" role="img" aria-label="Inside the Goji clinic at Lentor Modern">
          {[
            { src: "/photos/space/reception-warm.webp" },
            { src: "/photos/space/studio.webp" },
            { src: "/photos/space/session.webp" },
            { src: "/photos/space/strength.webp" },
          ].map((img) => (
            <img
              src={img.src}
              class="hero-shot"
              alt=""
              aria-hidden="true"
              loading="eager"
              decoding="async"
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ---- Trust marquee (full-width, scrolls right to left) ---- */}
  <section class="ticker" aria-label="Why families choose Goji">
    <div class="ticker__track">
      {[0, 1].map((dup) => (
        <ul class="ticker__group" aria-hidden={dup === 1 ? "true" : undefined}>
          {[0, 1, 2].flatMap(() => tickerItems).map((item) => (
            <li class="ticker__item">
              <span class="ticker__dot" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  {/* ---- About (text-only, no photo placeholder) ---- */}
  <section class="about-sec" id="about">
    <div class="container about-sec__inner">
      <h2>A clinic women can trust through it all</h2>
      <div class="about-sec__body">
        <p>
          Women make careful decisions about their bodies, especially during
          pregnancy, recovery, and caring for their children. Finding the right
          physio should not mean starting over at every life stage.
        </p>
        <p>
          You are heard before you are treated, with care that combines clinical
          expertise and real understanding. The same trusted support can extend to
          your children and family too.
        </p>
      </div>
    </div>
  </section>

  {/* ---- Services (cards with pricing + Tabler icons) ---- */}
  <section class="services-sec" id="services">
    <div class="container">
      <header class="section-head">
        <h2>Care for the whole family, under one roof</h2>
      </header>
      <div class="service-wrap">
        <div class="service-track" id="serviceTrack">
          {
            services.map((s) => (
              <article class="service-card">
                <span class="service-card__icon" aria-hidden="true">
                  <Icon name={s.icon} size={22} />
                </span>
                <h3 class="service-card__name">{s.title}</h3>
                <p class="service-card__meta">{s.meta.join(" · ")}</p>
                {s.price && (
                  <p class="service-card__price">
                    <strong>${s.price}</strong>
                    {s.priceNote && <span class="service-card__price-note">{s.priceNote}</span>}
                  </p>
                )}
                <p class="service-card__lead">{s.lead}</p>
                <div class="service-card__cta">
                  <Button href="/book" variant="secondary" class="service-card__book">Book {s.title}</Button>
                  {serviceLearnMore[s.id] && (
                    <a href={serviceLearnMore[s.id]} class="service-card__learn">
                      Learn more
                      <Icon name="tabler:arrow-right" size={16} />
                    </a>
                  )}
                </div>
              </article>
            ))
          }
        </div>
        <button class="reviews-btn reviews-btn--prev" id="servicePrev" aria-label="Previous services" disabled>
          <Icon name="tabler:chevron-left" size={22} />
        </button>
        <button class="reviews-btn reviews-btn--next" id="serviceNext" aria-label="More services">
          <Icon name="tabler:chevron-right" size={22} />
        </button>
      </div>
      <div class="track-dots" id="serviceDots" aria-hidden="true">
        {services.map((_, i) => <span class:list={["track-dot", { "track-dot--active": i === 0 }]} />)}
      </div>
    </div>
  </section>

  {/* ---- Areas of care (accordion, berry icon per row, linked conditions) ---- */}
  <section class="care-sec" id="care">
    <div class="container">
      <div class="sec-two-col">
      <header class="section-head">
        <h2>Conditions we treat</h2>
        <p class="section-head__sub">
          Care tailored to the individual, their stage of life, and what matters
          to them.
        </p>
      </header>
      <div class="accordion">
        {
          careAreas.map((c) => (
            <details class="accordion__item">
              <summary class="accordion__trigger accordion__trigger--care">
                <span class="care-berry" aria-hidden="true"></span>
                <span class="accordion__name">{c.title}</span>
                <span class="accordion__toggle" aria-hidden="true" />
              </summary>
              <div class="accordion__body">
                <div class="accordion__body-inner">
                  <ul class="care-list">
                    {c.points.map((p) =>
                      typeof p === "string" ? (
                        <li>{p}</li>
                      ) : (
                        <li>
                          <a href={p.href} class="care-list__link">
                            {p.text}
                            <span class="care-list__arrow" aria-hidden="true">→</span>
                            <span class="visually-hidden"> — read more</span>
                          </a>
                        </li>
                      ),
                    )}
                  </ul>
                  {c.guideHref && (
                    <a href={c.guideHref} class="care-link">
                      View all conditions
                    </a>
                  )}
                </div>
              </div>
            </details>
          ))
        }
      </div>
      </div>
    </div>
  </section>

  {/* ---- Stats: 4 items (2×2 on mobile, 4-col on desktop) ---- */}
  <section class="stats-strip">
    <div class="container stats-strip__inner">
      <div class="stat-item">
        <span class="stat-item__value">1 min</span>
        <span class="stat-item__label">walk from Lentor MRT</span>
        <span class="stat-item__caption">Ground floor, stroller-friendly</span>
      </div>
      <div class="stat-item">
        <span class="stat-item__value">3</span>
        <span class="stat-item__label">specialist physios</span>
        <span class="stat-item__caption">AHPC-registered clinicians</span>
      </div>
      <div class="stat-item">
        <span class="stat-item__value">20+</span>
        <span class="stat-item__label">years combined experience</span>
        <span class="stat-item__caption">Across pelvic health, sports, and paediatrics</span>
      </div>
      <div class="stat-item">
        <span class="stat-item__value">1000+</span>
        <span class="stat-item__label">patients collectively served</span>
        <span class="stat-item__caption">And growing</span>
      </div>
    </div>
  </section>

  {/* ---- Team carousel ---- */}
  <Section tone="surface" id="team">
    <header class="section-head">
      <h2>Clinicians who get it</h2>
    </header>
    <div class="team-wrap">
      <div class="team-track" id="teamTrack">
        {
          team.map((t) => (
            <div class="team-slide">
              <PractitionerCard name={t.name} role={t.role} interests={t.interests} image={`/photos/team/${t.slug}.webp`} href={`/team/${t.slug}/`} />
            </div>
          ))
        }
      </div>
      <button class="carousel-btn carousel-btn--prev" id="teamPrev" aria-label="Previous clinician" disabled>
        <Icon name="tabler:chevron-left" size={22} />
      </button>
      <button class="carousel-btn carousel-btn--next" id="teamNext" aria-label="Next clinician">
        <Icon name="tabler:chevron-right" size={22} />
      </button>
    </div>
    <div class="team-dots" id="teamDots" aria-hidden="true">
      {team.map((_, i) => <span class:list={["team-dot", { "team-dot--active": i === 0 }]} />)}
    </div>
  </Section>

  {/* ---- For every stage of growth (brand bloom) ---- */}
  <section class="space-sec">
    <div class="container space-sec__inner">
      <div class="space-sec__image">
        <BloomFlipbook />
      </div>
      <div class="space-sec__text">
        <h2>For every stage of growth</h2>
        <p>
          Goji takes its name from a berry that ripens in its own time. Bodies are
          the same. They grow, change, and recover in stages, and care should meet
          you at each one.
        </p>
        <p>
          From pregnancy and birth to postpartum recovery, from your children's
          early milestones to the changes of menopause, the same trusted team is
          here for every stage.
        </p>
      </div>
    </div>
  </section>

  {/* ---- Google Reviews carousel ---- */}
  <section class="reviews-sec">
    <div class="container">
      <div class="reviews-header">
        <h2 class="reviews-title">The Goji community</h2>
        <div class="reviews-rating">
          <span class="reviews-stars" aria-hidden="true">★★★★★</span>
          <span class="reviews-score">5.0</span>
          <a
            href="https://maps.app.goo.gl/wBaCkBiDNfF7JCGv8"
            class="reviews-source"
            target="_blank"
            rel="noopener noreferrer"
          >
            See all on Google
          </a>
        </div>
      </div>
      <div class="reviews-wrap">
        <div class="reviews-track" id="reviewsTrack">
          {reviews.map((r) => (
            <blockquote class="review-card">
              <div class="review-card__stars" aria-label="5 stars">★★★★★</div>
              <p class="review-card__text">{r.text}</p>
              <footer class="review-card__footer">
                <span class="review-card__name">{r.name}</span>
              </footer>
            </blockquote>
          ))}
        </div>
        <button class="reviews-btn reviews-btn--prev" id="reviewsPrev" aria-label="Previous review" disabled>
          <Icon name="tabler:chevron-left" size={22} />
        </button>
        <button class="reviews-btn reviews-btn--next" id="reviewsNext" aria-label="Next review">
          <Icon name="tabler:chevron-right" size={22} />
        </button>
      </div>
      <div class="track-dots" id="reviewsDots" aria-hidden="true">
        {reviews.map((_, i) => <span class:list={["track-dot", { "track-dot--active": i === 0 }]} />)}
      </div>
      <p class="reviews-disclaimer">All reviews sourced from <a href="https://maps.app.goo.gl/wBaCkBiDNfF7JCGv8" target="_blank" rel="noopener noreferrer">Google Maps</a>. Individual experiences may vary.</p>
    </div>
  </section>

  {/* ---- FAQ ---- */}
  <Section tone="linen" id="faq">
    <div class="sec-two-col">
    <header class="section-head">
      <h2>Frequently asked questions</h2>
    </header>
    <div class="faq-list">
      {faqs.map((item) => (
        <details class="faq-item">
          <summary class="faq-q">
            {item.q}
            <span class="faq-toggle" aria-hidden="true" />
          </summary>
          <div class="faq-a">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
    </div>
  </Section>

  {/* ---- Closing promise ---- */}
  <Section tone="closing">
    <QuoteSurface />
  </Section>

  {/* ---- Contact ---- */}
  <Section tone="linen" id="contact">
    <ContactBlock />
  </Section>
</BaseLayout>

<script>
  // One carousel behaviour for all three horizontal scrollers: arrow buttons
  // scroll by a slide, dots (mobile) track the active slide, and both reflect
  // scroll position (arrows disable at the ends).
  function initCarousel(
    trackId: string,
    prevId: string,
    nextId: string,
    dotSelector: string | null,
    activeClass = "track-dot--active",
  ) {
    const track = document.getElementById(trackId) as HTMLElement | null;
    const prev = document.getElementById(prevId) as HTMLButtonElement | null;
    const next = document.getElementById(nextId) as HTMLButtonElement | null;
    if (!track || !prev || !next) return;
    const dots = dotSelector
      ? Array.from(document.querySelectorAll(dotSelector))
      : [];

    const slideWidth = () => {
      const slide = track.firstElementChild as HTMLElement | null;
      return slide
        ? slide.offsetWidth + parseInt(getComputedStyle(track).gap || "0")
        : 0;
    };

    const update = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= maxScroll - 1;
      if (dots.length) {
        const sw = slideWidth();
        const idx = sw > 0 ? Math.round(track.scrollLeft / sw) : 0;
        dots.forEach((d, i) => d.classList.toggle(activeClass, i === idx));
      }
    };

    prev.addEventListener("click", () =>
      track.scrollBy({ left: -slideWidth(), behavior: "smooth" }),
    );
    next.addEventListener("click", () =>
      track.scrollBy({ left: slideWidth(), behavior: "smooth" }),
    );
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }

  initCarousel("teamTrack", "teamPrev", "teamNext", ".team-dot", "team-dot--active");
  initCarousel("serviceTrack", "servicePrev", "serviceNext", "#serviceDots .track-dot");
  initCarousel("reviewsTrack", "reviewsPrev", "reviewsNext", "#reviewsDots .track-dot");
</script>

<style>
  /* ======================================================
     Hero
     ====================================================== */
  .hero {
    background: var(--bg-page);
    display: flex;
    align-items: center;
    /* Sized to its content so the trust ticker sits within the first screen. */
    padding-block: var(--space-6);
  }
  .hero__inner {
    display: grid;
    gap: var(--space-7);
    width: 100%;
    align-items: center;
  }
  @media (min-width: 820px) {
    .hero__inner {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-9);
    }
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.7rem + 2.2vw, 3.25rem);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    max-width: 15ch;
    margin-bottom: var(--space-4);
    text-wrap: balance;
  }
  .hero__lead {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--text-muted);
    max-width: 46ch;
    margin-bottom: var(--space-6);
    line-height: var(--lh-body);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero__sub {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--weight-medium);
    color: var(--color-primary);
    margin-top: 0;
    margin-bottom: var(--space-4);
    max-width: 30ch;
  }
  /* ======================================================
     Trust marquee — full-width, scrolls right to left
     ====================================================== */
  .ticker {
    background: var(--color-linen-deep);
    border-block: 1px solid var(--rule);
    overflow: hidden;
  }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 34s linear infinite;
  }
  .ticker__group {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: var(--space-3) 0 var(--space-3) var(--space-6);
  }
  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: var(--weight-medium);
    color: var(--text-default);
  }
  .ticker__dot {
    width: 6px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-primary);
    transform: rotate(45deg);
    flex: none;
  }
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track { animation: none; flex-wrap: wrap; }
    .ticker__group:nth-child(2) { display: none; }
  }

  /* Hero clinic-photo crossfade (4 frames, 28s loop) */
  .hero-shots {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-linen-deep) 70%, var(--bg-page));
    box-shadow: var(--shadow-md);
  }
  .hero-shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: hero-fade 28s infinite;
  }
  .hero-shot:nth-child(1) { animation-delay: 0s; }
  .hero-shot:nth-child(2) { animation-delay: 7s; }
  .hero-shot:nth-child(3) { animation-delay: 14s; }
  .hero-shot:nth-child(4) { animation-delay: 21s; }
  @keyframes hero-fade {
    0%    { opacity: 0; }
    2.5%  { opacity: 1; }
    22.5% { opacity: 1; }
    27.5% { opacity: 0; }
    100%  { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-shot { animation: none; }
    .hero-shot:nth-child(1) { opacity: 1; }
  }

  /* ======================================================
     About — text only
     ====================================================== */
  .about-sec {
    background: var(--bg-content);
    padding-block: var(--section-y);
  }
  .about-sec__inner {
    max-width: var(--container-narrow);
  }
  .about-sec__inner h2 { margin: var(--space-2) 0 var(--space-5); }
  .about-sec__body {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .about-sec__body {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
    /* Side by side: cancel the stacked p + p top margin so both
       columns start at the same height. */
    .about-sec__body p + p { margin-top: 0; }
  }
  .about-sec__inner p { color: var(--text-muted); }

  /* ======================================================
     Services section
     ====================================================== */
  .services-sec {
    background: var(--bg-page);
    padding-block: var(--section-y);
  }

  /* Service cards carousel (3-up on desktop, swipe on mobile) */
  .service-wrap { position: relative; }
  .service-track {
    display: flex;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: var(--space-2);
  }
  .service-track::-webkit-scrollbar { display: none; }
  .service-card {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--bg-content);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }
  @media (min-width: 640px) {
    .service-card { flex: 0 0 calc(50% - var(--space-4)); }
  }
  @media (min-width: 960px) {
    .service-card { flex: 0 0 calc(33.333% - var(--space-4)); }
  }
  .service-card__icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-1);
  }
  .service-card__icon [data-icon] { display: block; }
  .service-card__name {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
  }
  .service-card__meta {
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }
  .service-card__lead {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: var(--lh-body);
  }
  .service-card__price {
    font-size: var(--fs-small);
    color: var(--text-default);
  }
  .service-card__price strong {
    font-family: var(--font-display);
    font-size: var(--fs-h3, 1.0625rem);
    font-weight: var(--weight-bold);
    color: var(--text-default);
  }
  .service-card__price-note {
    display: block;
    font-size: var(--fs-caption);
    color: var(--text-muted);
    margin-top: 2px;
  }
  .service-card__cta {
    margin-top: auto;
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }
  .service-card__cta :global(.service-card__book) {
    width: 100%;
    justify-content: center;
  }
  .service-card__learn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }
  .service-card__learn [data-icon] {
    transition: transform var(--dur) var(--ease);
  }
  .service-card__learn:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .service-card__learn:hover [data-icon] {
    transform: translateX(3px);
  }


  /* ======================================================
     Care section
     ====================================================== */
  .care-sec {
    background: var(--bg-content);
    padding-block: var(--section-y);
  }

  /* ======================================================
     Shared accordion
     ====================================================== */
  .accordion { border-top: 1px solid var(--rule); }
  .accordion__item { border-bottom: 1px solid var(--rule); }

  .accordion__trigger {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .accordion__trigger::-webkit-details-marker { display: none; }

  .accordion__icon-wrap {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }
  .accordion__icon-wrap [data-icon] { display: block; }

  .accordion__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  .accordion__name {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--fs-body);
    color: var(--text-default);
  }
  .accordion__trigger--care .accordion__name { flex: 1; }

  .accordion__meta {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  /* + / × toggle */
  .accordion__toggle {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    position: relative;
    margin-left: auto;
  }
  .accordion__toggle::before,
  .accordion__toggle::after {
    content: "";
    position: absolute;
    background: var(--color-primary);
    border-radius: 2px;
    transition: transform var(--dur) var(--ease);
  }
  .accordion__toggle::before {
    width: 14px; height: 1.5px;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
  }
  .accordion__toggle::after {
    width: 1.5px; height: 14px;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
  }
  details[open] .accordion__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .accordion__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s var(--ease);
    overflow: hidden;
  }
  details[open] .accordion__body { grid-template-rows: 1fr; }
  .accordion__body-inner {
    overflow: hidden;
    padding-bottom: var(--space-5);
  }
  .accordion__body-inner p {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: var(--lh-body);
    max-width: 64ch;
  }

  /* ---- Care area rows ---- */
  /* Stylized berry oval, tilted 45deg right (matches the marquee marker) */
  .care-berry {
    display: inline-block;
    width: 14px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-primary);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  /* Conditions list — indented, no extra bullet icon */
  .care-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3) var(--space-5);
  }
  .care-list li {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    color: var(--text-muted);
    padding-block: var(--space-1);
    line-height: var(--lh-body);
  }
  /* Dash as a fixed marker (flex item) so every row's text starts at the
     same column — and wrapped lines hang-indent under the text, not the dash.
     Flex also drops the stray whitespace node Astro emits before linked items,
     which otherwise nudged linked rows a few px right of plain-text rows. */
  .care-list li::before {
    content: "–";
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
    flex-shrink: 0;
  }
  .care-list a {
    color: inherit;
    text-decoration: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color var(--dur);
  }
  /* Linked condition items: text + a small "read more" arrow that trails
     the last word inline (so it stays put when the text wraps). */
  .care-list__link:hover { color: var(--color-primary); }
  .care-list__arrow {
    color: var(--color-primary);
    font-size: 0.85em;
    margin-left: 0.3em;
    display: inline-block;
    transition: transform var(--dur) var(--ease);
  }
  .care-list__link:hover .care-list__arrow { transform: translateX(3px); }

  .care-link {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: var(--weight-medium);
    color: var(--color-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    margin-left: var(--space-5);
  }
  .care-link::after { content: " \2192"; }

  /* ======================================================
     Stats strip — 4 items, 2×2 on mobile, 4-col on desktop
     ====================================================== */
  .stats-strip {
    background: var(--bg-page);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding-block: var(--space-7);
  }
  .stats-strip__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6) var(--space-4);
    text-align: center;
  }
  @media (min-width: 640px) {
    .stats-strip__inner {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }
  .stat-item__value {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
    color: var(--color-primary);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
  }
  .stat-item__label {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--fs-small);
    color: var(--text-default);
  }
  .stat-item__caption {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  /* ======================================================
     Team carousel
     ====================================================== */
  .team-wrap {
    position: relative;
  }
  .team-track {
    display: flex;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: var(--space-1);
  }
  .team-track::-webkit-scrollbar { display: none; }
  .team-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
  }

  /* Translucent circular arrows, overlaid on the slides (mobile only) */
  .carousel-btn {
    position: absolute;
    top: 38%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: color-mix(in srgb, var(--color-ink) 55%, transparent);
    backdrop-filter: blur(3px);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: background var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  .carousel-btn--prev { left: var(--space-3); }
  .carousel-btn--next { right: var(--space-3); }
  .carousel-btn:hover:not(:disabled) {
    background: color-mix(in srgb, var(--color-primary) 80%, transparent);
  }
  .carousel-btn:disabled { opacity: 0; pointer-events: none; }

  .team-dots {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    margin-top: var(--space-5);
  }
  .team-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-border-strong);
    transition: background var(--dur);
  }
  .team-dot--active { background: var(--color-primary); }

  /* Desktop: static 3-column grid, no carousel chrome */
  @media (min-width: 720px) {
    .team-track {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
      scroll-snap-type: none;
    }
    .team-slide { flex: none; }
    .carousel-btn,
    .team-dots { display: none; }
  }

  /* ======================================================
     Clinic space
     ====================================================== */
  .space-sec {
    background: var(--bg-page);
    padding-block: var(--section-y);
  }
  .space-sec__inner {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 720px) {
    .space-sec__inner {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-8);
    }
  }
  .space-sec__text h2 { margin: 0 0 var(--space-4); }
  .space-sec__text p { color: var(--text-muted); }
  .space-sec__text p + p { margin-top: var(--space-4); }

  /* ======================================================
     FAQ
     ====================================================== */
  .faq-list {
    margin-top: var(--space-7);
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }
  .faq-item {
    border-bottom: 1px solid var(--rule);
  }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-toggle {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    position: relative;
  }
  .faq-toggle::before,
  .faq-toggle::after {
    content: "";
    position: absolute;
    background: var(--color-primary);
    border-radius: 2px;
    transition: transform 0.25s var(--ease);
  }
  .faq-toggle::before { width: 14px; height: 1.5px; top: 50%; left: 50%; transform: translate(-50%, -50%); }
  .faq-toggle::after  { width: 1.5px; height: 14px; top: 50%; left: 50%; transform: translate(-50%, -50%); }
  details[open] .faq-toggle::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq-a {
    overflow: hidden;
    padding-bottom: var(--space-5);
  }
  .faq-a p {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: var(--lh-body);
    max-width: 68ch;
  }

  /* ======================================================
     Shared helpers
     ====================================================== */
  .img-ph {
    width: 100%;
    background: color-mix(in srgb, var(--color-linen-deep) 70%, var(--bg-page));
    border: 1.5px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .img-ph span {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    text-align: center;
    padding: var(--space-5);
  }

  .section-head { max-width: 56ch; margin-bottom: var(--space-7); }
  .section-head h2 { margin-top: var(--space-2); }
  .section-head__sub { margin-top: var(--space-3); color: var(--text-muted); }

  /* Two-column section layout (header left, accordion right) */
  .sec-two-col {
    display: grid;
    gap: var(--space-6) var(--space-8);
    grid-template-columns: 1fr;
  }
  /* Grid gap handles all spacing — remove header bottom margin */
  .sec-two-col .section-head { margin-bottom: 0; }
  .sec-two-col .faq-list { margin-top: 0; }
  @media (min-width: 720px) {
    .sec-two-col {
      grid-template-columns: 1fr 1.6fr;
      align-items: start;
      gap: 0 var(--space-10);
    }
    .sec-two-col .section-head {
      position: sticky;
      top: calc(68px + var(--space-6));
    }
  }

  .grid { display: grid; gap: var(--space-5); }
  .grid--3 { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  @media (min-width: 900px) {
    .grid--3 { grid-template-columns: repeat(3, 1fr); }
  }

  /* ======================================================
     Google Reviews carousel
     ====================================================== */
  .reviews-sec {
    background: var(--bg-content);
    padding-block: var(--section-y);
    border-top: 1px solid var(--rule);
  }
  .reviews-header {
    margin-bottom: var(--space-6);
  }
  .reviews-title {
    margin: var(--space-2) 0 var(--space-5);
  }
  .reviews-header .reviews-rating {
    /* sits below the title on all sizes */
  }
  .reviews-rating {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .reviews-stars {
    color: #f5a623;
    font-size: 1.2rem;
    letter-spacing: 0.05em;
  }
  .reviews-score {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: var(--weight-bold);
    color: var(--text-default);
    line-height: 1;
  }
  .reviews-source {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* --- Carousel track --- */
  .reviews-wrap {
    position: relative;
  }
  .reviews-track {
    display: flex;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: var(--space-2);
  }
  .reviews-track::-webkit-scrollbar { display: none; }

  .review-card {
    flex: 0 0 calc(100% - var(--space-5));
    scroll-snap-align: start;
    background: var(--bg-page);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border: 1px solid var(--color-border);
  }
  @media (min-width: 640px) {
    .review-card { flex: 0 0 calc(50% - var(--space-4)); }
  }
  @media (min-width: 960px) {
    .review-card { flex: 0 0 calc(33.333% - var(--space-4)); }
  }

  .review-card__stars {
    color: #f5a623;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
  }
  .review-card__text {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: var(--lh-body);
    flex: 1;
  }
  .review-card__footer {
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    margin-top: auto;
  }
  .review-card__name {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
  }

  /* --- Arrow buttons (shared by services + reviews) ---
     Mobile: translucent, overlaid on the track edges (matches the team
     carousel). Desktop (>=640px): solid, parked just outside the track. */
  .reviews-btn {
    display: flex;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: color-mix(in srgb, var(--color-ink) 55%, transparent);
    backdrop-filter: blur(3px);
    color: #fff;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  .reviews-btn--prev { left: var(--space-3); }
  .reviews-btn--next { right: var(--space-3); }
  .reviews-btn:hover:not(:disabled) {
