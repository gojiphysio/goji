---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import { SITE } from "../../lib/site.ts";

export async function getStaticPaths() {
  const services = await getCollection("services", ({ data }) => !data.draft);
  return services.map((s) => ({ params: { slug: s.slug }, props: { entry: s } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const {
  title,
  description,
  cardTitle,
  category,
  durationMin,
  priceClinic,
  priceHome,
  clinicians,
  bookingService,
  bookingFocus,
  faqs,
} = entry.data;

// Book CTA deep-links into the booking form: preselects the existing option and,
// for physiotherapy, the compulsory sub-type (so the right clinicians' calendars
// open). See src/lib/physioCategories.ts and BookingForm.astro.
const bookHref = bookingFocus
  ? `/book?service=${bookingService}&focus=${bookingFocus}`
  : `/book?service=${bookingService}`;

const priceLabel =
  priceHome && priceHome !== priceClinic
    ? `In-clinic $${priceClinic} · Home visit $${priceHome}`
    : `$${priceClinic}`;
const clinicianLabel = new Intl.ListFormat("en", { style: "long", type: "conjunction" }).format(clinicians);

const origin = Astro.site ?? new URL(Astro.url.origin);
const pageURL = new URL(Astro.url.pathname, origin).href;

// GEO/SEO structured data. `Service` + an `Offer` (price in SGD) makes the
// appointment and its price quotable by answer engines and eligible for rich
// results; BreadcrumbList gives crawlers the Home › Services › <page> trail;
// FAQPage is emitted only when the page defines FAQs.
const serviceSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: cardTitle ?? title,
  name: title,
  description,
  url: pageURL,
  category,
  provider: {
    "@type": ["MedicalClinic", "LocalBusiness"],
    name: SITE.fullName,
    url: origin.href,
    telephone: SITE.phoneE164,
  },
  areaServed: { "@type": "Place", name: "Singapore" },
  offers: {
    "@type": "Offer",
    price: priceClinic,
    priceCurrency: "SGD",
    availability: "https://schema.org/InStock",
    url: new URL(bookHref, origin).href,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: origin.href },
    { "@type": "ListItem", position: 2, name: "Services", item: new URL("/services", origin).href },
    { "@type": "ListItem", position: 3, name: cardTitle ?? title, item: pageURL },
  ],
};

const schema: Record<string, unknown>[] = [serviceSchema, breadcrumbSchema];
if (faqs?.length) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}
---

<BaseLayout title={`${title} | Goji Physiotherapy`} description={description} schema={schema}>
  {/* Page header + facts */}
  <section class="svc-header">
    <div class="container svc-header__inner">
      <a href="/services" class="svc-header__back">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 3L5 8l5 5"/>
        </svg>
        All services
      </a>
      <h1>{cardTitle ?? title}</h1>
      <dl class="svc-facts">
        <div class="svc-facts__item">
          <dt>Duration</dt>
          <dd>{durationMin} min</dd>
        </div>
        <div class="svc-facts__item">
          <dt>Options</dt>
          <dd>{priceLabel}</dd>
        </div>
        <div class="svc-facts__item">
          <dt>Seen by</dt>
          <dd>{clinicianLabel}</dd>
        </div>
      </dl>
    </div>
  </section>

  {/* Main content */}
  <Section tone="surface">
    <div class="svc-body container--narrow">
      <Content />
    </div>
  </Section>

  {/* Sticky CTA */}
  <Section tone="linen">
    <div class="svc-cta">
      <div>
        <h2>Book your {cardTitle ?? title}</h2>
        <p>We'll take a few details and match you with the right physiotherapist. Prefer to talk it through first? Message us on WhatsApp.</p>
      </div>
      <div class="svc-cta__btns">
        <Button href={bookHref} variant="primary" size="lg">Book an appointment</Button>
        <Button slug="web-wa" variant="whatsapp" size="lg">Ask us on WhatsApp</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .svc-header {
    background: var(--bg-page);
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem);
    border-bottom: 1px solid var(--color-border);
  }
  .svc-header__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .svc-header__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-small);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    text-decoration: none;
  }
  .svc-header__back:hover { color: var(--color-primary); }

  .svc-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-2);
  }
  .svc-facts__item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .svc-facts__item dt {
    font-size: var(--fs-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .svc-facts__item dd {
    font-size: var(--fs-body);
    color: var(--text-default);
    font-weight: var(--weight-medium);
  }

  /* Prose content (mirrors the conditions page) */
  .svc-body :global(h2) {
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }
  .svc-body :global(h2:first-child) { margin-top: 0; }
  .svc-body :global(h3) {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }
  .svc-body :global(p) {
    color: var(--text-muted);
    margin-bottom: var(--space-4);
    line-height: var(--lh-body);
  }
  .svc-body :global(ul), .svc-body :global(ol) {
    color: var(--text-muted);
    margin-bottom: var(--space-4);
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .svc-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .svc-body :global(strong) {
    font-weight: var(--weight-semibold);
    color: var(--text-default);
  }

  /* CTA section */
  .svc-cta {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 760px) {
    .svc-cta {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
  .svc-cta h2 { margin-bottom: var(--space-2); }
  .svc-cta p { color: var(--text-muted); max-width: 44ch; }
  .svc-cta__btns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
