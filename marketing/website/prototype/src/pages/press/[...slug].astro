---
/**
 * /press/<slug> — a single piece of coverage.
 *
 * Copyright discipline: the body of this page is OUR summary and commentary.
 * The outlet's article is quoted at most once (frontmatter `pullQuote`), with
 * attribution, and linked. Never paste the article text here, in either
 * language - it is the publisher's copyright, and a duplicate of their page
 * would be ignored by search engines anyway.
 *
 * Schema follows the same honesty rule: the page is a WebPage whose `citation`
 * is the outlet's NewsArticle. We do not claim to be the article's publisher.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import { formatDate, isoDate } from "../../lib/dates.ts";
import { SITE } from "../../lib/site.ts";
import { clinicId, clinicRef } from "../../lib/schema.ts";

export async function getStaticPaths() {
  const entries = await getCollection("press", ({ data }) => !data.draft);
  return entries.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const {
  title,
  description,
  outlet,
  outletUrl,
  originalTitle,
  originalUrl,
  language,
  pubDate,
  author,
  featuring,
  pullQuote,
  heroImage,
  heroAlt,
} = entry.data;

const origin = Astro.site ?? new URL(Astro.url.origin);
const pageURL = new URL(Astro.url.pathname, origin).href;

const newsArticle = {
  "@type": "NewsArticle",
  headline: originalTitle,
  url: originalUrl,
  datePublished: isoDate(pubDate),
  inLanguage: language === "zh" ? "zh-SG" : "en-SG",
  ...(author ? { author: { "@type": "Person", name: author } } : {}),
  publisher: { "@type": "Organization", name: outlet, url: outletUrl },
  about: clinicRef(origin),
};

const pressSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: pageURL,
    inLanguage: "en-SG",
    citation: newsArticle,
    about: {
      "@id": clinicId(origin),
      "@type": "Organization",
      name: SITE.fullName,
      url: origin.href,
      subjectOf: newsArticle,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: origin.href },
      { "@type": "ListItem", position: 2, name: "Media", item: new URL("/press/", origin).href },
      { "@type": "ListItem", position: 3, name: title, item: pageURL },
    ],
  },
];
---

<BaseLayout
  title={`${title} | Goji Physiotherapy`}
  description={description}
  schema={pressSchema}
  searchType="Press"
>
  <article class="article-container">
    <div class="article-editorial">
      <div class="article-header">
        <a href="/press/" class="article-breadcrumb">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 3L5 8l5 5"></path>
          </svg>
          All press
        </a>
        <p class="article-category">{outlet}</p>
        <h1 class="article-title">{title}</h1>
        <p class="article-meta">
          Published <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
          {author && <span> &middot; by {author}</span>}
          {language === "zh" && <span> &middot; originally published in Chinese</span>}
        </p>
        {
          featuring.length > 0 && (
            <p class="article-featuring">
              Featuring{" "}
              {featuring.map((person, i) => (
                <>
                  {i > 0 && ", "}
                  <a href={`/team/${person.slug}/`}>{person.name}</a>
                </>
              ))}
            </p>
          )
        }
      </div>

      {
        heroImage && (
          <figure class="article-hero">
            <img src={heroImage} alt={heroAlt ?? ""} width="900" height="600" loading="eager" />
            {heroAlt && <figcaption class="article-hero__caption">{heroAlt}</figcaption>}
          </figure>
        )
      }

      <div class="article-body">
        <Content />
      </div>

      {
        pullQuote && (
          <figure class="article-quote">
            <blockquote>{pullQuote}</blockquote>
            <figcaption>
              Quoted in {originalTitle}, {outlet}, {formatDate(pubDate)}
            </figcaption>
          </figure>
        )
      }

      <div class="article-source">
        <h3 class="article-source__label">The original article</h3>
        <p class="article-source__title">{originalTitle}</p>
        <a
          class="article-source__link"
          href={originalUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read the full article on {outlet}
          <span aria-hidden="true"> &#8599;</span>
        </a>
        <p class="article-source__note">
          The full article is the publisher's and stays on their site.
        </p>
      </div>
    </div>
  </article>

  <Section tone="linen">
    <div class="article-cta">
      <div>
        <h2>Thinking about getting something looked at?</h2>
        <p>
          Message us to describe what you are experiencing and we will recommend
          the right appointment type.
        </p>
      </div>
      <div class="article-cta__btns">
        <Button slug="web-wa" variant="whatsapp" size="lg">Ask us on WhatsApp</Button>
        <Button href="/book/" variant="secondary" size="lg">Book an appointment</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .article-container {
    background: var(--bg-page);
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem);
    border-bottom: 1px solid var(--color-border);
  }

  .article-editorial {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  @media (max-width: 640px) {
    .article-editorial {
      padding: 0 var(--space-4);
    }
  }

  .article-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .article-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-small);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    text-decoration: none;
    align-self: start;
  }
  .article-breadcrumb:hover { color: var(--color-primary); }

  .article-category {
    font-size: var(--fs-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0;
  }

  .article-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: var(--lh-snug);
    color: var(--text-default);
    margin: 0;
  }

  .article-meta,
  .article-featuring {
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin: 0;
  }

  .article-featuring a {
    color: var(--color-primary);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }
  .article-featuring a:hover { text-decoration: underline; }

  .article-hero {
    margin: var(--space-6) 0;
    padding: 0;
  }

  .article-hero img {
    width: 100%;
    max-width: 900px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  .article-hero__caption {
    margin-top: var(--space-3);
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  .article-body {
    max-width: 740px;
  }

  .article-body :global(h2) {
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }
  .article-body :global(h2:first-child) { margin-top: 0; }

  .article-body :global(h3) {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }

  .article-body :global(p) {
    color: var(--text-muted);
    margin-bottom: var(--space-4);
    line-height: var(--lh-body);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    color: var(--text-muted);
    margin-bottom: var(--space-4);
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .article-body :global(strong) {
    font-weight: var(--weight-semibold);
    color: var(--text-default);
  }

  .article-quote {
    margin: var(--space-6) 0;
    padding-left: var(--space-5);
    border-left: 3px solid var(--color-primary);
    max-width: 740px;
  }

  .article-quote blockquote {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-snug);
    color: var(--text-default);
    margin: 0;
  }

  .article-quote figcaption {
    margin-top: var(--space-3);
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  .article-source {
    margin-top: var(--space-7);
    padding: var(--space-5);
    background: var(--bg-page);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    max-width: 740px;
  }

  .article-source__label {
    font-size: var(--fs-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0;
  }

  .article-source__title {
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
  }

  .article-source__link {
    display: inline-block;
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .article-source__note {
    margin-top: var(--space-3);
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  .article-cta {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  @media (min-width: 760px) {
    .article-cta {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  .article-cta h2 { margin-bottom: var(--space-2); }
  .article-cta p { color: var(--text-muted); max-width: 44ch; }
  .article-cta__btns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
