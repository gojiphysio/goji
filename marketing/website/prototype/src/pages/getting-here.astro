---
/**
 * Getting here — wayfinding to the clinic at Lentor Modern.
 *
 * A dedicated directions page: hero + at-a-glance, an embedded map, and one
 * block per travel mode (MRT / car / taxi & Grab) pairing written, turn-by-turn
 * steps with a short YouTube walkthrough for that route.
 *
 * Compliance/style (prototype AGENTS.md): warm, plain, no emojis in copy (the
 * source emojis become Tabler icons), regular dashes, never italic, tokens only.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import YouTubeShort from "../components/YouTubeShort.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../lib/site.ts";
import { cta } from "../lib/links.ts";

const title = "Getting Here | Goji Physiotherapy at Lentor MRT";
const description =
  "How to find Goji Physiotherapy at Lentor Modern - by MRT, by car with basement parking, or by taxi. Step-by-step directions and video guides for each route.";

// Quick facts for the hero at-a-glance strip.
const glance = [
  { icon: "subway", value: "1-minute", label: "walk from Lentor MRT, Exit 1" },
  { icon: "tabler:parking", value: "Basement", label: "parking at Lentor Modern" },
  { icon: "tabler:wheelchair", value: "Step-free", label: "access for wheelchairs and strollers via Lentor Drive" },
];

// Level 1 site plan of the mall, shown above the Google map.
const planSrc = "/photos/directions/lentor-modern-level-1.webp";
const planAlt =
  "Level 1 site plan of Lentor Modern showing Goji at unit #01-13, between Burger King and the Lentor MRT exit, with walking routes marked from Lentor MRT Exit 1, the Lentor Drive taxi stand, the Lentor Modern drop-off point and the travelator from the car park";

// Breadcrumb for rich results (Home -> Getting here).
const origin = Astro.site ?? new URL(Astro.url.origin);
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", origin).href },
    { "@type": "ListItem", position: 2, name: "Getting here", item: new URL("/getting-here/", origin).href },
  ],
};
---

<BaseLayout title={title} description={description} schema={breadcrumbSchema}>
  {/* ---- Hero ---- */}
  <section class="gh-hero">
    <div class="container gh-hero__grid">
      <div class="gh-hero__text" data-reveal>
        <p class="eyebrow">Getting here</p>
        <h1>Finding us at Lentor Modern</h1>
        <p class="gh-hero__lead">
          We are on the ground floor of Lentor Modern, next to
          <strong>Burger King</strong> and beside the Lentor Drive pick-up point.
          However you choose to travel, here's exactly how to find us, with a
          short video guide for each route.
        </p>
        <address class="gh-hero__address">
          {SITE.address.line1}<br />
          {SITE.address.line2}<br />
          <a href={cta("web-wa")} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp us on ${SITE.phone}`}>{SITE.phone}</a>
        </address>
        <div class="gh-hero__cta">
          <Button href={SITE.googleMaps} variant="primary" size="lg">Get directions</Button>
          <Button slug="web-wa" variant="whatsapp" size="lg">Ask us on WhatsApp</Button>
        </div>
      </div>

      <figure class="gh-photo gh-hero__photo" data-reveal>
        <img
          src="/photos/directions/exterior-frontage.webp"
          alt="Entrance to Goji Women's and Family Physiotherapy on the ground floor of Lentor Modern, next to Burger King and beside the Lentor Drive pick-up point"
          width="1600"
          height="1173"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          onerror="this.closest('.gh-photo').setAttribute('data-missing','')"
        />
        <figcaption class="gh-photo__placeholder" aria-hidden="true">
          <Icon name="tabler:photo" width={26} height={26} />
          <span>Photo of our frontage coming soon</span>
        </figcaption>
      </figure>
    </div>

    <div class="container">
      <ul class="gh-glance" data-reveal>
        {glance.map((g) => (
          <li class="gh-glance__item">
            <span class="gh-glance__icon" aria-hidden="true"><Icon name={g.icon} width={22} height={22} /></span>
            <span class="gh-glance__text">
              <span class="gh-glance__value">{g.value}</span>
              <span class="gh-glance__label">{g.label}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ---- Map ---- */}
  <Section tone="surface">
    <div class="gh-block-head" data-reveal>
      <p class="eyebrow">On the map</p>
      <h2>Lentor Modern, beside Lentor MRT</h2>
    </div>
    {/*
      Level 1 site plan. The graphic is wide and finely labelled, so the inline
      copy is a link to the full-size file - JS upgrades that link into a
      full-screen dialog, and without JS the image still opens on its own.
      The long alt describes the graphic; the anchor carries its own short label
      so the link name isn't a paragraph.
    */}
    <figure class="gh-plan" data-reveal>
      <a
        class="gh-plan__frame"
        href={planSrc}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Open the full-size Level 1 site plan"
        data-plan-open
      >
        <img
          src={planSrc}
          alt={planAlt}
          width="1920"
          height="870"
          loading="lazy"
          decoding="async"
        />
        <span class="gh-plan__zoom" aria-hidden="true">
          <Icon name="tabler:zoom-in" width={20} height={20} />
        </span>
      </a>
      <figcaption class="gh-plan__caption">
        Level 1 at Lentor Modern. We are at <strong>#01-13</strong>, next to
        Burger King and beside the Lentor Drive pick-up point.
      </figcaption>
    </figure>

    <dialog class="gh-plan-modal" data-plan-modal aria-label="Lentor Modern Level 1 site plan">
      <button type="button" class="gh-plan-modal__close" data-plan-close aria-label="Close the map">
        <Icon name="tabler:x" width={22} height={22} aria-hidden="true" />
      </button>
      <div class="gh-plan-modal__scroll">
        <img class="gh-plan-modal__img" src={planSrc} alt={planAlt} decoding="async" />
      </div>
    </dialog>

    <div class="gh-map" data-reveal>
      <iframe
        class="gh-map__frame"
        src={SITE.googleMapsEmbed}
        title="Map showing Goji Physiotherapy at Lentor Modern"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <div class="gh-map__cta" data-reveal>
      <Button href={SITE.googleMaps} variant="secondary">Open in Google Maps</Button>
    </div>
  </Section>

  {/*
    Travel-mode jump links. They sit here, directly above the three mode blocks
    they point at, rather than up in the hero - a nav that far from its targets
    read as a standalone control, and it pushed the map below the fold on a
    phone. Linen ground with no bottom padding so it flows into the By-MRT
    section as that group's header.
  */}
  <section class="gh-modes-bar">
    <div class="container">
      <nav class="gh-modes" aria-label="Choose how you are travelling" data-reveal>
        <p class="gh-modes__label">How are you getting here?</p>
        <div class="gh-modes__chips">
          <a href="#by-mrt" class="gh-mode-chip">
            <Icon name="subway" width={20} height={20} aria-hidden="true" /><span>By MRT</span>
          </a>
          <a href="#by-car" class="gh-mode-chip">
            <Icon name="tabler:steering-wheel" width={20} height={20} aria-hidden="true" /><span>By car</span>
          </a>
          <a href="#by-taxi" class="gh-mode-chip">
            <Icon name="tabler:car" width={20} height={20} aria-hidden="true" /><span>By taxi</span>
          </a>
        </div>
      </nav>
    </div>
  </section>

  {/* ---- By MRT ---- */}
  <Section tone="linen" id="by-mrt" class="gh-anchor">
    <div class="gh-mode" data-reveal>
      <div class="gh-mode__head">
        <span class="gh-mode__icon" aria-hidden="true"><Icon name="subway" width={24} height={24} /></span>
        <div>
          <p class="eyebrow">By MRT</p>
          <h2>A 1-minute walk from Lentor MRT</h2>
        </div>
      </div>
      <div class="gh-mode__body">
        <ol class="gh-steps">
          <li><span class="gh-steps__n">1</span><p>Exit Lentor MRT via <strong>Exit 1</strong>.</p></li>
          <li><span class="gh-steps__n">2</span><p>Turn right, then left.</p></li>
          <li><span class="gh-steps__n">3</span><p>We are next to <strong>Burger King</strong>, beside the pick-up point.</p></li>
        </ol>
        <div class="gh-mode__video">
          <YouTubeShort
            id="2-uAkhJUNgE"
            title="Walking from Lentor MRT"
            poster="/photos/directions/cover-mrt.webp"
          />
        </div>
      </div>
    </div>
  </Section>

  {/* ---- By car ---- */}
  <Section tone="surface" id="by-car" class="gh-anchor">
    <div class="gh-mode" data-reveal>
      <div class="gh-mode__head">
        <span class="gh-mode__icon" aria-hidden="true"><Icon name="tabler:steering-wheel" width={24} height={24} /></span>
        <div>
          <p class="eyebrow">By car</p>
          <h2>Basement parking at Lentor Modern</h2>
        </div>
      </div>
      <div class="gh-mode__body">
        <div class="gh-mode__main">
          <p class="gh-mode__lead">
            The entrance to the car park is on Lentor Central. Searching for
            <strong>Lentor Modern</strong> on Google Maps will direct you to the
            correct entrance.
          </p>
          <div class="gh-routes">
            <div class="gh-route">
              <p class="gh-route__pace"><Icon name="tabler:escalator" width={18} height={18} aria-hidden="true" /> Moving walkway</p>
              <p class="gh-route__desc">
                Take the moving walkway up to the mall, then take the escalator
                beside <strong>KFC</strong> down to Level M. Turn right along the
                outer corridor to the end of the row.
              </p>
            </div>
            <div class="gh-route">
              <p class="gh-route__pace"><Icon name="tabler:elevator" width={18} height={18} aria-hidden="true" /> Lift</p>
              <p class="gh-route__desc">
                Take the rightmost lift and select <strong>Level M</strong> (not
                Level 1, even though our unit is #01-13). Turn right after exiting
                and continue to the end of the row.
              </p>
            </div>
          </div>
        </div>
        <div class="gh-mode__video">
          <YouTubeShort
            id="uJ1_yvA-Zzk"
            title="From the car park"
            poster="/photos/directions/cover-car.webp"
          />
        </div>
      </div>
    </div>
  </Section>

  {/* ---- By taxi / Grab ---- */}
  <Section tone="linen" id="by-taxi" class="gh-anchor">
    <div class="gh-mode" data-reveal>
      <div class="gh-mode__head">
        <span class="gh-mode__icon" aria-hidden="true"><Icon name="tabler:car" width={24} height={24} /></span>
        <div>
          <p class="eyebrow">By taxi or Grab</p>
          <h2>Two drop-off points, both sheltered</h2>
        </div>
      </div>

      <div class="gh-grab" data-reveal>
        <p class="gh-grab__label">Open in Grab</p>
        <ul class="gh-grab__links">
          <li>
            <a
              class="gh-grab__link"
              href="https://app.grab.com/s/MBrymmum"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="tabler:map-pin" width={18} height={18} aria-hidden="true" />
              <span>Exit 1 (Lentor Drive), Lentor MRT Station (TE5)</span>
            </a>
          </li>
          <li>
            <a
              class="gh-grab__link"
              href="https://app.grab.com/s/j6NRBBzy"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="tabler:map-pin" width={18} height={18} aria-hidden="true" />
              <span>Lentor Modern Mall</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="gh-mode__taxi">
        <div class="gh-taxi">
          <div class="gh-taxi__text">
            <h3>Lentor Drive drop-off point (nearest)</h3>
            <p>
              Set <strong>Lentor Drive</strong> as your drop-off point. The clinic
              is beside it, with a fully sheltered walkway to our door.
            </p>
          </div>
          <div class="gh-mode__video">
            <YouTubeShort
              id="RbvIrfjta7Y"
              title="From the nearest taxi stand"
              poster="/photos/directions/cover-taxi-lentor-dr.webp"
            />
          </div>
        </div>
        <div class="gh-taxi">
          <div class="gh-taxi__text">
            <h3>Lentor Modern main drop-off point</h3>
            <p>
              Enter the mall through the <strong>Cold Storage</strong> entrance,
              then take the escalator beside <strong>KFC</strong> down to Level M.
              Turn right along the outer corridor and continue to the end of the
              row.
            </p>
          </div>
          <div class="gh-mode__video">
            <YouTubeShort
              id="cvayU97-EOw"
              title="From Lentor Modern's main taxi stand"
              poster="/photos/directions/cover-taxi-cold-storage.webp"
            />
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* ---- Closing CTA ---- */}
  <Section tone="closing">
    <div class="gh-closing" data-reveal>
      <h2>Can't find us?</h2>
      <p>
        If you have trouble finding us, message us on WhatsApp and we'll guide
        you to the clinic. We look forward to seeing you.
      </p>
      <div class="gh-closing__cta">
        <Button slug="web-wa" variant="whatsapp" size="lg">Message us on WhatsApp</Button>
        <Button href="/book/" variant="primary" size="lg" class="gh-btn-light">Book an appointment</Button>
      </div>
    </div>
  </Section>

  {/* Reveal-on-scroll: progressive enhancement only. */}
  <noscript>
    <style>[data-reveal] { opacity: 1 !important; transform: none !important; }</style>
  </noscript>
  {/* Click-to-enlarge for the site plan; the link works on its own without JS. */}
  <script is:inline>
    (function () {
      var trigger = document.querySelector("[data-plan-open]");
      var modal = document.querySelector("[data-plan-modal]");
      if (!trigger || !modal || typeof modal.showModal !== "function") return;
      trigger.addEventListener("click", function (e) {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        modal.showModal();
      });
      var close = modal.querySelector("[data-plan-close]");
      if (close) close.addEventListener("click", function () { modal.close(); });
      modal.addEventListener("click", function (e) {
        if (e.target === modal) modal.close();
      });
    })();
  </script>

  <script is:inline>
    (function () {
      var items = document.querySelectorAll("[data-reveal]");
      var reveal = function (el) { el.classList.add("is-visible"); };
      var reduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduced || !("IntersectionObserver" in window)) {
        items.forEach(reveal);
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { reveal(e.target); io.unobserve(e.target); }
        });
      }, { rootMargin: "0px 0px -12% 0px", threshold: 0.15 });
      items.forEach(function (el) { io.observe(el); });
    })();
  </script>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .gh-hero {
    background: var(--bg-page);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }
  .gh-hero__grid {
    display: grid;
    gap: clamp(var(--space-5), 4vw, var(--space-7));
    align-items: center;
  }
  @media (min-width: 860px) {
    .gh-hero__grid { grid-template-columns: 1.05fr 0.95fr; }
  }
  .gh-hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .gh-hero__text h1 { margin-top: var(--space-2); }
  .gh-hero__lead {
    font-size: var(--fs-body);
    color: var(--text-muted);
    line-height: var(--lh-body);
    max-width: 52ch;
  }
  .gh-hero__address {
    font-style: normal;
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
    line-height: var(--lh-snug);
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-primary);
  }
  .gh-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  /* Photo treatment (frontage) with graceful missing-file fallback. */
  .gh-photo {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    background: var(--bg-content);
  }
  .gh-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .gh-photo__placeholder {
    display: none;
    position: absolute;
    inset: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    text-align: center;
    padding: var(--space-5);
    color: var(--text-muted);
    font-size: var(--fs-small);
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--color-primary) 12%, transparent), transparent 70%),
      var(--bg-content);
  }
  .gh-photo[data-missing] img { display: none; }
  .gh-photo[data-missing] .gh-photo__placeholder { display: flex; }

  /* Travel-mode selector (jump links), sitting above the three mode blocks. */
  .gh-modes-bar {
    background: var(--bg-page);
    padding-block-start: var(--section-y);
  }
  .gh-modes {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .gh-modes__label {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
  }
  .gh-modes__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .gh-mode-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.15rem;
    border-radius: var(--radius-pill);
    background: var(--bg-content);
    border: 1px solid var(--color-border);
    color: var(--text-default);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .gh-mode-chip :global(svg) { color: var(--color-primary); flex: none; }
  .gh-mode-chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-1px);
  }

  /* Anchor offset so the sticky header does not cover a jumped-to heading.
     :global is required, not optional - this class is passed through to
     Section.astro and lands on *its* root element, which carries Section's
     scope attribute, not this page's. Scoped `.gh-anchor` silently matched
     nothing. */
  :global(.gh-anchor) { scroll-margin-top: 84px; }

  /* At-a-glance strip. Deliberately NOT cards: white fill + border + shadow is
     this site's interactive recipe (buttons, chips, linked cards), and wearing
     it made these three static facts read as tappable. Bare rows on the linen
     ground, separated by hairlines - horizontal when stacked, vertical once
     they sit side by side. */
  .gh-glance {
    list-style: none;
    padding: 0;
    margin-top: clamp(var(--space-4), 2.5vw, var(--space-5));
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
  }
  .gh-glance__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }
  .gh-glance__item + .gh-glance__item { border-top: 1px solid var(--rule); }
  @media (min-width: 620px) {
    .gh-glance { grid-template-columns: repeat(3, 1fr); }
    .gh-glance__item { padding-inline: var(--space-5); }
    .gh-glance__item:first-child { padding-inline-start: 0; }
    .gh-glance__item + .gh-glance__item {
      border-top: 0;
      border-left: 1px solid var(--rule);
    }
  }
  .gh-glance__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-primary) 10%, var(--bg-page));
    color: var(--color-primary);
  }
  .gh-glance__text { display: flex; flex-direction: column; gap: 0.15rem; }
  .gh-glance__value {
    font-family: var(--font-body);
    font-size: var(--fs-h3);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    line-height: 1.1;
  }
  .gh-glance__label {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: var(--lh-snug);
  }

  /* ---- Section heads ---- */
  .gh-block-head { margin-bottom: var(--space-5); }
  .gh-block-head h2 { margin-top: var(--space-2); }

  /* ---- Map ---- */
  .gh-map {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }
  .gh-map__frame { width: 100%; height: 100%; border: 0; display: block; }
  .gh-map__cta { margin-top: var(--space-5); }

  /* ---- Level 1 site plan ---- */
  .gh-plan { margin: 0 0 var(--space-5); }
  .gh-plan__frame {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    background: var(--color-linen);
    cursor: zoom-in;
  }
  .gh-plan__frame img { width: 100%; height: auto; display: block; }
  /* The affordance is a badge on the plan itself, matching the modal's close
     button - the same red circle opens it and closes it. It used to be a line
     of caption text below, which looked like a control but wasn't one (the
     whole image is the link, the caption sat outside it).
     Bottom-right, not top-right: the top-right of the plan carries the Lentor
     Drive drop-off callout, which is exactly what a taxi arrival needs. Down
     here it only overlaps the tail of the legend strip, and that legend is
     fully readable in the enlarged view. */
  .gh-plan__zoom {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-linen);
    box-shadow: var(--shadow-sm);
  }
  .gh-plan__caption {
