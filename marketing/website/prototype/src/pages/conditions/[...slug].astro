---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";

export async function getStaticPaths() {
  const conditions = await getCollection("conditions", ({ data }) => !data.draft);
  return conditions.map((c) => ({ params: { slug: c.slug }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const {
  title,
  description,
  cardTitle,
  category,
  ctaSlug,
  author,
  datePublished,
  lastReviewed,
  relatedService,
} = entry.data;

// Byline links to the clinician's bio page (E-E-A-T: a named, credentialed
// reviewer that answer engines can resolve to a Person entity).
const team = await getCollection("team", ({ data }) => !data.draft);
const authorEntry = team.find((t) => t.data.name === author);

// "Related" row: condition spoke → service hub internal link.
const services = await getCollection("services", ({ data }) => !data.draft);
const related = relatedService
  ? services.find((s) => s.slug === relatedService)
  : undefined;

const reviewedDate = lastReviewed ?? datePublished;
const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-SG", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });

// FAQPage JSON-LD is extracted from the body's "## Frequently asked questions"
// section (### question + answer paragraphs) so the visible copy stays the
// single source of truth. Defensive: any parse miss emits nothing.
function extractFaqs(body: string): { q: string; a: string }[] {
  try {
    const heading = body.match(/^##\s+Frequently asked questions\s*$/im);
    if (!heading || heading.index === undefined) return [];
    const rest = body.slice(heading.index + heading[0].length);
    const nextH2 = rest.search(/^##\s+/m);
    const section = nextH2 === -1 ? rest : rest.slice(0, nextH2);
    return section
      .split(/^###\s+/m)
      .slice(1)
      .map((block) => {
        const newline = block.indexOf("\n");
        const q = (newline === -1 ? block : block.slice(0, newline)).trim();
        const a = (newline === -1 ? "" : block.slice(newline + 1))
          .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1") // links → plain text
          .replace(/[*_`]/g, "")
          .replace(/^\s*[-*]\s+/gm, "") // list markers (line starts only)
          .replace(/\s*\n\s*/g, " ")
          .trim();
        return { q, a };
      })
      .filter((f) => f.q && f.a);
  } catch {
    return [];
  }
}
const faqs = extractFaqs(entry.body);

const origin = Astro.site ?? new URL(Astro.url.origin);
const pageURL = new URL(Astro.url.pathname, origin).href;
// MedicalWebPage marks this as clinical reference content (GEO: answer engines
// prefer typed medical pages); BreadcrumbList gives crawlers the Home ›
// Conditions › <page> trail on these nested routes.
const authorPerson = {
  "@type": "Person",
  name: author,
  ...(authorEntry && {
    jobTitle: authorEntry.data.role,
    url: new URL(`/team/${authorEntry.slug}`, origin).href,
  }),
};
const conditionSchema: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    name: title,
    description,
    url: pageURL,
    mainEntityOfPage: pageURL,
    about: { "@type": "MedicalCondition", name: cardTitle ?? title },
    audience: { "@type": "MedicalAudience", audienceType: "Patient" },
    author: authorPerson,
    reviewedBy: authorPerson,
    ...(datePublished && { datePublished }),
    ...(reviewedDate && { lastReviewed: reviewedDate }),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: origin.href },
      { "@type": "ListItem", position: 2, name: "Conditions", item: new URL("/conditions", origin).href },
      { "@type": "ListItem", position: 3, name: cardTitle ?? title, item: pageURL },
    ],
  },
];
if (faqs.length) {
  conditionSchema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}
---

<BaseLayout title={`${title} | Goji Physiotherapy`} description={description} schema={conditionSchema}>
  {/* Page header */}
  <section class="cond-header">
    <div class="container cond-header__inner">
      <a href="/conditions" class="cond-header__back">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 3L5 8l5 5"/>
        </svg>
        All conditions
      </a>
      <h1>{cardTitle ?? title}</h1>
      <p class="cond-header__byline">
        Clinically reviewed by
        {authorEntry ? (
          <a href={`/team/${authorEntry.slug}`}>{author}</a>
        ) : (
          <span>{author}</span>
        )}{authorEntry && `, ${authorEntry.data.role}`}{reviewedDate && ` · Last reviewed ${formatDate(reviewedDate)}`}
      </p>
    </div>
  </section>

  {/* Main content */}
  <Section tone="surface">
    <div class="cond-body container--narrow">
      <Content />
      {(related || authorEntry) && (
        <nav class="cond-related" aria-label="Related pages">
          <span class="cond-related__label">Related</span>
          {related && (
            <a href={`/services/${related.slug}`}>{related.data.cardTitle ?? related.data.title}</a>
          )}
          {authorEntry && <a href={`/team/${authorEntry.slug}`}>Meet {author}</a>}
          <a href="/conditions">All conditions we treat</a>
        </nav>
      )}
    </div>
  </Section>

  {/* Sticky CTA */}
  <Section tone="linen">
    <div class="cond-cta">
      <div>
        <h2>Ready to get some answers?</h2>
        <p>Message us to describe your symptoms — we will recommend the right appointment type and answer any questions before you book.</p>
      </div>
      <div class="cond-cta__btns">
        <Button slug={ctaSlug as "web-wa" | "web-book"} variant="whatsapp" size="lg">Ask us on WhatsApp</Button>
        <Button slug="web-book" variant="secondary" size="lg">Book an appointment</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .cond-header {
    background: var(--bg-page);
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem);
    border-bottom: 1px solid var(--color-border);
  }
  .cond-header__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .cond-header__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-small);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    text-decoration: none;
  }
  .cond-header__back:hover { color: var(--color-primary); }
  .cond-header__byline {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .cond-header__byline a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .cond-header__byline a:hover { color: var(--color-primary); }

  /* Related links row (internal linking: condition → service hub / clinician) */
  .cond-related {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-small);
  }
  .cond-related__label {
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }
  .cond-related a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Prose content */
  .cond-body {
    /* The container--narrow class sets max-width: 760px */
  }
  .cond-body :global(h2) {
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }
  .cond-body :global(h2:first-child) {
    margin-top: 0;
  }
  .cond-body :global(p) {
    color: var(--text-muted);
    margin-bottom: var(--space-4);
    line-height: var(--lh-body);
  }
  .cond-body :global(ul), .cond-body :global(ol) {
    color: var(--text-muted);
    margin-bottom: var(--space-4);
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .cond-body :global(strong) {
    font-weight: var(--weight-semibold);
    color: var(--text-default);
  }
  .cond-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: var(--space-7);
  }
  .cond-body :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding-left: var(--space-5);
    color: var(--text-muted);
  }

  /* CTA section */
  .cond-cta {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 760px) {
    .cond-cta {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
  .cond-cta h2 { margin-bottom: var(--space-2); }
  .cond-cta p { color: var(--text-muted); max-width: 44ch; }
  .cond-cta__btns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
