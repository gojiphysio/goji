---
/**
 * ContactBlock — booking prompt + address + hours + WhatsApp (the conversion
 * surface). CTAs route through the tracked redirector via the Button `slug`.
 */
import Button from "./Button.astro";
import BerryList from "./BerryList.astro";
import { SITE } from "../lib/site.ts";
---

<div class="contact">
  <div class="contact__cta">
    <h2>Ready when you are</h2>
    <p class="contact__lead">
      Message us with a question, or book a first session. We'll talk through
      what's going on before we treat.
    </p>
    <div class="contact__actions">
      <Button href="/book/" variant="primary" size="lg">Book an appointment</Button>
      <Button slug="web-wa" variant="whatsapp" size="lg">WhatsApp us</Button>
    </div>
  </div>

  <div class="contact__details">
    <div class="contact__group">
      <h3>Find us</h3>
      <p>
        {SITE.address.line1}<br />
        {SITE.address.line2}
      </p>
      <p class="contact__note">{SITE.address.note}</p>
      <div class="contact__links">
        <a href="/getting-here/" class="contact__directions">
          Getting here: parking, MRT &amp; video guides &rarr;
        </a>
        <a
          href={SITE.googleMaps}
          class="contact__directions"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open in Google Maps &rarr;
        </a>
      </div>
    </div>
    <div class="contact__group">
      <h3>Hours</h3>
      <BerryList items={SITE.hours.map((h) => `${h.days}: ${h.time}`)} class="contact__hours" />
    </div>
    <div class="contact__group">
      <h3>Email</h3>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
  </div>
</div>

<style>
  .contact {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 820px) {
    .contact {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-9);
      align-items: start;
    }
  }
  .contact h2 {
    margin: var(--space-2) 0 var(--space-3);
  }
  .contact__lead {
    color: var(--text-muted);
    max-width: 42ch;
    margin-bottom: var(--space-5);
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .contact__details {
    display: grid;
    gap: var(--space-5);
  }
  .contact__group h3 {
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }
  .contact__note {
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin-top: var(--space-2);
  }
  .contact__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .contact__directions {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: var(--weight-medium);
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .contact__directions:hover { color: var(--color-primary-deep); }

  /* Hours list: larger, clearer berry-oval markers (keeps the 45deg tilt) */
  .contact :global(.contact__hours li) {
    padding-left: 1.9rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .contact :global(.contact__hours li)::before {
    width: 0.5rem;
    height: 0.85rem;
    top: 0.55em;
    background-color: var(--color-primary);
  }
</style>
