---
/**
 * SearchDialog — the site-wide search sheet, opened from the header button
 * (`[data-search-open]`), `/` or Cmd/Ctrl-K.
 *
 * Built on a native <dialog> + showModal(), which gives us focus trapping,
 * Escape-to-close, the backdrop and focus restoration for free — far less
 * code than hand-rolling those, and better behaved with screen readers.
 *
 * Nothing search-related is downloaded until the sheet is first opened: the
 * Pagefind runtime is dynamically imported on demand (see src/lib/search.ts).
 *
 * No-JS / pre-hydration fallback: the form is a real GET form pointing at
 * /search, so submitting always works.
 */
import Button from "./Button.astro";
---

<dialog class="search" id="site-search" aria-label="Search this site">
  <form class="search__bar" role="search" method="get" action="/search">
    <svg class="search__bar-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20l-3.5-3.5"></path>
    </svg>
    <label class="visually-hidden" for="search-input">Search this site</label>
    <input
      id="search-input"
      class="search__input"
      type="search"
      name="q"
      inputmode="search"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      placeholder="Search conditions, services, articles"
    />
    <button type="button" class="search__close" data-search-close aria-label="Close search">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </form>

  <div class="search__body">
    <p class="search__status visually-hidden" role="status" aria-live="polite" data-search-status></p>

    <div class="search__hint" data-search-hint>
      <p class="eyebrow">Try searching for</p>
      <div class="search__chips">
        <button type="button" data-search-suggest="leaking">leaking</button>
        <button type="button" data-search-suggest="pelvic floor">pelvic floor</button>
        <button type="button" data-search-suggest="scoliosis">scoliosis</button>
        <button type="button" data-search-suggest="pilates">pilates</button>
        <button type="button" data-search-suggest="home visit">home visit</button>
      </div>
    </div>

    <ul class="search__results" data-search-results hidden></ul>

    <div class="search__empty" data-search-empty hidden>
      <h2>Nothing matched that</h2>
      <p>
        Tell us what you are looking for and we will point you to the right page
        or the right appointment type.
      </p>
      <Button slug="web-wa" variant="whatsapp">Ask us on WhatsApp</Button>
    </div>

    <p class="search__unavailable" data-search-unavailable hidden>
      Search is generated at build time. Run <code>npm run build</code> then
      <code>npm run preview</code> to try it locally.
    </p>
  </div>
</dialog>

<style>
  .search {
    /* Full-screen sheet on a phone: the whole viewport is the search surface. */
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: var(--bg-page);
    color: var(--text-default);
    overflow: hidden;
  }
  .search::backdrop {
    background: color-mix(in srgb, var(--color-ink) 60%, transparent);
  }
  @media (min-width: 720px) {
    .search {
      width: min(640px, 92vw);
      height: auto;
      max-height: 76vh;
      margin: 8vh auto auto;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--color-border);
    }
  }

  .search__bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-content);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .search__bar-icon {
    flex: none;
    color: var(--text-muted);
  }
  .search__input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 0.5rem 0;
    font-size: 1rem; /* >=16px stops iOS zooming the page on focus */
    width: auto;
  }
  .search__input:focus {
    outline: none;
    border-color: transparent;
    box-shadow: none;
  }
  .search__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .search__close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .search__close:hover {
    background: var(--color-linen-deep);
    color: var(--text-default);
  }

  .search__body {
    padding: var(--space-4);
    overflow-y: auto;
    max-height: calc(100% - 4.5rem);
    -webkit-overflow-scrolling: touch;
  }
  @media (min-width: 720px) {
    .search__body { max-height: calc(76vh - 4.5rem); }
  }

  .search__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .search__chips button {
    border: 1px solid var(--color-border);
    background: var(--bg-content);
    color: var(--text-muted);
    border-radius: var(--radius-pill);
    padding: 0.5rem 0.9rem;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .search__chips button:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .search__results {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  /* A `display` declaration beats the UA's `[hidden] { display: none }`, so
     every pane that sets display needs this guard or it stays visible when
     hidden. Same trap the booking form hit - see the website AGENTS.md. */
  .search__results[hidden],
  .search__empty[hidden],
  .search__hint[hidden],
  .search__unavailable[hidden] {
    display: none;
  }
  .search__results :global(.search__group-title) {
    font-size: var(--fs-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .search__results :global(.search__group-list) {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .search__results :global(.search__hit) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    /* Comfortable thumb target on a phone. */
    padding: var(--space-3);
    min-height: 44px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
  }
  .search__results :global(.search__hit:hover),
  .search__results :global(.search__hit:focus-visible) {
    background: var(--color-linen-deep);
  }
  .search__results :global(.search__hit-title) {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
  }
  .search__results :global(.search__hit-excerpt) {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: var(--lh-snug);
  }
  .search__results :global(mark) {
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
    color: var(--text-default);
    border-radius: 3px;
    padding: 0 0.15em;
  }

  .search__empty {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }
  .search__empty p {
    color: var(--text-muted);
    max-width: 44ch;
  }

  .search__unavailable {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .search__unavailable code {
    background: var(--color-linen-deep);
    border-radius: 3px;
    padding: 0.1em 0.35em;
  }
</style>

<script>
  import { runSearch, renderResults } from "../lib/search.ts";

  const dialog = document.getElementById("site-search") as HTMLDialogElement | null;
  if (dialog) {
    const input = dialog.querySelector<HTMLInputElement>(".search__input")!;
    const results = dialog.querySelector<HTMLElement>("[data-search-results]")!;
    const hint = dialog.querySelector<HTMLElement>("[data-search-hint]")!;
    const empty = dialog.querySelector<HTMLElement>("[data-search-empty]")!;
    const missing = dialog.querySelector<HTMLElement>("[data-search-unavailable]")!;
    const status = dialog.querySelector<HTMLElement>("[data-search-status]")!;

    const show = (el: HTMLElement, on: boolean) => {
      if (on) el.removeAttribute("hidden");
      else el.setAttribute("hidden", "");
    };

    /** Only one of the four panes is ever visible. */
    const showPane = (pane: "hint" | "results" | "empty" | "missing") => {
      show(hint, pane === "hint");
      show(results, pane === "results");
      show(empty, pane === "empty");
      show(missing, pane === "missing");
    };

    // Ignore a stale response that resolves after a newer keystroke.
    let generation = 0;

    const update = async (query: string) => {
      const mine = ++generation;
      if (!query.trim()) {
        results.innerHTML = "";
        showPane("hint");
        status.textContent = "";
        return;
      }
      const hits = await runSearch(query);
      if (mine !== generation) return;

      if (hits === null) {
        results.innerHTML = "";
        showPane("missing");
        status.textContent = "Search is not available in this build.";
        return;
      }
      if (!hits.length) {
        results.innerHTML = "";
        showPane("empty");
        status.textContent = `No results for ${query}.`;
        return;
      }
      renderResults(results, hits);
      showPane("results");
      status.textContent = `${hits.length} result${hits.length === 1 ? "" : "s"} for ${query}.`;
    };

    let timer: number | undefined;
    input.addEventListener("input", () => {
      window.clearTimeout(timer);
      const value = input.value;
      timer = window.setTimeout(() => update(value), 150);
    });

    // Enter falls through to the form's GET action (/search?q=) only when we
    // have nothing to show; otherwise keep the visitor in the sheet.
    dialog.querySelector("form")!.addEventListener("submit", (e) => {
      if (!results.hasAttribute("hidden")) e.preventDefault();
    });

    dialog.querySelectorAll<HTMLButtonElement>("[data-search-suggest]").forEach((chip) => {
      chip.addEventListener("click", () => {
        input.value = chip.dataset.searchSuggest || "";
        input.focus();
        update(input.value);
      });
    });

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      // showModal() traps focus and restores it on close; we only lock the
      // page behind the sheet so a phone doesn't scroll the body underneath.
      document.documentElement.style.overflow = "hidden";
      input.focus();
    };
    const close = () => dialog.close();

    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
    });

    document.querySelectorAll("[data-search-open]").forEach((btn) =>
      btn.addEventListener("click", open),
    );
    dialog.querySelector("[data-search-close]")!.addEventListener("click", close);

    // Click on the backdrop (i.e. outside the sheet) closes it.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });

    document.addEventListener("keydown", (e) => {
      const el = document.activeElement;
      const typing =
        el instanceof HTMLInputElement ||
        el instanceof HTMLTextAreaElement ||
        el instanceof HTMLSelectElement ||
        (el as HTMLElement | null)?.isContentEditable;

      if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        open();
      } else if (e.key === "/" && !typing && !dialog.open) {
        e.preventDefault();
        open();
      }
    });

    // Arrow keys walk the result list; Escape is handled natively by <dialog>.
    dialog.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
      const links = [...dialog.querySelectorAll<HTMLAnchorElement>(".search__hit")];
      if (!links.length) return;
      e.preventDefault();
      const at = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === "ArrowDown") {
        (at === -1 || at === links.length - 1 ? links[0] : links[at + 1]).focus();
      } else if (at <= 0) {
        input.focus();
      } else {
        links[at - 1].focus();
      }
    });
  }
</script>
