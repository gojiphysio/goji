---
/**
 * BookingForm — a 3-step, mobile-first booking flow (Service & format ->
 * When & who -> Your details) that ends in an on-page confirmation.
 *
 * Phase 1: driven by the `bookingApi` MOCK (src/lib/booking.ts) — availability
 * and submission are simulated. Phase 2 swaps that module for real Plato calls;
 * this component does not change.
 */
import FormField from "./FormField.astro";
import ServiceOption from "./ServiceOption.astro";
import Button from "../Button.astro";
import BloomFlipbook from "../BloomFlipbook.astro";
import { services } from "../../lib/services";
import { clinicians } from "../../lib/clinicians";
import { physioCategories } from "../../lib/physioCategories";
import { cta } from "../../lib/links";

const steps = [
  { n: 1, label: "Service" },
  { n: 2, label: "Time" },
  { n: 3, label: "Details" },
];
---

<form class="booking" id="booking-form" novalidate>
  <ol class="booking__progress" aria-label="Booking steps">
    {
      steps.map((s) => (
        <li class="booking__pstep" data-progress={String(s.n)}>
          <span class="booking__pnum" aria-hidden="true">{s.n}</span>
          <span class="booking__plabel">{s.label}</span>
        </li>
      ))
    }
  </ol>

  {/* ---------- Step 1: Service & format ---------- */}
  <fieldset class="booking__step" data-step="1">
    <legend class="booking__legend">
      <h2>What would you like to book?</h2>
    </legend>

    {/* The physiotherapy sub-type sits directly under the Physiotherapy option,
        so choosing it is the immediate next step. It's required and narrows which
        clinicians' calendars open (see src/lib/physioCategories.ts). */}
    <div class="booking__services" role="group" aria-label="Service">
      {services.filter((s) => !s.bookingHidden).map((s) => (
        <Fragment>
          <ServiceOption service={s} />
          {s.id === "physiotherapy" && (
            <div class="booking__focus" data-physio-focus hidden>
              <p class="booking__sublabel" id="focus-label">What type of physiotherapy?</p>
              <div class="booking__focus-opts" role="radiogroup" aria-labelledby="focus-label">
                {physioCategories.map((c) => (
                  <label class="fopt">
                    <input class="fopt__input visually-hidden" type="radio" name="physioFocus" value={c.id} />
                    <span class="fopt__name">{c.label}</span>
                    <span class="fopt__hint">{c.hint}</span>
                    <span class="fopt__tick" aria-hidden="true" />
                  </label>
                ))}
              </div>
              <p class="booking__error" data-error="physioFocus" role="alert" hidden></p>
            </div>
          )}
          {(s.id === "physiotherapy" || s.id === "paediatric-physiotherapy") && (
            <div class="booking__variant" data-physio-variant hidden>
              <p class="booking__sublabel" id="variant-label">Select session duration</p>
              <div class="booking__variant-opts" role="radiogroup" aria-labelledby="variant-label">
                {physioCategories
                  .find((c) => c.id === "paediatrics")
                  ?.variants && Object.entries(physioCategories.find((c) => c.id === "paediatrics")!.variants!).map(([variantId, variant]) => (
                  <label class="vopt">
                    <input class="vopt__input visually-hidden" type="radio" name="variant" value={variantId} />
                    <span class="vopt__name">{variant.durationMin} min {variant.description && <span class="vopt__desc">{`(${variant.description})`}</span>}</span>
                    <span class="vopt__price">${variant.price}</span>
                    <span class="vopt__tick" aria-hidden="true" />
                  </label>
                ))}
              </div>
              <p class="booking__error" data-error="variant" role="alert" hidden></p>
            </div>
          )}
        </Fragment>
      ))}
    </div>
    <p class="booking__error" data-error="service" role="alert" hidden></p>

    <div class="booking__where" data-where hidden>
      <p class="booking__sublabel">Where would you like to be seen?</p>
      <div class="booking__toggle" role="radiogroup" aria-label="Location">
        <label class="pill">
          <input class="pill__input visually-hidden" type="radio" name="format" value="clinic" checked />
          <span class="pill__face">In-clinic</span>
        </label>
        <label class="pill" data-home-label>
          <input class="pill__input visually-hidden" type="radio" name="format" value="home" />
          <span class="pill__face">Home visit</span>
        </label>
      </div>
      <p class="booking__hint" data-home-hint hidden>
        This service is offered in-clinic only.
      </p>

      <div class="booking__address" data-address hidden>
        <p class="booking__disclaimer">
          Home visits include a $120 travel surcharge on top of the session fee.
        </p>
        <div class="booking__addr-grid">
          <FormField id="addr-block" name="addr-block" label="Block / house number" required={true} autocomplete="address-line1" placeholder="e.g. 123B" />
          <FormField id="addr-postal" name="addr-postal" label="Postal code" required={true} inputmode="numeric" autocomplete="postal-code" placeholder="6 digits" />
          <FormField id="addr-street" name="addr-street" label="Street name" required={true} autocomplete="address-line2" placeholder="e.g. Lentor Central" />
          <FormField id="addr-building" name="addr-building" label="Building name (optional)" placeholder="e.g. Lentor Modern" />
          <FormField id="addr-unit" name="addr-unit" label="Unit number (optional)" placeholder="e.g. #12-34" />
        </div>
        <FormField
          id="addr-notes"
          name="addr-notes"
          label="Directions, access & parking (optional)"
          textarea={true}
          placeholder="Landmarks, gate or lift access, and where to park when you arrive"
        />
      </div>
    </div>

    <div class="booking__nav">
      <button type="button" class="bbtn bbtn--primary" data-nav="next">
        Continue <span class="bbtn__arrow" aria-hidden="true">&rarr;</span>
      </button>
    </div>
  </fieldset>

  {/* ---------- Step 2: When & who ---------- */}
  <fieldset class="booking__step" data-step="2" hidden>
    <legend class="booking__legend">
      <h2>When works for you?</h2>
    </legend>

    {/* What step 1 chose, so this step doesn't feel unmoored from it. */}
    <p class="booking__recap" data-recap hidden></p>

    <div class="booking__datewrap">
      <p class="booking__sublabel" id="date-label">
        Preferred date <span class="field__req" aria-hidden="true">*</span>
      </p>
      <input type="hidden" id="date" name="date" />
      <div class="cal" data-cal aria-labelledby="date-label">
        <div class="cal__head">
          <button type="button" class="cal__nav" data-cal-prev aria-label="Previous month">
            <span aria-hidden="true">&lsaquo;</span>
          </button>
          <span class="cal__title" data-cal-title aria-live="polite"></span>
          <button type="button" class="cal__nav" data-cal-next aria-label="Next month">
            <span aria-hidden="true">&rsaquo;</span>
          </button>
        </div>
        <div class="cal__dow" aria-hidden="true">
          <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span>
          <span>Thu</span><span>Fri</span><span>Sat</span>
        </div>
        <div class="cal__grid" data-cal-grid role="grid"></div>
      </div>
      <p class="field__error" id="date-error" role="alert" hidden></p>
    </div>

    <div class="booking__slots">
      <p class="booking__sublabel">Available times</p>
      <div class="booking__slotlist" data-slots></div>
      <p class="booking__hint" data-slots-msg>Pick a date to see available times.</p>
      <p class="booking__error" data-error="time" role="alert" hidden></p>
      {/* The one WhatsApp escape hatch on this step: covers same-day/urgent
          (online booking opens from tomorrow) and can't-find-a-time. */}
      <p class="booking__hint booking__wa-note">
        Online booking opens from tomorrow. Need to be seen sooner, or can't
        find a time that works?
        <a href={cta("web-wa")} target="_blank" rel="noopener">Message us on WhatsApp</a>
        and we'll help.
      </p>
    </div>

    {/* Most bookers have no clinician preference, so the picker lives behind a
        disclosure and "First available" stays the pre-selected default. */}
    <details class="booking__clinician" data-clinician-details>
      <summary class="booking__clinician-summary">
        <span>Prefer a specific clinician?</span>
        <span class="booking__clinician-cur" data-clinician-current>First available</span>
      </summary>
      <div class="booking__clinician-body">
        <div class="booking__clinicians" role="radiogroup" aria-label="Preferred clinician">
          <label class="copt copt--first" data-clinician-opt data-first-available>
            <input class="copt__input visually-hidden" type="radio" name="clinician" value="" checked />
            <span class="copt__name">
              First available
              <span class="copt__badge">Recommended</span>
            </span>
            <span class="copt__role">We'll match you with the soonest clinician for your service</span>
            <span class="copt__tick" aria-hidden="true"></span>
          </label>
          <p class="booking__clinician-or" aria-hidden="true">Or pick someone specific</p>
          {
            clinicians.map((c) => (
              <label class="copt" data-clinician-opt data-services={c.services.join(" ")} hidden>
                <input class="copt__input visually-hidden" type="radio" name="clinician" value={c.id} />
                <span class="copt__name">{c.name}</span>
                <span class="copt__role">{c.role}</span>
                <span class="copt__tick" aria-hidden="true" />
              </label>
            ))
          }
        </div>
      </div>
    </details>

    <div class="booking__nav">
      <button type="button" class="bbtn bbtn--ghost" data-nav="back">Back</button>
      <button type="button" class="bbtn bbtn--primary" data-nav="next">
        Continue <span class="bbtn__arrow" aria-hidden="true">&rarr;</span>
      </button>
    </div>
  </fieldset>

  {/* ---------- Step 3: Your details ---------- */}
  <fieldset class="booking__step" data-step="3" hidden>
    <legend class="booking__legend">
      <h2>Your details</h2>
    </legend>

    <div class="booking__grid">
      <FormField id="name" name="name" label="Full name" required={true} autocomplete="name" />
      <FormField id="phone" name="phone" label="Phone" type="tel" required={true} autocomplete="tel" inputmode="tel" placeholder="e.g. 9123 4567" />
      <FormField id="email" name="email" label="Email" type="email" required={true} autocomplete="email" inputmode="email" />
    </div>
    <p class="booking__suggest" data-email-suggest role="status" hidden></p>

    <div class="field booking__condition-field">
      <p class="field__label" id="notes-label">Tell us about your condition (optional)</p>
      <textarea
        id="notes"
        name="notes"
        class="field__control booking__notes"
        rows="3"
        aria-labelledby="notes-label"
        placeholder="Describe your symptoms, injury, history or any relevant information that will help us prepare for your session."
      ></textarea>
    </div>

    <div class="booking__summary" data-summary></div>
    <p class="booking__changes-note">
      Need to change or cancel later? Message us on
      <a href={cta("web-wa")} target="_blank" rel="noopener">WhatsApp</a>. That's
      where we handle all appointment changes and cancellations.
    </p>
    <p class="booking__error" data-error="submit" role="alert" hidden></p>

    <div class="booking__nav">
      <button type="button" class="bbtn bbtn--ghost" data-nav="back">Back</button>
      <button type="submit" class="bbtn bbtn--primary" data-submit>Confirm booking</button>
    </div>
  </fieldset>

  {/* ---------- Confirmation ---------- */}
  <div class="booking__done" data-step="done" hidden>
    <div class="booking__done-sprig">
      <BloomFlipbook size="132px" aria-label="A goji berry, ripe" />
    </div>
    <h2>Booking request received</h2>
    <p class="booking__done-lead" data-done-lead></p>
    <p class="booking__hint">
      A confirmation is on its way to your email. To change or cancel this
      appointment, message us on WhatsApp. That's where we handle all changes
      and cancellations.
    </p>
    <div class="booking__done-cta">
      <Button slug="web-wa" variant="whatsapp" size="lg">Message us on WhatsApp</Button>
    </div>
  </div>
</form>

<style>
  .booking {
    border: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Progress — a connected 1 -> 2 -> 3 guided stepper. */
  .booking__progress {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
  }
  .booking__pstep {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    position: relative;
    text-align: center;
  }
  /* Connector line running from the previous step's number into this one. */
  .booking__pstep:not(:first-child)::before {
    content: "";
    position: absolute;
    top: 0.9rem;
    right: 50%;
    left: -50%;
    height: 2px;
    background: var(--color-border-strong);
    z-index: 0;
    transition: background-color var(--dur) var(--ease);
  }
  .booking__pnum {
    position: relative;
    z-index: 1;
    width: 1.8rem;
    height: 1.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1.5px solid var(--color-border-strong);
    background: var(--bg-content);
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    transition: background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .booking__plabel {
    font-size: var(--fs-small);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease);
  }
  /* Completed steps: filled number + filled connector coming into them. */
  .booking__pstep[data-done] .booking__pnum {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-linen);
  }
  .booking__pstep[data-done]::before,
  .booking__pstep[data-active]::before {
    background: var(--color-primary);
  }
  /* Current step: outlined-but-emphasised number + dark label. */
  .booking__pstep[data-active] .booking__pnum {
    border-color: var(--color-primary);
    color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 14%, transparent);
  }
  .booking__pstep[data-active] .booking__plabel {
    color: var(--text-default);
    font-weight: var(--weight-semibold);
  }
  .booking__pstep[data-done] .booking__plabel {
    color: var(--text-default);
  }

  /* Steps */
  .booking__step {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6); /* generous — each block (label + control) reads as its own group */
  }
  /* [hidden] must win over the display above (class beats the UA [hidden] rule). */
  .booking__step[hidden],
  .booking__done[hidden] {
    display: none;
  }
  .booking__legend {
    padding: 0;
    width: 100%;
    /* A <legend> is not a flex item, so the step's gap never applies after
       it — this margin is the only space under the heading. */
    margin-bottom: var(--space-4);
  }
  .booking__legend h2 {
    font-size: var(--fs-h2);
  }

  .booking__services {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Step-2 recap of the step-1 choice ("Physiotherapy · In-clinic"). First
     flex item after the (non-flex) legend, so it sits at the legend's own
     margin — right under the heading it annotates. */
  .booking__recap {
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
  }
  .booking__recap[hidden] {
    display: none;
  }

  /* The step's single WhatsApp escape hatch (same-day/urgent + can't-find-a-
     time), spaced clear of the times grid above it. */
  .booking__wa-note {
    margin-top: var(--space-4);
    max-width: 46ch;
  }
  .booking__wa-note a {
    font-weight: var(--weight-semibold);
  }

  .booking__sublabel {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
    margin-bottom: var(--space-3);
  }
  .booking__hint {
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: 52ch; /* readable measure — don't run wall to wall on desktop */
  }
  .booking__error {
    font-size: var(--fs-small);
    color: var(--color-primary);
  }

  /* In-clinic / Home toggle */
  .booking__toggle {
    display: inline-flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .pill__face {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--bg-content);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .pill:has(.pill__input:checked) .pill__face {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-linen);
  }
  .pill:has(.pill__input:focus-visible) .pill__face {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .pill[hidden] {
    display: none;
  }
  .booking__address {
    margin-top: var(--space-4);
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  /* The base display:flex above outranks the UA [hidden] rule, so an in-clinic
     booking would still show the address block (and its surcharge note). Re-hide
     it explicitly, mirroring .booking__step[hidden]. */
  .booking__address[hidden] {
    display: none;
  }
  /* Home-visit travel-surcharge note: full-width box with symmetric padding so
     the text never sits with stray gaps on either side. */
  .booking__disclaimer {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--color-linen);
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    color: var(--text-default);
    line-height: var(--lh-body);
  }

  .booking__condition-field {
    gap: var(--space-3);
  }
  .booking__notes {
    margin-top: var(--space-1);
  }

  .booking__addr-grid {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 520px) {
    .booking__addr-grid {
      grid-template-columns: 1fr 1fr;
    }
    /* Street name spans full width; block+postal share the first row. */
    .booking__addr-grid > :global(.field:nth-child(3)) {
      grid-column: 1 / -1;
    }
  }

  /* Inline month calendar (replaces the native date input) */
  .cal {
    max-width: 22rem;
    padding: var(--space-4);
    background: var(--bg-content);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .cal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .cal__title {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
  }
  .cal__nav {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--bg-content);
    font-size: 1.1rem;
    line-height: 1;
    color: var(--text-default);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .cal__nav:hover:not([disabled]) {
    border-color: var(--color-border-strong);
  }
  .cal__nav[disabled] {
    opacity: 0.35;
    cursor: default;
  }
  .cal__nav:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .cal__dow {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--space-1);
    margin-bottom: var(--space-1);
  }
  .cal__dow span {
    text-align: center;
    font-size: var(--fs-caption);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    padding-block: var(--space-1);
  }
  .cal__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--space-1);
  }
  /* Day cells and time slots are created at runtime (in <script>), so Astro's
     scoped attribute never lands on them. Constrain to the .booking ancestor
     (scoped) but mark the runtime descendants :global so the rules apply. */
  .booking :global(.cal__day) {
    aspect-ratio: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: var(--weight-medium);
    color: var(--text-default);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .booking :global(.cal__day:hover:not([disabled]):not([aria-pressed="true"])) {
    border-color: var(--color-border-strong);
  }
  .booking :global(.cal__day[disabled]) {
    color: color-mix(in srgb, var(--text-muted) 45%, transparent);
    cursor: default;
  }
  .booking :global(.cal__day[aria-pressed="true"]) {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-linen);
    font-weight: var(--weight-semibold);
  }
  .booking :global(.cal__day:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .booking :global(.cal__pad) {
    aspect-ratio: 1 / 1;
  }

  /* Available times — grouped Morning / Afternoon slot grid */
  .booking__slotlist {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .booking :global(.slots__gtitle) {
    font-size: var(--fs-caption);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .booking :global(.slots__grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.25rem, 1fr));
    gap: var(--space-2);
  }
  .booking :global(.slot) {
    padding: 0.7rem 0.5rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--bg-content);
    font-family: var(--font-body);
