---
/**
 * BookingForm — a 3-step, mobile-first booking flow (Service & format ->
 * When & who -> Your details) that ends in an on-page confirmation.
 *
 * Phase 1: driven by the `bookingApi` MOCK (src/lib/booking.ts) — availability
 * and submission are simulated. Phase 2 swaps that module for real Plato calls;
 * this component does not change.
 */
import FormField from "./FormField.astro";
import ServiceOption from "./ServiceOption.astro";
import Button from "../Button.astro";
import BloomFlipbook from "../BloomFlipbook.astro";
import { services } from "../../lib/services";
import { clinicians } from "../../lib/clinicians";
import { cta } from "../../lib/links";

const steps = [
  { n: 1, label: "Service" },
  { n: 2, label: "Time" },
  { n: 3, label: "Details" },
];
---

<form class="booking" id="booking-form" novalidate>
  <ol class="booking__progress" aria-label="Booking steps">
    {
      steps.map((s) => (
        <li class="booking__pstep" data-progress={String(s.n)}>
          <span class="booking__pnum" aria-hidden="true">{s.n}</span>
          <span class="booking__plabel">{s.label}</span>
        </li>
      ))
    }
  </ol>

  {/* ---------- Step 1: Service & format ---------- */}
  <fieldset class="booking__step" data-step="1">
    <legend class="booking__legend">
      <h2>What would you like to book?</h2>
    </legend>

    <div class="booking__services" role="radiogroup" aria-label="Service">
      {services.map((s) => <ServiceOption service={s} />)}
    </div>
    <p class="booking__error" data-error="service" role="alert" hidden></p>

    <div class="booking__where" data-where hidden>
      <p class="booking__sublabel">Where would you like to be seen?</p>
      <div class="booking__toggle" role="radiogroup" aria-label="Location">
        <label class="pill">
          <input class="pill__input visually-hidden" type="radio" name="format" value="clinic" checked />
          <span class="pill__face">In-clinic</span>
        </label>
        <label class="pill" data-home-label>
          <input class="pill__input visually-hidden" type="radio" name="format" value="home" />
          <span class="pill__face">Home visit</span>
        </label>
      </div>
      <p class="booking__hint" data-home-hint hidden>
        This service is offered in-clinic only.
      </p>

      <div class="booking__address" data-address hidden>
        <p class="booking__disclaimer">
          Home visits include a $70 travel surcharge on top of the session fee.
        </p>
        <div class="booking__addr-grid">
          <FormField id="addr-block" name="addr-block" label="Block / house number" required={true} autocomplete="address-line1" placeholder="e.g. 123B" />
          <FormField id="addr-postal" name="addr-postal" label="Postal code" required={true} inputmode="numeric" autocomplete="postal-code" placeholder="6 digits" />
          <FormField id="addr-street" name="addr-street" label="Street name" required={true} autocomplete="address-line2" placeholder="e.g. Lentor Central" />
          <FormField id="addr-building" name="addr-building" label="Building name (optional)" placeholder="e.g. Lentor Modern" />
          <FormField id="addr-unit" name="addr-unit" label="Unit number (optional)" placeholder="e.g. #12-34" />
        </div>
        <FormField
          id="addr-notes"
          name="addr-notes"
          label="Directions, access & parking (optional)"
          textarea={true}
          placeholder="Landmarks, gate or lift access, and where to park when you arrive"
        />
      </div>
    </div>

    <div class="booking__nav">
      <button type="button" class="bbtn bbtn--primary" data-nav="next">
        Continue <span class="bbtn__arrow" aria-hidden="true">&rarr;</span>
      </button>
    </div>
  </fieldset>

  {/* ---------- Step 2: When & who ---------- */}
  <fieldset class="booking__step" data-step="2" hidden>
    <legend class="booking__legend">
      <h2>When works for you?</h2>
    </legend>

    <div class="booking__clinician">
      <p class="booking__sublabel">Preferred clinician (optional)</p>
      <p class="booking__hint">Choose who you'd like to see first — availability updates to match. Not sure? Leave it on "First available" and we'll match you.</p>
      <div class="booking__clinicians" role="radiogroup" aria-label="Preferred clinician">
        <label class="copt" data-clinician-opt>
          <input class="copt__input visually-hidden" type="radio" name="clinician" value="" checked />
          <span class="copt__name">First available</span>
          <span class="copt__role">Recommended · we'll match you</span>
          <span class="copt__tick" aria-hidden="true"></span>
        </label>
        {
          clinicians.map((c) => (
            <label class="copt" data-clinician-opt data-services={c.services.join(" ")} hidden>
              <input class="copt__input visually-hidden" type="radio" name="clinician" value={c.id} />
              <span class="copt__name">{c.name}</span>
              <span class="copt__role">{c.role}</span>
              <span class="copt__tick" aria-hidden="true" />
            </label>
          ))
        }
      </div>
    </div>

    <div class="booking__datewrap">
      <p class="booking__sublabel" id="date-label">
        Preferred date <span class="field__req" aria-hidden="true">*</span>
      </p>
      <input type="hidden" id="date" name="date" />
      <div class="cal" data-cal aria-labelledby="date-label">
        <div class="cal__head">
          <button type="button" class="cal__nav" data-cal-prev aria-label="Previous month">
            <span aria-hidden="true">&lsaquo;</span>
          </button>
          <span class="cal__title" data-cal-title aria-live="polite"></span>
          <button type="button" class="cal__nav" data-cal-next aria-label="Next month">
            <span aria-hidden="true">&rsaquo;</span>
          </button>
        </div>
        <div class="cal__dow" aria-hidden="true">
          <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span>
          <span>Fri</span><span>Sat</span><span>Sun</span>
        </div>
        <div class="cal__grid" data-cal-grid role="grid"></div>
      </div>
      <p class="field__error" id="date-error" role="alert" hidden></p>
    </div>

    <div class="booking__slots">
      <p class="booking__sublabel">Available times</p>
      <div class="booking__slotlist" data-slots></div>
      <p class="booking__hint" data-slots-msg>Pick a date to see available times.</p>
      <p class="booking__error" data-error="time" role="alert" hidden></p>
    </div>

    <div class="booking__nav">
      <button type="button" class="bbtn bbtn--ghost" data-nav="back">Back</button>
      <button type="button" class="bbtn bbtn--primary" data-nav="next">
        Continue <span class="bbtn__arrow" aria-hidden="true">&rarr;</span>
      </button>
    </div>
  </fieldset>

  {/* ---------- Step 3: Your details ---------- */}
  <fieldset class="booking__step" data-step="3" hidden>
    <legend class="booking__legend">
      <h2>Your details</h2>
    </legend>

    <div class="booking__grid">
      <FormField id="name" name="name" label="Full name" required={true} autocomplete="name" />
      <FormField id="phone" name="phone" label="Phone" type="tel" required={true} autocomplete="tel" inputmode="tel" />
      <FormField id="email" name="email" label="Email" type="email" required={true} autocomplete="email" inputmode="email" />
    </div>

    <div class="field booking__condition-field">
      <p class="field__label" id="notes-label">Tell us about your condition (optional)</p>
      <div class="booking__conditions" role="group" aria-labelledby="notes-label" data-conditions>
        {
          ["Prenatal", "Postpartum", "Injury", "Pain", "Scoliosis", "Paediatrics", "Others"].map((c) => (
            <button type="button" class="ccond" data-condition={c} aria-pressed="false">
              {c}
            </button>
          ))
        }
      </div>
      <textarea
        id="notes"
        name="notes"
        class="field__control booking__notes"
        rows="2"
        aria-describedby="notes-label"
        placeholder="Add anything else that helps us prepare — symptoms, injury, or goals (optional)."
      ></textarea>
    </div>

    <div class="booking__summary" data-summary></div>
    <p class="booking__changes-note">
      Need to change or cancel later? Message us on
      <a href={cta("web-wa")} target="_blank" rel="noopener">WhatsApp</a>. That's
      where we handle all appointment changes and cancellations.
    </p>
    <p class="booking__error" data-error="submit" role="alert" hidden></p>

    <div class="booking__nav">
      <button type="button" class="bbtn bbtn--ghost" data-nav="back">Back</button>
      <button type="submit" class="bbtn bbtn--primary" data-submit>Confirm booking</button>
    </div>
  </fieldset>

  {/* ---------- Confirmation ---------- */}
  <div class="booking__done" data-step="done" hidden>
    <div class="booking__done-sprig">
      <BloomFlipbook size="132px" aria-label="A goji berry, ripe" />
    </div>
    <h2>Booking request received</h2>
    <p class="booking__done-lead" data-done-lead></p>
    <p class="booking__hint">
      A confirmation is on its way to your email. To change or cancel this
      appointment, message us on WhatsApp. That's where we handle all changes
      and cancellations.
    </p>
    <div class="booking__done-cta">
      <Button slug="web-wa" variant="whatsapp" size="lg">Message us on WhatsApp</Button>
    </div>
  </div>
</form>

<style>
  .booking {
    border: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Progress — a connected 1 -> 2 -> 3 guided stepper. */
  .booking__progress {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
  }
  .booking__pstep {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    position: relative;
    text-align: center;
  }
  /* Connector line running from the previous step's number into this one. */
  .booking__pstep:not(:first-child)::before {
    content: "";
    position: absolute;
    top: 0.9rem;
    right: 50%;
    left: -50%;
    height: 2px;
    background: var(--color-border-strong);
    z-index: 0;
    transition: background-color var(--dur) var(--ease);
  }
  .booking__pnum {
    position: relative;
    z-index: 1;
    width: 1.8rem;
    height: 1.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1.5px solid var(--color-border-strong);
    background: var(--bg-content);
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    transition: background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .booking__plabel {
    font-size: var(--fs-small);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease);
  }
  /* Completed steps: filled number + filled connector coming into them. */
  .booking__pstep[data-done] .booking__pnum {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-linen);
  }
  .booking__pstep[data-done]::before,
  .booking__pstep[data-active]::before {
    background: var(--color-primary);
  }
  /* Current step: outlined-but-emphasised number + dark label. */
  .booking__pstep[data-active] .booking__pnum {
    border-color: var(--color-primary);
    color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 14%, transparent);
  }
  .booking__pstep[data-active] .booking__plabel {
    color: var(--text-default);
    font-weight: var(--weight-semibold);
  }
  .booking__pstep[data-done] .booking__plabel {
    color: var(--text-default);
  }

  /* Steps */
  .booking__step {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  /* [hidden] must win over the display above (class beats the UA [hidden] rule). */
  .booking__step[hidden],
  .booking__done[hidden] {
    display: none;
  }
  .booking__legend {
    padding: 0;
    width: 100%;
    margin-bottom: var(--space-3);
  }
  .booking__legend h2 {
    font-size: var(--fs-h2);
  }

  .booking__services {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .booking__sublabel {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
    margin-bottom: var(--space-2);
  }
  .booking__hint {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .booking__error {
    font-size: var(--fs-small);
    color: var(--color-primary);
  }

  /* In-clinic / Home toggle */
  .booking__toggle {
    display: inline-flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .pill__face {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--bg-content);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .pill:has(.pill__input:checked) .pill__face {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-linen);
  }
  .pill:has(.pill__input:focus-visible) .pill__face {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .pill[hidden] {
    display: none;
  }
  .booking__address {
    margin-top: var(--space-4);
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  /* The base display:flex above outranks the UA [hidden] rule, so an in-clinic
     booking would still show the address block (and its surcharge note). Re-hide
     it explicitly, mirroring .booking__step[hidden]. */
  .booking__address[hidden] {
    display: none;
  }
  /* Home-visit travel-surcharge note: full-width box with symmetric padding so
     the text never sits with stray gaps on either side. */
  .booking__disclaimer {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--color-linen);
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    color: var(--text-default);
    line-height: var(--lh-body);
  }

  /* Quick-select condition chips above the free-text notes box. */
  .booking__condition-field {
    gap: var(--space-3);
  }
  .booking__conditions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .ccond {
    padding: 0.4rem 0.85rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--bg-content);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .ccond:hover {
    border-color: var(--color-border-strong);
  }
  .ccond[aria-pressed="true"] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-linen);
  }
  .ccond:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .booking__notes {
    margin-top: var(--space-1);
  }

  .booking__addr-grid {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 520px) {
    .booking__addr-grid {
      grid-template-columns: 1fr 1fr;
    }
    /* Street name spans full width; block+postal share the first row. */
    .booking__addr-grid > :global(.field:nth-child(3)) {
      grid-column: 1 / -1;
    }
  }

  /* Inline month calendar (replaces the native date input) */
  .cal {
    max-width: 22rem;
    padding: var(--space-4);
    background: var(--bg-content);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .cal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .cal__title {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
  }
  .cal__nav {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--bg-content);
    font-size: 1.1rem;
    line-height: 1;
    color: var(--text-default);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .cal__nav:hover:not([disabled]) {
    border-color: var(--color-border-strong);
  }
  .cal__nav[disabled] {
    opacity: 0.35;
    cursor: default;
  }
  .cal__nav:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .cal__dow {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--space-1);
    margin-bottom: var(--space-1);
  }
  .cal__dow span {
    text-align: center;
    font-size: var(--fs-caption);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    padding-block: var(--space-1);
  }
  .cal__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--space-1);
  }
  /* Day cells and time slots are created at runtime (in <script>), so Astro's
     scoped attribute never lands on them. Constrain to the .booking ancestor
     (scoped) but mark the runtime descendants :global so the rules apply. */
  .booking :global(.cal__day) {
    aspect-ratio: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: var(--weight-medium);
    color: var(--text-default);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .booking :global(.cal__day:hover:not([disabled]):not([aria-pressed="true"])) {
    border-color: var(--color-border-strong);
  }
  .booking :global(.cal__day[disabled]) {
    color: color-mix(in srgb, var(--text-muted) 45%, transparent);
    cursor: default;
  }
  .booking :global(.cal__day[aria-pressed="true"]) {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-linen);
    font-weight: var(--weight-semibold);
  }
  .booking :global(.cal__day:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .booking :global(.cal__pad) {
    aspect-ratio: 1 / 1;
  }

  /* Available times — grouped Morning / Afternoon slot grid */
  .booking__slotlist {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .booking :global(.slots__gtitle) {
    font-size: var(--fs-caption);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .booking :global(.slots__grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.25rem, 1fr));
    gap: var(--space-2);
  }
  .booking :global(.slot) {
    padding: 0.7rem 0.5rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--bg-content);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
    text-align: center;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease), color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .booking :global(.slot:hover:not([aria-pressed="true"])) {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-sm);
  }
  .booking :global(.slot[aria-pressed="true"]) {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-linen);
  }
  .booking :global(.slot:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Clinician options */
  .booking__clinicians {
    display: grid;
    gap: var(--space-2);
  }
  @media (min-width: 560px) {
    .booking__clinicians {
      grid-template-columns: 1fr 1fr;
    }
  }
  .copt {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.15rem var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--bg-content);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .copt[hidden] {
    display: none;
  }
  .copt:hover {
    border-color: var(--color-border-strong);
  }
  .copt:has(.copt__input:checked) {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }
  .copt:has(.copt__input:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .copt__name {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
  }
  .copt__role {
    grid-column: 1;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .copt__tick {
    grid-row: 1 / span 2;
    grid-column: 2;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-border-strong);
    position: relative;
  }
  .copt:has(.copt__input:checked) .copt__tick {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .copt:has(.copt__input:checked) .copt__tick::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0.34rem;
    height: 0.55rem;
    border: solid var(--color-linen);
    border-width: 0 2px 2px 0;
    transform: translateY(-1px) rotate(45deg);
  }

  /* Details grid */
  .booking__grid {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 560px) {
    .booking__grid {
      grid-template-columns: 1fr 1fr;
    }
    .booking__grid > :global(.field:first-child) {
      grid-column: 1 / -1;
    }
  }

  /* Summary card */
  .booking__summary {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    background: var(--color-linen);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--fs-small);
  }
  .booking__summary :global(.booking__srow) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .booking__summary :global(.booking__skey) {
    color: var(--text-muted);
  }
  .booking__summary :global(.booking__sval) {
    color: var(--text-default);
    font-weight: var(--weight-semibold);
    text-align: right;
  }
  .booking__changes-note {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .booking__changes-note a {
    font-weight: var(--weight-semibold);
  }

  /* Nav + local buttons (native <button>, mirrors .btn tokens) */
  .booking__nav {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin-top: var(--space-2);
  }
  .bbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    font-size: var(--fs-body);
    line-height: 1;
    padding: 0.9rem 1.65rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: background-color var(--dur) var(--ease),
      color var(--dur) var(--ease), border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .bbtn:hover {
    transform: translateY(-1px);
  }
  .bbtn__arrow {
    margin-left: 0.15em;
    display: inline-block;
    transition: transform var(--dur) var(--ease);
  }
  .bbtn:hover .bbtn__arrow {
    transform: translateX(2px);
  }
  .bbtn--primary {
    background: var(--cta-bg);
    color: var(--cta-text);
    margin-left: auto;
  }
  .bbtn--primary:hover {
    background: var(--cta-bg-hover);
  }
  .bbtn--primary[disabled] {
    opacity: 0.6;
    cursor: progress;
    transform: none;
  }
  .bbtn--ghost {
    background: transparent;
    color: var(--color-primary);
    padding-inline: 0.5rem;
  }
  .bbtn--ghost:hover {
    color: var(--color-primary-deep);
  }

  /* Confirmation */
  .booking__done {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }
  .booking__done-sprig {
    margin-bottom: calc(-1 * var(--space-2));
  }
  .booking__done-lead {
    max-width: 40ch;
    color: var(--text-muted);
  }
  .booking__done-cta {
    margin-top: var(--space-2);
  }
</style>

<script>
  import { services, serviceById } from "../../lib/services";
  import { cliniciansForService } from "../../lib/clinicians";
  import { bookingApi, type BookingDraft } from "../../lib/booking";

  const form = document.getElementById("booking-form") as HTMLFormElement | null;
  if (form) init(form);

  function init(form: HTMLFormElement) {
    const stepEls = Array.from(
      form.querySelectorAll<HTMLElement>("[data-step]"),
    );
    const progressItems = Array.from(
      form.querySelectorAll<HTMLElement>("[data-progress]"),
    );
    const getStep = (n: number | string) =>
      stepEls.find((el) => el.dataset.step === String(n)) ?? null;

    let current = 1;
    let selectedTime = "";
    let lastAvailKey = "";

    const draft = (): BookingDraft => ({
      service: (getChecked("service") as BookingDraft["service"]) ?? null,
      format: (getChecked("format") as BookingDraft["format"]) || "clinic",
      address: composeAddress(),
      date: getValue("date"),
      time: selectedTime,
      clinicianId: getChecked("clinician") ?? "",
      name: getValue("name"),
      phone: getValue("phone"),
      email: getValue("email"),
      notes: composeNotes(),
    });

    /** Combine the quick-select condition chips with any free-text detail. */
    function composeNotes(): string {
      const tags = Array.from(
        form!.querySelectorAll<HTMLElement>('[data-condition][aria-pressed="true"]'),
      ).map((b) => b.dataset.condition || "");
      const extra = getValue("notes");
      return [tags.join(", "), extra].filter(Boolean).join(" — ");
    }

    function getChecked(name: string): string | null {
      const el = form!.querySelector<HTMLInputElement>(
        `input[name="${name}"]:checked`,
      );
      return el ? el.value : null;
    }
    function getValue(id: string): string {
      const el = document.getElementById(id) as
        | HTMLInputElement
        | HTMLTextAreaElement
        | null;
      return el ? el.value.trim() : "";
    }
    /** Build one formatted Singapore address string from the structured fields. */
    function composeAddress(): string {
      const block = getValue("addr-block");
      const street = getValue("addr-street");
      const building = getValue("addr-building");
      const unit = getValue("addr-unit");
      const postal = getValue("addr-postal");
      const notes = getValue("addr-notes");
      const parts: string[] = [];
      const line1 = [block, street].filter(Boolean).join(" ");
      if (line1) parts.push(line1);
      if (building) parts.push(building);
      if (unit) parts.push(unit);
      if (postal) parts.push(`Singapore ${postal}`);
      let addr = parts.join(", ");
      if (notes) addr += `${addr ? "; " : ""}Access: ${notes}`;
      return addr;
    }
    function setError(key: string, msg: string) {
      const p = form!.querySelector<HTMLElement>(`[data-error="${key}"]`);
      if (!p) return;
      p.textContent = msg;
      p.hidden = !msg;
    }
    function setFieldError(id: string, msg: string) {
      const control = document.getElementById(id);
      const field = control?.closest<HTMLElement>(".field");
      const err = document.getElementById(`${id}-error`);
      if (field) field.toggleAttribute("data-invalid", !!msg);
      if (err) {
        err.textContent = msg;
        err.hidden = !msg;
      }
    }

    // ----- Step 1: service + format wiring -----
    const whereBlock = form.querySelector<HTMLElement>("[data-where]");
    const homeLabel = form.querySelector<HTMLElement>("[data-home-label]");
    const homeHint = form.querySelector<HTMLElement>("[data-home-hint]");
    const addressBlock = form.querySelector<HTMLElement>("[data-address]");

    // Show + require the address fields ONLY for a home visit; an in-clinic
    // booking never asks for an address. The travel-surcharge note lives inside
    // the address block, so it appears the moment "Home visit" is chosen.
    function syncAddress() {
      const home = getChecked("format") === "home";
      if (addressBlock) addressBlock.hidden = !home;
      ["addr-block", "addr-street", "addr-postal"].forEach((id) => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (el) el.required = home;
      });
    }

    form.querySelectorAll<HTMLInputElement>('input[name="service"]').forEach(
      (input) => {
        input.addEventListener("change", onServiceChange);
      },
    );
    form.querySelectorAll<HTMLInputElement>('input[name="format"]').forEach(
      (input) => {
        input.addEventListener("change", syncAddress);
      },
    );

    function onServiceChange() {
      setError("service", "");
      const svc = serviceById(getChecked("service") ?? "");
      if (!svc) return;
      if (whereBlock) whereBlock.hidden = false;

      // Home-visit availability depends on the service.
      if (homeLabel && homeHint) {
        const homeInput = homeLabel.querySelector<HTMLInputElement>(
          'input[name="format"]',
        );
        if (svc.supportsHome) {
          homeLabel.hidden = false;
          homeHint.hidden = true;
        } else {
          homeLabel.hidden = true;
          homeHint.hidden = false;
          if (homeInput?.checked) {
            const clinic = form!.querySelector<HTMLInputElement>(
              'input[name="format"][value="clinic"]',
            );
            if (clinic) clinic.checked = true;
          }
        }
      }
      syncAddress();

      // Filter the clinician options to those who offer this service.
      const eligible = new Set(
        cliniciansForService(svc.id).map((c) => c.id),
      );
      form!
        .querySelectorAll<HTMLElement>("[data-clinician-opt]")
        .forEach((opt) => {
          const val = opt.querySelector<HTMLInputElement>("input")?.value ?? "";
          if (val === "") {
            opt.hidden = false;
            return;
          }
          const ok = eligible.has(val);
          opt.hidden = !ok;
          if (!ok) {
            const input = opt.querySelector<HTMLInputElement>("input");
            if (input?.checked) {
              input.checked = false;
              const firstAvail = form!.querySelector<HTMLInputElement>(
                'input[name="clinician"][value=""]',
              );
              if (firstAvail) firstAvail.checked = true;
            }
          }
        });

      // Service changed -> availability is stale.
      selectedTime = "";
      lastAvailKey = "";
    }

    // ----- Step 2: date (inline calendar) + slots -----
    const dateInput = document.getElementById("date") as HTMLInputElement | null;
    const chips = form.querySelector<HTMLElement>("[data-slots]");
    const slotsMsg = form.querySelector<HTMLElement>("[data-slots-msg]");

    initCalendar();

    form.querySelectorAll<HTMLInputElement>('input[name="clinician"]').forEach(
      (input) => input.addEventListener("change", refreshSlots),
    );

    /**
     * Inline month calendar — the primary date picker (no click-to-open icon).
     * Writes YYYY-MM-DD into the hidden #date input, then refreshes slots.
     * Bounded to [tomorrow, +60 days]; Sundays (clinic closed) are disabled.
     */
    function initCalendar() {
      const grid = form!.querySelector<HTMLElement>("[data-cal-grid]");
      const title = form!.querySelector<HTMLElement>("[data-cal-title]");
      const prev = form!.querySelector<HTMLButtonElement>("[data-cal-prev]");
      const next = form!.querySelector<HTMLButtonElement>("[data-cal-next]");
      if (!grid || !title || !prev || !next || !dateInput) return;

      const startOfDay = (d: Date) => {
        const x = new Date(d);
        x.setHours(0, 0, 0, 0);
        return x;
      };
      const today = startOfDay(new Date());
      const minDate = new Date(today);
      minDate.setDate(minDate.getDate() + 1); // 1 day in advance (no same-day)
      const maxDate = new Date(today);
      maxDate.setDate(maxDate.getDate() + 60); // bookings capped 60 days out
      const ymd = (d: Date) =>
        `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
      const sameMonth = (a: Date, b: Date) =>
        a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth();

      let view = new Date(minDate.getFullYear(), minDate.getMonth(), 1);

      function render() {
        title!.textContent = view.toLocaleDateString("en-SG", {
          month: "long",
          year: "numeric",
        });
        prev!.disabled = sameMonth(view, minDate);
        next!.disabled = sameMonth(view, maxDate);
        grid!.innerHTML = "";
        const y = view.getFullYear();
        const m = view.getMonth();
        const offset = (new Date(y, m, 1).getDay() + 6) % 7; // Mon=0 .. Sun=6
        for (let i = 0; i < offset; i++) {
          const pad = document.createElement("span");
          pad.className = "cal__pad";
          grid!.appendChild(pad);
        }
        const days = new Date(y, m + 1, 0).getDate();
        for (let d = 1; d <= days; d++) {
          const date = new Date(y, m, d);
          const value = ymd(date);
          const disabled =
            date < minDate || date > maxDate || date.getDay() === 0; // Sun closed
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "cal__day";
          btn.textContent = String(d);
          btn.disabled = disabled;
          btn.setAttribute("aria-pressed", String(value === dateInput!.value));
          if (!disabled) {
            btn.addEventListener("click", () => {
              dateInput!.value = value;
              selectedTime = "";
              setFieldError("date", "");
              render();
              refreshSlots();
            });
          }
          grid!.appendChild(btn);
        }
      }

      prev.addEventListener("click", () => {
        view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
        render();
      });
      next.addEventListener("click", () => {
        view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
        render();
      });
      render();
    }

    function fmtTime(t: string): string {
      const [h, m] = t.split(":").map(Number);
      const ap = h < 12 ? "am" : "pm";
      const h12 = h % 12 === 0 ? 12 : h % 12;
      return `${h12}:${String(m).padStart(2, "0")} ${ap}`;
    }

    async function refreshSlots() {
      if (!chips || !slotsMsg) return;
      const d = draft();
      if (!d.service || !d.date) {
        chips.innerHTML = "";
        slotsMsg.hidden = false;
        slotsMsg.textContent = "Pick a date to see available times.";
        return;
      }
      const key = `${d.service}|${d.clinicianId}|${d.date}|${d.format}`;
      lastAvailKey = key;
      chips.innerHTML = "";
      slotsMsg.hidden = false;
      slotsMsg.textContent = "Finding available times…";
      const times = await bookingApi.getAvailability({
        service: d.service,
        clinicianId: d.clinicianId,
        date: d.date,
        home: d.format === "home",
      });
      if (key !== lastAvailKey) return; // a newer request superseded this one
      if (!times.length) {
        slotsMsg.hidden = false;
        slotsMsg.textContent =
          "No times available on this date. Please try another day.";
        selectedTime = "";
        return;
      }
      slotsMsg.hidden = true;
      const onPick = (t: string) => {
        selectedTime = t;
        setError("time", "");
        chips!
          .querySelectorAll<HTMLElement>(".slot")
          .forEach((c) =>
            c.setAttribute("aria-pressed", String(c.dataset.time === selectedTime)),
          );
      };
      const groups: { title: string; times: string[] }[] = [
        { title: "Morning", times: times.filter((t) => Number(t.slice(0, 2)) < 12) },
        { title: "Afternoon", times: times.filter((t) => Number(t.slice(0, 2)) >= 12) },
      ];
      groups.forEach((g) => {
        if (!g.times.length) return;
        const wrap = document.createElement("div");
        wrap.className = "slots__group";
        const h = document.createElement("p");
        h.className = "slots__gtitle";
        h.textContent = g.title;
        const gr = document.createElement("div");
        gr.className = "slots__grid";
        g.times.forEach((t) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "slot";
          btn.dataset.time = t;
          btn.textContent = fmtTime(t);
          btn.setAttribute("aria-pressed", String(t === selectedTime));
          btn.addEventListener("click", () => onPick(t));
          gr.appendChild(btn);
        });
        wrap.appendChild(h);
        wrap.appendChild(gr);
        chips!.appendChild(wrap);
      });
    }

    // ----- Step 3: fire the "details" funnel event once, when the user first
    // engages the details form. This is distinct from merely reaching the step
    // (implied by "time_selected"), so the dashboard can see who lands on the
    // details step but never starts filling it in. -----
    let detailsTracked = false;
    function markDetailsEngaged() {
      if (detailsTracked) return;
      detailsTracked = true;
      bookingApi.track("details");
    }
    ["name", "phone", "email", "notes"].forEach((id) => {
      document.getElementById(id)?.addEventListener("input", markDetailsEngaged);
    });

    // Quick-select condition chips: toggle aria-pressed; the chosen ones are
    // folded into the notes by composeNotes(). A tap also counts as engaging the
    // details step for the funnel.
    form.querySelectorAll<HTMLButtonElement>("[data-condition]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const on = btn.getAttribute("aria-pressed") === "true";
        btn.setAttribute("aria-pressed", String(!on));
        markDetailsEngaged();
      });
    });

    // ----- Validation per step -----
    function validate(step: number): boolean {
      const d = draft();
      if (step === 1) {
        if (!d.service) {
          setError("service", "Please choose a service to continue.");
          return false;
        }
        if (d.format === "home") {
          let ok = true;
          setFieldError("addr-block", getValue("addr-block") ? "" : "Required");
          setFieldError("addr-street", getValue("addr-street") ? "" : "Required");
          if (!getValue("addr-block")) ok = false;
          if (!getValue("addr-street")) ok = false;
          if (!/^\d{6}$/.test(getValue("addr-postal"))) {
            setFieldError("addr-postal", "Enter a 6-digit postal code.");
            ok = false;
          } else {
            setFieldError("addr-postal", "");
          }
          return ok;
        }
        return true;
      }
      if (step === 2) {
        let ok = true;
        if (!d.date) {
          setFieldError("date", "Please choose a preferred date.");
          ok = false;
        }
        if (!d.time) {
          setError("time", "Please pick an available time.");
          ok = false;
        }
        return ok;
      }
      if (step === 3) {
        let ok = true;
        if (!d.name) {
          setFieldError("name", "Please enter your name.");
          ok = false;
        }
        if (!/^[+\d][\d\s()-]{6,}$/.test(d.phone)) {
          setFieldError("phone", "Please enter a valid phone number.");
          ok = false;
        }
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(d.email)) {
          setFieldError("email", "Please enter a valid email.");
          ok = false;
        }
        return ok;
      }
      return true;
    }

    // ----- Summary (step 3) -----
    function buildSummary() {
      const box = form!.querySelector<HTMLElement>("[data-summary]");
      if (!box) return;
      const d = draft();
      const svc = serviceById(d.service ?? "");
      const clinician =
        d.clinicianId === ""
          ? "First available"
          : form!
              .querySelector(
                `input[name="clinician"][value="${d.clinicianId}"]`,
              )
              ?.closest(".copt")
              ?.querySelector(".copt__name")?.textContent || "First available";
      const dateLabel = d.date
        ? new Date(`${d.date}T00:00:00`).toLocaleDateString("en-SG", {
            weekday: "short",
            day: "numeric",
            month: "short",
          })
        : "";
      const rows: [string, string][] = [
        ["Service", svc?.title ?? ""],
        ["Where", d.format === "home" ? "Home visit (+$70 travel)" : "In-clinic"],
      ];
      if (d.format === "home" && d.address) rows.push(["Address", d.address]);
      rows.push(["When", `${dateLabel} · ${fmtTime(d.time)}`]);
      rows.push(["Clinician", clinician]);
      box.innerHTML = rows
        .map(
          ([k, v]) =>
            `<div class="booking__srow"><span class="booking__skey">${k}</span><span class="booking__sval">${v}</span></div>`,
        )
        .join("");
    }

    // ----- Navigation -----
    function goto(step: number, scroll = true) {
      current = step;
      stepEls.forEach((el) => {
        if (el.dataset.step === "done") return;
        el.hidden = el.dataset.step !== String(step);
      });
      progressItems.forEach((p) => {
        const n = Number(p.dataset.progress);
        p.toggleAttribute("data-active", n === step);
        p.toggleAttribute("data-done", n < step);
      });
      if (scroll) form!.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    form.querySelectorAll<HTMLElement>('[data-nav="next"]').forEach((btn) =>
      btn.addEventListener("click", () => {
        if (!validate(current)) return;
        if (current === 1) {
          bookingApi.track("service_selected");
          refreshSlots();
        }
        if (current === 2) bookingApi.track("time_selected");
        if (current + 1 === 3) buildSummary();
        goto(current + 1);
      }),
    );
    form.querySelectorAll<HTMLElement>('[data-nav="back"]').forEach((btn) =>
      btn.addEventListener("click", () => goto(current - 1)),
    );

    // ----- Submit -----
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!validate(3)) return;
      bookingApi.track("submitted");
      const submitBtn = form.querySelector<HTMLButtonElement>("[data-submit]");
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }
      setError("submit", "");
      const result = await bookingApi.createBooking(draft());
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Confirm booking";
      }
      if (!result.ok) {
        setError(
          "submit",
          result.error || "Something went wrong. Please try again or message us.",
        );
        return;
      }
      // Reveal confirmation, hide the steps.
      stepEls.forEach((el) => {
        if (el.dataset.step !== "done") el.hidden = true;
      });
      const done = getStep("done");
      const lead = form.querySelector<HTMLElement>("[data-done-lead]");
      const d = draft();
      const svc = serviceById(d.service ?? "");
      if (lead) {
        const dateLabel = d.date
          ? new Date(`${d.date}T00:00:00`).toLocaleDateString("en-SG", {
              weekday: "long",
              day: "numeric",
              month: "long",
            })
          : "";
        lead.textContent = `We've received your request for ${svc?.title ?? "an appointment"} on ${dateLabel} at ${fmtTime(d.time)}. Your reference is ${result.reference}.`;
      }
      progressItems.forEach((p) => {
        // Clear data-active too: a step left both active AND done renders its
        // number in the primary colour on a primary fill (invisible).
        p.removeAttribute("data-active");
        p.setAttribute("data-done", "");
      });
      if (done) {
        done.hidden = false;
        done.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });

    // Initial state (no scroll — keep the page heading in view on load).
    bookingApi.track("page_view");
    syncAddress();
    goto(1, false);
  }
</script>
