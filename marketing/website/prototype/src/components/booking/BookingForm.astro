<script>
  import { services, serviceById } from "../../lib/services";
  import { cliniciansForService, HOME_VISIT_CLINICIAN_ID } from "../../lib/clinicians";
  import {
    cliniciansForPhysioFocus,
    isPhysioFocus,
    physioCategories,
  } from "../../lib/physioCategories";
  import { bookingApi, type BookingDraft } from "../../lib/booking";

  const form = document.getElementById("booking-form") as HTMLFormElement | null;
  if (form) init(form);

  function init(form: HTMLFormElement) {
    const stepEls = Array.from(
      form.querySelectorAll<HTMLElement>("[data-step]"),
    );
    const progressItems = Array.from(
      form.querySelectorAll<HTMLElement>("[data-progress]"),
    );
    const getStep = (n: number | string) =>
      stepEls.find((el) => el.dataset.step === String(n)) ?? null;

    let current = 1;
    let selectedTime = "";
    let availSeq = 0; // monotonic token so only the latest availability request renders
    let availTimer: ReturnType<typeof setTimeout> | undefined; // debounce handle

    const draft = (): BookingDraft => ({
      service: (getChecked("service") as BookingDraft["service"]) ?? null,
      physioFocus: (getChecked("physioFocus") as BookingDraft["physioFocus"]) ?? null,
      variant: getChecked("variant") ?? null,
      format: (getChecked("format") as BookingDraft["format"]) || "clinic",
      address: composeAddress(),
      date: getValue("date"),
      time: selectedTime,
      clinicianId: getChecked("clinician") ?? "",
      name: getValue("name"),
      phone: getValue("phone"),
      email: getValue("email"),
      notes: composeNotes(),
    });

    /** Free-text detail the patient shares about their condition. */
    function composeNotes(): string {
      return getValue("notes");
    }

    function getChecked(name: string): string | null {
      const el = form!.querySelector<HTMLInputElement>(
        `input[name="${name}"]:checked`,
      );
      return el ? el.value : null;
    }
    function getValue(id: string): string {
      const el = document.getElementById(id) as
        | HTMLInputElement
        | HTMLTextAreaElement
        | null;
      return el ? el.value.trim() : "";
    }
    /** Build one formatted Singapore address string from the structured fields. */
    function composeAddress(): string {
      const block = getValue("addr-block");
      const street = getValue("addr-street");
      const building = getValue("addr-building");
      const unit = getValue("addr-unit");
      const postal = getValue("addr-postal");
      const notes = getValue("addr-notes");
      const parts: string[] = [];
      const line1 = [block, street].filter(Boolean).join(" ");
      if (line1) parts.push(line1);
      if (building) parts.push(building);
      if (unit) parts.push(unit);
      if (postal) parts.push(`Singapore ${postal}`);
      let addr = parts.join(", ");
      if (notes) addr += `${addr ? "; " : ""}Access: ${notes}`;
      return addr;
    }
    function setError(key: string, msg: string) {
      const p = form!.querySelector<HTMLElement>(`[data-error="${key}"]`);
      if (!p) return;
      p.textContent = msg;
      p.hidden = !msg;
    }
    function setFieldError(id: string, msg: string) {
      const control = document.getElementById(id);
      const field = control?.closest<HTMLElement>(".field");
      const err = document.getElementById(`${id}-error`);
      if (field) field.toggleAttribute("data-invalid", !!msg);
      if (err) {
        err.textContent = msg;
        err.hidden = !msg;
      }
    }

    // ----- Step 1: service + format wiring -----
    const whereBlock = form.querySelector<HTMLElement>("[data-where]");
    const focusBlock = form.querySelector<HTMLElement>("[data-physio-focus]");
    const variantBlock = form.querySelector<HTMLElement>("[data-physio-variant]");
    const homeLabel = form.querySelector<HTMLElement>("[data-home-label]");
    const homeHint = form.querySelector<HTMLElement>("[data-home-hint]");
    const addressBlock = form.querySelector<HTMLElement>("[data-address]");

    // Show + require the address fields ONLY for a home visit; an in-clinic
    // booking never asks for an address. The travel-surcharge note lives inside
    // the address block, so it appears the moment "Home visit" is chosen.
    function syncAddress() {
      const home = getChecked("format") === "home";
      if (addressBlock) addressBlock.hidden = !home;
      ["addr-block", "addr-street", "addr-postal"].forEach((id) => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (el) el.required = home;
      });
    }

    form.querySelectorAll<HTMLInputElement>('input[name="service"]').forEach(
      (input) => {
        input.addEventListener("change", onServiceChange);
      },
    );
    form.querySelectorAll<HTMLInputElement>('input[name="format"]').forEach(
      (input) => {
        input.addEventListener("change", () => {
          syncAddress();
          filterClinicians();  // home visit -> Cheryl only
          selectedTime = "";
          cal?.rerender();     // re-shade the calendar for the new format
          scheduleRefresh();   // format affects availability (travel padding)
        });
      },
    );
    form.querySelectorAll<HTMLInputElement>('input[name="physioFocus"]').forEach(
      (input) => {
        input.addEventListener("change", () => {
          setError("physioFocus", "");
          syncVariantVisibility();  // show/hide variant block based on sub-type
          filterClinicians();  // sub-type narrows the clinician set
          selectedTime = "";
          cal?.rerender();     // re-shade the calendar for the new sub-type
          scheduleRefresh();   // sub-type changes who's available
        });
      },
    );
    form.querySelectorAll<HTMLInputElement>('input[name="variant"]').forEach(
      (input) => {
        input.addEventListener("change", () => {
          setError("variant", "");
          filterClinicians();  // variant might change availability
          selectedTime = "";
          cal?.rerender();     // re-shade the calendar for the new variant
          scheduleRefresh();   // variant changes availability
        });
      },
    );

    /** Show/hide the variant selector based on whether paediatrics is selected. */
    function syncVariantVisibility() {
      if (!variantBlock) return;
      const focus = getChecked("physioFocus");
      const service = getChecked("service");
      const showVariants = focus === "paediatrics" || service === "paediatric-physiotherapy";
      variantBlock.hidden = !showVariants;
      if (!showVariants) {
        setError("variant", "");
        variantBlock
          .querySelectorAll<HTMLInputElement>('input[name="variant"]')
          .forEach((i) => (i.checked = false));
      }
    }

    function onServiceChange() {
      setError("service", "");
      const svc = serviceById(getChecked("service") ?? "");
      if (!svc) return;
      if (whereBlock) whereBlock.hidden = false;

      // Physiotherapy needs a sub-type (it filters clinicians); other services
      // don't. Show the focus block for physio only, and clear any stale selection
      // when switching away so it can't leak into the booking.
      // Paediatric-physiotherapy is pre-focused, so don't show the focus block.
      if (focusBlock) {
        const isPhysio = svc.id === "physiotherapy";
        focusBlock.hidden = !isPhysio;
        if (!isPhysio) {
          setError("physioFocus", "");
          focusBlock
            .querySelectorAll<HTMLInputElement>('input[name="physioFocus"]')
            .forEach((i) => (i.checked = false));
        }
      }
      // Show/hide variants for paediatric-physiotherapy service
      syncVariantVisibility();

      // Home-visit availability depends on the service.
      if (homeLabel && homeHint) {
        const homeInput = homeLabel.querySelector<HTMLInputElement>(
          'input[name="format"]',
        );
        if (svc.supportsHome) {
          homeLabel.hidden = false;
          homeHint.hidden = true;
        } else {
          homeLabel.hidden = true;
          homeHint.hidden = false;
          if (homeInput?.checked) {
            const clinic = form!.querySelector<HTMLInputElement>(
              'input[name="format"][value="clinic"]',
            );
            if (clinic) clinic.checked = true;
          }
        }
      }
      syncAddress();
      filterClinicians();

      // Service changed -> availability is stale.
      selectedTime = "";
    }

    /**
     * Show only the clinicians who can take this booking: those who offer the
     * chosen service, and — for a home visit — only the home-visit clinician
     * (Cheryl). "First available" is hidden for home visits since there is a
     * single option. Resets the selection if the current pick is no longer valid.
     */
    function filterClinicians() {
      const svc = serviceById(getChecked("service") ?? "");
      if (!svc) return;
      const home = getChecked("format") === "home";
      let serviceEligible = cliniciansForService(svc.id).map((c) => c.id);
      // Within Physiotherapy, the chosen sub-type narrows the clinician set
      // (e.g. Scoliosis -> Cheryl only). No sub-type yet -> leave the full set.
      const focus = getChecked("physioFocus");
      if (svc.id === "physiotherapy" && focus) {
        const focusIds = new Set(cliniciansForPhysioFocus(focus));
        serviceEligible = serviceEligible.filter((id) => focusIds.has(id));
      }
      const allowed = new Set(
        home
          ? serviceEligible.filter((id) => id === HOME_VISIT_CLINICIAN_ID)
          : serviceEligible,
      );
      form!.querySelectorAll<HTMLElement>("[data-clinician-opt]").forEach((opt) => {
        const input = opt.querySelector<HTMLInputElement>("input");
        const val = input?.value ?? "";
        const visible = val === "" ? !home : allowed.has(val);
        opt.hidden = !visible;
        if (!visible && input?.checked) input.checked = false;
      });
      // The "Or pick someone specific" separator only makes sense while the
      // "First available" default is shown (it's hidden for home visits).
      const orSep = form!.querySelector<HTMLElement>(".booking__clinician-or");
      if (orSep) orSep.hidden = home;
      // A home visit has exactly one clinician (auto-selected below), so the
      // whole disclosure disappears rather than offering a one-option picker.
      if (clinicianDetails) clinicianDetails.hidden = home;
      // Ensure something stays selected: home -> Cheryl, otherwise First available.
      if (!form!.querySelector('input[name="clinician"]:checked')) {
        const fallback = home ? HOME_VISIT_CLINICIAN_ID : "";
        const fb = form!.querySelector<HTMLInputElement>(
          `input[name="clinician"][value="${fallback}"]`,
        );
        if (fb) fb.checked = true;
      }
      updateClinicianCurrent();
    }

    // ----- Step 2: date (inline calendar) + slots -----
    const dateInput = document.getElementById("date") as HTMLInputElement | null;
    const chips = form.querySelector<HTMLElement>("[data-slots]");
    const slotsMsg = form.querySelector<HTMLElement>("[data-slots-msg]");
    const slotsSection = form.querySelector<HTMLElement>(".booking__slots");
    const recapEl = form.querySelector<HTMLElement>("[data-recap]");
    const clinicianDetails = form.querySelector<HTMLElement>("[data-clinician-details]");
    const clinicianCurrent = form.querySelector<HTMLElement>("[data-clinician-current]");

    const cal = initCalendar();

    /** Reflect the chosen clinician in the collapsed disclosure's summary row. */
    function updateClinicianCurrent() {
      if (!clinicianCurrent) return;
      const val = getChecked("clinician");
      // A named clinician's .copt__name is plain text (the badge only exists on
      // the "First available" card, which is the value="" fallback below).
      const name = val
        ? form!
            .querySelector(`input[name="clinician"][value="${val}"]`)
            ?.closest(".copt")
            ?.querySelector(".copt__name")
            ?.textContent?.trim()
        : "";
      clinicianCurrent.textContent = name || "First available";
    }

    form.querySelectorAll<HTMLInputElement>('input[name="clinician"]').forEach(
      (input) =>
        input.addEventListener("change", () => {
          bookingApi.track("clinician_changed", input.value || "first-available");
          updateClinicianCurrent();
          cal?.rerender(); // re-shade the calendar for the new clinician
          scheduleRefresh();
        }),
    );

    /** Step-1 recap shown at the top of step 2 ("Physiotherapy · In-clinic"). */
    function buildRecap() {
      if (!recapEl) return;
      const d = draft();
      const svc = serviceById(d.service ?? "");
      if (!svc) {
        recapEl.hidden = true;
        return;
      }
      const parts = [svc.title];
      const focus = physioCategories.find((c) => c.id === d.physioFocus);
      if (focus) parts.push(focus.label);
      if (d.variant && focus?.variants && focus.variants[d.variant]) {
        parts.push(`${focus.variants[d.variant].durationMin} min`);
      }
      parts.push(d.format === "home" ? "Home visit" : "In-clinic");
      recapEl.textContent = parts.join(" · ");
      recapEl.hidden = false;
    }

    /**
     * Inline month calendar — the primary date picker (no click-to-open icon).
     * Writes YYYY-MM-DD into the hidden #date input, then refreshes slots.
     * Bounded to [tomorrow, +60 days]; Sundays (clinic closed) are disabled.
     *
     * Days with no bookable slot are disabled too, from the month availability
     * summary — so nobody clicks through empty dates hunting for an opening.
     * The summary is best-effort: if it fails, the calendar stays unshaded and
     * the per-day slot fetch remains the truth. Returns {rerender,
     * autoPickFirstAvailable} for the step-1 handlers / step-2 entry.
     */
    function initCalendar() {
      const grid = form!.querySelector<HTMLElement>("[data-cal-grid]");
      const title = form!.querySelector<HTMLElement>("[data-cal-title]");
      const prev = form!.querySelector<HTMLButtonElement>("[data-cal-prev]");
      const next = form!.querySelector<HTMLButtonElement>("[data-cal-next]");
      if (!grid || !title || !prev || !next || !dateInput) return null;

      const startOfDay = (d: Date) => {
        const x = new Date(d);
        x.setHours(0, 0, 0, 0);
        return x;
      };
      const today = startOfDay(new Date());
      const minDate = new Date(today);
      minDate.setDate(minDate.getDate() + 1); // 1 day in advance (no same-day)
      const maxDate = new Date(today);
      maxDate.setDate(maxDate.getDate() + 60); // bookings capped 60 days out
      const ymd = (d: Date) =>
        `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
      const sameMonth = (a: Date, b: Date) =>
        a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth();

      let view = new Date(minDate.getFullYear(), minDate.getMonth(), 1);
      let shadeSeq = 0; // only the latest summary response may shade the grid
      const SHADE_MAX_RETRIES = 12;
      const shadeRetries = new Map<string, number>(); // month -> retries so far

      // Month summaries, keyed by the selection that shapes availability + the
      // month. Keys are immutable, so a service/clinician/format change simply
      // reads (or fetches) a different entry — no invalidation needed.
      const summaryCache = new Map<string, Promise<string[]>>();
      function fetchMonthDays(month: string): Promise<string[]> | null {
        const d = draft();
        if (!d.service) return null;
        const key = `${d.service}|${d.physioFocus ?? ""}|${d.variant ?? ""}|${d.clinicianId}|${d.format}|${month}`;
        let p = summaryCache.get(key);
        if (!p) {
          p = bookingApi.getAvailableDays({
            service: d.service,
            focus: d.physioFocus ?? undefined,
            variant: d.variant ?? undefined,
            clinicianId: d.clinicianId,
            month,
            home: d.format === "home",
          });
          p.catch(() => summaryCache.delete(key)); // don't cache failures
          summaryCache.set(key, p);
        }
        return p;
      }

      const monthOf = (d: Date) =>
        `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;

      /** Disable the shown month's days that have no bookable slot. Best-effort:
       *  on fetch failure the grid stays as render() painted it (clickable), and
       *  the per-day slot fetch remains the source of truth. */
      async function applyShading() {
        const source = fetchMonthDays(monthOf(view));
        if (!source) return; // no service chosen yet (step 1 not done)
        const shownMonth = monthOf(view);
        const mySeq = ++shadeSeq;
        let days: string[];
        try {
          days = await source;
        } catch {
          // A cold month is paged across several backend requests (Plato only
          // allows 20 req/min), so "still loading" is normal: ask again shortly
          // and the backend resumes where it stopped. Shading is cosmetic, so
          // this gives up quietly; the per-day fetch stays the source of truth.
          const tries = shadeRetries.get(shownMonth) ?? 0;
          if (tries < SHADE_MAX_RETRIES) {
            shadeRetries.set(shownMonth, tries + 1);
            setTimeout(() => {
              if (monthOf(view) === shownMonth) applyShading();
            }, Math.min(3000 + tries * 1000, 8000));
          }
          return;
        }
        if (mySeq !== shadeSeq || monthOf(view) !== shownMonth) return;
        const open = new Set(days);
        grid!.querySelectorAll<HTMLButtonElement>(".cal__day").forEach((btn) => {
          const value = btn.dataset.date ?? "";
          // Leave the already-picked day alone so the selection stays visible.
          if (!btn.disabled && value !== dateInput!.value && !open.has(value)) {
            btn.disabled = true;
          }
        });
      }

      function render() {
        title!.textContent = view.toLocaleDateString("en-SG", {
          month: "long",
          year: "numeric",
        });
        prev!.disabled = sameMonth(view, minDate);
        next!.disabled = sameMonth(view, maxDate);
        grid!.innerHTML = "";
        const y = view.getFullYear();
        const m = view.getMonth();
        const offset = new Date(y, m, 1).getDay(); // Sun=0 .. Sat=6 (Sunday-first)
        for (let i = 0; i < offset; i++) {
          const pad = document.createElement("span");
          pad.className = "cal__pad";
          grid!.appendChild(pad);
        }
        const days = new Date(y, m + 1, 0).getDate();
        for (let d = 1; d <= days; d++) {
          const date = new Date(y, m, d);
          const value = ymd(date);
          const disabled =
            date < minDate || date > maxDate || date.getDay() === 0; // Sun closed
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "cal__day";
          btn.textContent = String(d);
          btn.disabled = disabled;
          btn.dataset.date = value;
          btn.setAttribute("aria-pressed", String(value === dateInput!.value));
          if (!disabled) {
            btn.addEventListener("click", () => {
              dateInput!.value = value;
              selectedTime = "";
              setFieldError("date", "");
              bookingApi.track("date_picked", value);
              render();
              scheduleRefresh();
              // On a phone the times render below the fold — bring them into
              // view so the next action is visible without hunting.
              slotsSection?.scrollIntoView({ behavior: "smooth", block: "nearest" });
            });
          }
          grid!.appendChild(btn);
        }
        applyShading();
      }

      /**
       * Pick the first date with availability so the step never opens empty.
       * Walks month summaries from the earliest bookable month; a no-op once
       * the visitor has chosen a date (or if the summaries can't load).
       */
      async function autoPickFirstAvailable() {
        if (dateInput!.value) return;
        const minYmd = ymd(minDate);
        const maxYmd = ymd(maxDate);
        let m = new Date(minDate.getFullYear(), minDate.getMonth(), 1);
        while (m <= maxDate) {
          const source = fetchMonthDays(monthOf(m));
          if (!source) return;
          let days: string[];
          try {
            days = await source;
          } catch {
            return; // degrade: the visitor picks a date themselves
          }
          if (dateInput!.value) return; // they beat us to it
          const first = days.find((x) => x >= minYmd && x <= maxYmd);
          if (first) {
            const dt = new Date(`${first}T00:00:00`);
            view = new Date(dt.getFullYear(), dt.getMonth(), 1);
            dateInput!.value = first;
            setFieldError("date", "");
            render();
            scheduleRefresh();
            return;
          }
          m = new Date(m.getFullYear(), m.getMonth() + 1, 1);
        }
      }

      prev.addEventListener("click", () => {
        view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
        render();
      });
      next.addEventListener("click", () => {
        view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
        render();
      });
      render();
      return { rerender: render, autoPickFirstAvailable };
    }

    function fmtTime(t: string): string {
      const [h, m] = t.split(":").map(Number);
      const ap = h < 12 ? "am" : "pm";
      const h12 = h % 12 === 0 ? 12 : h % 12;
      return `${h12}:${String(m).padStart(2, "0")} ${ap}`;
    }

    /** Skeleton slot chips (same footprint as the real ones) while times load,
     *  so the list doesn't collapse to a bare text swap. */
    function showSlotsLoading() {
      if (!chips || !slotsMsg) return;
      chips.innerHTML = "";
      const gr = document.createElement("div");
      gr.className = "slots__grid";
      gr.setAttribute("aria-hidden", "true");
      for (let i = 0; i < 6; i++) {
        const sk = document.createElement("span");
        sk.className = "slot slot--skeleton";
        gr.appendChild(sk);
      }
      chips.appendChild(gr);
      slotsMsg.hidden = false;
      slotsMsg.textContent = "Finding available times…";
    }

    /**
     * Debounced entry point for availability. Rapid date/clinician/format
     * changes collapse to a single fetch after a short idle, so a burst of clicks
     * can't hammer Plato (which rate-limits and then backs off for a long time).
     */
    function scheduleRefresh() {
      if (availTimer) clearTimeout(availTimer);
      if (getValue("date")) showSlotsLoading();
      availTimer = setTimeout(refreshSlots, 250);
    }

    async function refreshSlots() {
      if (!chips || !slotsMsg) return;
      const d = draft();
      if (!d.service || !d.date) {
        chips.innerHTML = "";
        slotsMsg.hidden = false;
        slotsMsg.textContent = "Pick a date to see available times.";
        return;
      }
      // A monotonic token — only the most recent request may render. This makes
      // a double-click on the same date (identical key) safe, where the old
      // key-equality check let both responses render and duplicated the slots.
      const mySeq = ++availSeq;
      showSlotsLoading();
      // One quiet retry: a failure here is usually Plato's rate limit, which has
      // cleared a couple of seconds later. The skeleton stays up meanwhile.
      let times: string[] | null = null;
      for (let attempt = 0; attempt < 2 && times === null; attempt++) {
        if (attempt > 0) {
          await new Promise((resolve) => setTimeout(resolve, 2500));
          if (mySeq !== availSeq) return;
        }
        try {
          times = await bookingApi.getAvailability({
            service: d.service,
            focus: d.physioFocus ?? undefined,
            variant: d.variant ?? undefined,
            clinicianId: d.clinicianId,
            date: d.date,
            home: d.format === "home",
          });
        } catch {
          /* retried once above; reported below if it still fails */
        }
      }
      if (times === null) {
        if (mySeq !== availSeq) return;
        bookingApi.track("availability_error", d.date);
        chips.innerHTML = "";
        slotsMsg.hidden = false;
        slotsMsg.textContent =
          "We couldn't load times just now. Please pick the date again, or message us on WhatsApp below.";
        selectedTime = "";
        return;
      }
      if (mySeq !== availSeq) return; // a newer request superseded this one
      chips.innerHTML = ""; // guard against any stale content
      if (!times.length) {
        slotsMsg.hidden = false;
        slotsMsg.textContent =
          "No times available on this date. Please try another day.";
        selectedTime = "";
        return;
      }
      slotsMsg.hidden = true;
      const onPick = (t: string) => {
        selectedTime = t;
        setError("time", "");
        chips!
          .querySelectorAll<HTMLElement>(".slot")
          .forEach((c) =>
            c.setAttribute("aria-pressed", String(c.dataset.time === selectedTime)),
          );
      };
      const groups: { title: string; times: string[] }[] = [
        { title: "Morning", times: times.filter((t) => Number(t.slice(0, 2)) < 12) },
        { title: "Afternoon", times: times.filter((t) => Number(t.slice(0, 2)) >= 12) },
      ];
      groups.forEach((g) => {
        if (!g.times.length) return;
        const wrap = document.createElement("div");
        wrap.className = "slots__group";
        const h = document.createElement("p");
        h.className = "slots__gtitle";
        h.textContent = g.title;
        const gr = document.createElement("div");
        gr.className = "slots__grid";
        g.times.forEach((t) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "slot";
          btn.dataset.time = t;
          btn.textContent = fmtTime(t);
          btn.setAttribute("aria-pressed", String(t === selectedTime));
          btn.addEventListener("click", () => onPick(t));
          gr.appendChild(btn);
        });
        wrap.appendChild(h);
        wrap.appendChild(gr);
        chips!.appendChild(wrap);
      });
    }

    // ----- Step 3: fire the "details" funnel event once, when the user first
    // engages the details form. This is distinct from merely reaching the step
    // (implied by "time_selected"), so the dashboard can see who lands on the
    // details step but never starts filling it in. -----
    let detailsTracked = false;
    function markDetailsEngaged() {
      if (detailsTracked) return;
      detailsTracked = true;
      bookingApi.track("details");
    }
    ["name", "phone", "email", "notes"].forEach((id) => {
      document.getElementById(id)?.addEventListener("input", () => {
        markDetailsEngaged();
        if (id !== "notes") setFieldError(id, ""); // clear the error as they correct it
        if (id === "email") {
          emailTypoAck = false; // a fresh edit re-arms the typo check
          refreshEmailSuggestion();
        }
      });
    });


    // ----- Validation per step -----
    /**
     * A valid Singapore number: 8 digits starting 6 (landline/VoIP), 8 or 9
     * (mobile). Accepts spacing/dashes and an optional +65 / 65 country code.
     */
    function isValidSgPhone(raw: string): boolean {
      let n = raw.replace(/[^\d]/g, ""); // digits only (drops +, spaces, dashes)
      if (n.length === 10 && n.startsWith("65")) n = n.slice(2); // strip country code
      return /^[689]\d{7}$/.test(n);
    }

    /** A pragmatic email check: local@domain.tld, tld >= 2 letters, no spaces. */
    function isValidEmail(raw: string): boolean {
      return /^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/.test(raw.trim());
    }

    // Common consumer webmail domains. A typo like "gmail.con" passes the format
    // check above but bounces, so the confirmation never arrives. We suggest a
    // fix when the domain is a single-edit miss of one of these (insert, delete,
    // substitution, or adjacent swap, so "gmail.con" and "gmial.com" are both
    // caught). Deliberately short (big providers only) and distance-1 only, so a
    // real but unusual domain is never mistaken for a typo; short/ambiguous names
    // (me.com, qq.com) are left out. The backend has the same list (see
    // scripts/booking/booking.py); keep the two in sync.
    const COMMON_EMAIL_DOMAINS = [
      "gmail.com", "googlemail.com", "yahoo.com", "yahoo.com.sg", "ymail.com",
      "hotmail.com", "hotmail.sg", "outlook.com", "outlook.sg", "live.com",
      "icloud.com", "singnet.com.sg",
    ];

    /** Optimal string alignment distance: Levenshtein + adjacent transposition. */
    function osaDistance(a: string, b: string): number {
      if (a === b) return 0;
      const lb = b.length;
      let prev2: number[] = [];
      let prev = Array.from({ length: lb + 1 }, (_, i) => i);
      for (let i = 1; i <= a.length; i++) {
        const cur = [i, ...Array(lb).fill(0)];
        for (let j = 1; j <= lb; j++) {
          const cost = a[i - 1] === b[j - 1] ? 0 : 1;
          cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost);
          if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {
            cur[j] = Math.min(cur[j], prev2[j - 2] + 1);
          }
        }
        prev2 = prev;
        prev = cur;
      }
      return prev[lb];
    }

    /**
     * If the email's domain is a one-edit miss of a common webmail domain
     * (e.g. "gmail.con" -> "gmail.com"), return the corrected address; else null.
     */
    function suggestEmailFix(raw: string): string | null {
      const email = raw.trim();
      const at = email.lastIndexOf("@");
      if (at < 0) return null;
      const local = email.slice(0, at);
      const domain = email.slice(at + 1).toLowerCase();
      if (!domain || COMMON_EMAIL_DOMAINS.includes(domain)) return null;
      for (const good of COMMON_EMAIL_DOMAINS) {
        if (osaDistance(domain, good) === 1) return `${local}@${good}`;
      }
      return null;
    }

    // "Did you mean …?" element under the email field + a one-shot flag: we
    // block the first submit with a suspected typo, but let a genuinely-unusual
    // address through on a second submit so we never trap a real email.
    const emailSuggest = form.querySelector<HTMLElement>("[data-email-suggest]");
    let emailTypoAck = false;

    /** Render (or clear) the one-tap email correction under the email field. */
    function refreshEmailSuggestion() {
      if (!emailSuggest) return;
      const fix = suggestEmailFix(getValue("email"));
      emailSuggest.textContent = "";
      if (!fix) {
        emailSuggest.hidden = true;
        return;
      }
      emailSuggest.hidden = false;
      emailSuggest.append("Did you mean ");
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "booking__suggest-fix";
      btn.textContent = fix;
      btn.addEventListener("click", () => {
        const el = document.getElementById("email") as HTMLInputElement | null;
        if (el) el.value = fix;
        emailTypoAck = false;
        setFieldError("email", "");
        refreshEmailSuggestion();
      });
      emailSuggest.append(btn, "?");
    }

    function validate(step: number): boolean {
      const d = draft();
      if (step === 1) {
        if (!d.service) {
          setError("service", "Please choose a service to continue.");
          return false;
        }
        if (d.service === "physiotherapy" && !d.physioFocus) {
          setError("physioFocus", "Please choose a type of physiotherapy.");
          bookingApi.track("validation_error", "physioFocus");
          return false;
        }
        if (d.physioFocus === "paediatrics" && !d.variant) {
          setError("variant", "Please choose a session duration.");
          bookingApi.track("validation_error", "variant");
          return false;
        }
        if (d.format === "home") {
          let ok = true;
          setFieldError("addr-block", getValue("addr-block") ? "" : "Required");
          setFieldError("addr-street", getValue("addr-street") ? "" : "Required");
          if (!getValue("addr-block")) ok = false;
          if (!getValue("addr-street")) ok = false;
          if (!/^\d{6}$/.test(getValue("addr-postal"))) {
            setFieldError("addr-postal", "Enter a 6-digit postal code.");
            ok = false;
          } else {
            setFieldError("addr-postal", "");
          }
          return ok;
        }
        return true;
      }
      if (step === 2) {
        let ok = true;
        if (!d.date) {
          setFieldError("date", "Please choose a preferred date.");
          ok = false;
        }
        if (!d.time) {
          setError("time", "Please pick an available time.");
          ok = false;
        }
        return ok;
      }
      if (step === 3) {
        const bad: string[] = [];
        if (!d.name) {
          setFieldError("name", "Please enter your name.");
          bad.push("name");
        } else setFieldError("name", "");
        if (!isValidSgPhone(d.phone)) {
          setFieldError("phone", "Please enter a valid 8-digit Singapore number.");
          bad.push("phone");
        } else setFieldError("phone", "");
        if (!isValidEmail(d.email)) {
          setFieldError("email", "Please enter a valid email address.");
          bad.push("email");
        } else {
          setFieldError("email", "");
          // Catch common-domain typos (gmail.con) that pass the format check but
          // bounce. Block once with a suggestion; a second submit keeps the
          // typed address, so a genuinely-unusual email is never trapped.
          const fix = suggestEmailFix(d.email);
          refreshEmailSuggestion();
          if (fix && !emailTypoAck) {
            emailTypoAck = true;
            setFieldError(
              "email",
              `This looks like a typo. Did you mean ${fix}? Tap the suggestion above, or submit again to keep this address.`,
            );
            bad.push("email");
          }
        }
        // Form-friction is a real stuck point: log which field(s) the visitor
        // got wrong so the funnel shows where the details step bleeds people.
        if (bad.length) bookingApi.track("validation_error", bad.join(","));
        return bad.length === 0;
      }
      return true;
    }

    // ----- Summary (step 3) -----
    function buildSummary() {
      const box = form!.querySelector<HTMLElement>("[data-summary]");
      if (!box) return;
      const d = draft();
      const svc = serviceById(d.service ?? "");
      const clinician =
        d.clinicianId === ""
          ? "First available"
          : form!
              .querySelector(
                `input[name="clinician"][value="${d.clinicianId}"]`,
              )
              ?.closest(".copt")
              ?.querySelector(".copt__name")?.textContent || "First available";
      const dateLabel = d.date
        ? new Date(`${d.date}T00:00:00`).toLocaleDateString("en-SG", {
            weekday: "short",
            day: "numeric",
            month: "short",
          })
        : "";
      const rows: [string, string][] = [
        ["Service", svc?.title ?? ""],
        ["Where", d.format === "home" ? "Home visit (+$120 travel)" : "In-clinic"],
      ];
      if (d.format === "home" && d.address) rows.push(["Address", d.address]);
      rows.push(["When", `${dateLabel} · ${fmtTime(d.time)}`]);
      rows.push(["Clinician", clinician]);
      box.innerHTML = rows
        .map(
          ([k, v]) =>
            `<div class="booking__srow"><span class="booking__skey">${k}</span><span class="booking__sval">${v}</span></div>`,
        )
        .join("");
    }

    // ----- Navigation -----
    function goto(step: number, scroll = true) {
      current = step;
      stepEls.forEach((el) => {
        if (el.dataset.step === "done") return;
        el.hidden = el.dataset.step !== String(step);
      });
      progressItems.forEach((p) => {
        const n = Number(p.dataset.progress);
        p.toggleAttribute("data-active", n === step);
        p.toggleAttribute("data-done", n < step);
      });
      if (scroll) form!.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    form.querySelectorAll<HTMLElement>('[data-nav="next"]').forEach((btn) =>
      btn.addEventListener("click", () => {
        if (!validate(current)) return;
        if (current === 1) {
          bookingApi.track("service_selected");
          buildRecap();
          cal?.rerender(); // shade the calendar for the step-1 selection
          cal?.autoPickFirstAvailable(); // never open the step on an empty date
          scheduleRefresh();
        }
        if (current === 2) bookingApi.track("time_selected");
        if (current + 1 === 3) buildSummary();
        goto(current + 1);
      }),
    );
    form.querySelectorAll<HTMLElement>('[data-nav="back"]').forEach((btn) =>
      btn.addEventListener("click", () => goto(current - 1)),
    );

    // ----- Submit -----
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!validate(3)) return;
      bookingApi.track("submitted");
      const submitBtn = form.querySelector<HTMLButtonElement>("[data-submit]");
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }
      setError("submit", "");
      const result = await bookingApi.createBooking(draft());
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Confirm booking";
      }
      if (!result.ok) {
        setError(
          "submit",
          result.error || "Something went wrong. Please try again or message us.",
        );
        return;
      }
      // Reveal confirmation, hide the steps.
      stepEls.forEach((el) => {
        if (el.dataset.step !== "done") el.hidden = true;
      });
      const done = getStep("done");
      const lead = form.querySelector<HTMLElement>("[data-done-lead]");
      const d = draft();
      const svc = serviceById(d.service ?? "");

      // Conversion signal: tell GA4 (and Google Ads, if configured) a booking was
      // confirmed, valued at the service price, so Smart Bidding can optimise
      // toward booking-producing queries instead of cheap brand clicks. gtag only
      // exists when PUBLIC_GA4_ID / PUBLIC_GADS_ID are set, so this is inert on
      // dev/preview. transaction_id dedupes. Never break the confirmation.
      try {
        const w = window as any;
        const value = svc && svc.price ? Number(svc.price) || undefined : undefined;
        if (typeof w.gtag === "function") {
          w.gtag("event", "booking_confirmed", {
            value, currency: "SGD", transaction_id: result.reference, service: d.service,
          });
          if (w.__gojiBookingConversion) {
            w.gtag("event", "conversion", {
              send_to: w.__gojiBookingConversion,
              value, currency: "SGD", transaction_id: result.reference,
            });
          }
        }
      } catch { /* analytics must never block the booking confirmation */ }
      if (lead) {
        const dateLabel = d.date
          ? new Date(`${d.date}T00:00:00`).toLocaleDateString("en-SG", {
              weekday: "long",
              day: "numeric",
              month: "long",
            })
          : "";
        lead.textContent = `We've received your request for ${svc?.title ?? "an appointment"} on ${dateLabel} at ${fmtTime(d.time)}. Your reference is ${result.reference}.`;
      }
      progressItems.forEach((p) => {
        // Clear data-active too: a step left both active AND done renders its
        // number in the primary colour on a primary fill (invisible).
        p.removeAttribute("data-active");
        p.setAttribute("data-done", "");
      });
      if (done) {
        done.hidden = false;
        done.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });

    /**
     * Deep-link preselect: service pages link to /book?service=…&focus=… so the
     * visitor lands on the right option (and physio sub-type) already chosen.
     * We only act on known ids, and fire "change" so the same handlers run as a
     * click would (show sub-type, filter clinicians, update availability).
     */
    function applyDeepLink() {
      const params = new URLSearchParams(location.search);
      const service = params.get("service");
      if (service && form!.querySelector(`input[name="service"][value="${service}"]`)) {
        const el = form!.querySelector<HTMLInputElement>(
          `input[name="service"][value="${service}"]`,
        )!;
        el.checked = true;
        el.dispatchEvent(new Event("change", { bubbles: true }));
      }
      const focus = params.get("focus");
      if (focus && isPhysioFocus(focus)) {
        const el = form!.querySelector<HTMLInputElement>(
          `input[name="physioFocus"][value="${focus}"]`,
        );
        if (el) {
          el.checked = true;
          el.dispatchEvent(new Event("change", { bubbles: true }));
        }
      }
      const variant = params.get("variant");
      if (variant) {
        const el = form!.querySelector<HTMLInputElement>(
          `input[name="variant"][value="${variant}"]`,
        );
        if (el) {
          el.checked = true;
          el.dispatchEvent(new Event("change", { bubbles: true }));
        }
      }
    }

    // Initial state (no scroll — keep the page heading in view on load).
    bookingApi.track("page_view");
    syncAddress();
    applyDeepLink();
    goto(1, false);
  }
</script>
