---
/**
 * ServiceOption — a selectable service card (radio). The whole card is the
 * label; the radio is visually hidden but drives :checked styling and the
 * BookingForm script. Data attributes feed the format toggle + summary.
 */
import { Icon } from "astro-icon/components";
import type { Service } from "../../lib/services";

interface Props {
  service: Service;
}
const { service: s } = Astro.props;
---

<label class="soption">
  <input
    class="soption__input visually-hidden"
    type="radio"
    name="service"
    value={s.id}
    data-supports-home={s.supportsHome ? "1" : "0"}
    data-duration={String(s.durationMin)}
    data-price={s.price}
    data-title={s.title}
  />
  <span class="soption__icon" aria-hidden="true">
    <Icon name={s.icon} size={22} />
  </span>
  <span class="soption__body">
    <span class="soption__name">{s.title}</span>
    <span class="soption__meta">{s.meta.join(" · ")}</span>
  </span>
  {s.price && (
    <span class="soption__price">
      ${s.price}
      {s.priceUsual && <span class="soption__usual">Introductory price (usual ${s.priceUsual})</span>}
    </span>
  )}
  <span class="soption__tick" aria-hidden="true"></span>
</label>

<style>
  .soption {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-content);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .soption:hover {
    border-color: var(--color-border-strong);
  }
  .soption:has(.soption__input:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .soption:has(.soption__input:checked) {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .soption__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: var(--color-linen);
    color: var(--color-primary);
    flex: none;
  }
  .soption__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .soption__name {
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
  }
  .soption__meta {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .soption__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: var(--weight-semibold);
    color: var(--text-default);
    white-space: nowrap;
  }
  .soption__usual {
    font-size: var(--fs-caption);
    font-weight: var(--weight-regular, 400);
    color: var(--text-muted);
  }

  /* Berry tick that fills in when the card is selected. */
  .soption__tick {
    grid-column: 3;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-border-strong);
    position: relative;
    flex: none;
    display: none;
  }
  .soption:has(.soption__input:checked) .soption__tick {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .soption:has(.soption__input:checked) .soption__tick::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0.34rem;
    height: 0.55rem;
    border: solid var(--color-linen);
    border-width: 0 2px 2px 0;
    transform: translateY(-1px) rotate(45deg);
  }
  /* Show the tick beside the price on wider cards. */
  @media (min-width: 520px) {
    .soption {
      grid-template-columns: auto 1fr auto auto;
    }
    .soption__tick {
      grid-column: 4;
      display: block;
    }
  }
</style>
