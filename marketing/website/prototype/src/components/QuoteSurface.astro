---
/**
 * QuoteSurface — the one sanctioned full-bleed Deep Red surface (Linen text +
 * light logo). Built for the brand promise / closing line.
 *
 * COMPLIANCE: Lane A (clinical) has NO patient testimonials by default. Do not
 * drop a patient quote here. Use the brand promise or another compliant,
 * non-testimonial line. Any real testimonial needs consent + compliance sign-off.
 */
import LogoLockup from "./LogoLockup.astro";

interface Props {
  /** Each entry renders on its own line (controls the wrap points). */
  lines?: string[];
  attribution?: string;
}
const {
  lines = [
    "We're not here to fix you.",
    "We're here to help you feel confident",
    "in your body again.",
  ],
  attribution,
} = Astro.props;
---

<div class="quote-wrap">
  <figure class="quote">
    <LogoLockup variant="light" height={34} class="quote__logo" />
    <blockquote class="quote__text">
      {lines.map((line) => <span class="quote__line">{line}</span>)}
    </blockquote>
    {attribution && <figcaption class="quote__by">{attribution}</figcaption>}
  </figure>
</div>

<style>
  .quote-wrap {
    position: relative;
    padding-block: var(--space-3);
  }

  .quote {
    margin: 0;
    width: 100%;
    max-width: 74ch;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    position: relative;
  }
  .quote__logo { opacity: 0.95; }
  .quote__text {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: clamp(1.5rem, 1.15rem + 1.4vw, 2.1rem);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-on-dark);
    margin: 0;
    width: 100%;
  }
  .quote__line {
    display: block;
  }
  .quote__by {
    font-size: var(--fs-small);
    color: var(--color-linen);
    opacity: 0.8;
  }
</style>
