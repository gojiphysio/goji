---
/**
 * QuoteSurface — the one sanctioned full-bleed Deep Red surface (Linen text +
 * light logo). Built for the brand promise / closing line.
 *
 * COMPLIANCE: Lane A (clinical) has NO patient testimonials by default. Do not
 * drop a patient quote here. Use the brand promise or another compliant,
 * non-testimonial line. Any real testimonial needs consent + compliance sign-off.
 */
interface Props {
  /** Each entry renders on its own line (controls the wrap points). */
  lines?: string[];
  attribution?: string;
}
const {
  lines = [
    "We're not here to fix you.",
    "We're here to help you feel confident",
    "in your body again.",
  ],
  attribution,
} = Astro.props;
---

<div class="quote-wrap">
  <figure class="quote">
    <span
      class="quote__logo"
      role="img"
      aria-label="Goji — Women's and Family Physiotherapy"
    ></span>
    <blockquote class="quote__text">
      {lines.map((line) => <span class="quote__line">{line}</span>)}
    </blockquote>
    {attribution && <figcaption class="quote__by">{attribution}</figcaption>}
  </figure>
</div>

<style>
  .quote-wrap {
    position: relative;
    padding-block: var(--space-3);
  }

  .quote {
    margin: 0;
    width: 100%;
    max-width: 74ch;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    position: relative;
  }
  /* Fill the whole lockup (wordmark + berry "O") with one flat linen colour
     so the Deep Red "O" no longer disappears into the Deep Red surface.
     A mask paints the token colour through the logo's alpha shape. */
  .quote__logo {
    display: block;
    height: 34px;
    aspect-ratio: 4096 / 2008;
    background-color: var(--text-on-dark);
    -webkit-mask: url("/brand/logo_light_transparent.png") center / contain no-repeat;
    mask: url("/brand/logo_light_transparent.png") center / contain no-repeat;
    opacity: 0.95;
  }
  .quote__text {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: clamp(1.5rem, 1.15rem + 1.4vw, 2.1rem);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-on-dark);
    margin: 0;
    width: 100%;
  }
  .quote__line {
    display: block;
  }
  .quote__by {
    font-size: var(--fs-small);
    color: var(--color-linen);
    opacity: 0.8;
  }
</style>
