---
/**
 * BerryList — the signature berry-dot bullet list (the brand's visual anchor).
 * The dot is pure CSS (no image). Pass `items` for a simple list, or use the
 * default slot for richer markup. `columns` lays long lists out in 2 columns.
 */
interface Props {
  items?: string[];
  columns?: 1 | 2;
  class?: string;
}
const { items, columns = 1, class: className = "" } = Astro.props;
---

<ul class:list={["berry-list", `cols-${columns}`, className]}>
  {items ? items.map((item) => <li>{item}</li>) : <slot />}
</ul>

<style>
  .berry-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .berry-list.cols-2 {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .berry-list.cols-2 {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-6);
    }
  }

  .berry-list :global(li) {
    position: relative;
    padding-left: 1.6rem;
    line-height: var(--lh-snug);
  }
  .berry-list :global(li)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background-color: var(--berry);
    transform: translateY(-50%);
  }
</style>
