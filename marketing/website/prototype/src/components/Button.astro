---
/**
 * Button / CTA.
 * - Pass `slug` (a tracked CtaSlug) so the link routes through the
 *   go.gojiphysio.com redirector, OR pass a plain `href` for in-page anchors.
 * - variants: primary (Deep Red fill), secondary (outline Earth Brown), ghost.
 * - `berry` prepends the signature berry dot.
 */
import { cta, type CtaSlug } from "../lib/links.ts";

interface Props {
  slug?: CtaSlug;
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  berry?: boolean;
  class?: string;
}

const {
  slug,
  href,
  variant = "primary",
  size = "md",
  berry = false,
  class: className = "",
} = Astro.props;

const url = slug ? cta(slug) : (href ?? "#");
const external = url.startsWith("http");
---

<a
  class:list={["btn", `btn--${variant}`, `btn--${size}`, className]}
  href={url}
  {...external ? { target: "_blank", rel: "noopener" } : {}}
>
  {berry && <span class="btn__berry" aria-hidden="true"></span>}
  <span class="btn__label"><slot /></span>
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    line-height: 1;
    text-decoration: none;
    border-radius: var(--radius-pill);
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: background-color var(--dur) var(--ease),
      color var(--dur) var(--ease), border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .btn:hover {
    transform: translateY(-1px);
  }

  .btn--md {
    font-size: var(--fs-small);
    padding: 0.7rem 1.25rem;
  }
  .btn--lg {
    font-size: var(--fs-body);
    padding: 0.9rem 1.65rem;
  }

  .btn--primary {
    background-color: var(--cta-bg);
    color: var(--cta-text);
  }
  .btn--primary:hover {
    background-color: var(--cta-bg-hover);
    color: var(--cta-text);
  }

  .btn--secondary {
    background-color: transparent;
    color: var(--text-default);
    border-color: var(--color-ink);
  }
  .btn--secondary:hover {
    background-color: var(--color-ink);
    color: var(--color-linen);
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--color-primary);
    padding-inline: 0.25rem;
  }
  .btn--ghost:hover {
    color: var(--color-primary-deep);
  }

  .btn__berry {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background-color: currentColor;
    flex: none;
  }
  /* On the filled primary the dot reads better in linen than the text colour. */
  .btn--primary .btn__berry {
    background-color: var(--color-linen);
  }
</style>
