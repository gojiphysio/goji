---
/**
 * Button / CTA.
 * - Pass `slug` (a tracked CtaSlug) so the link routes through the
 *   go.gojiphysio.com redirector, OR pass a plain `href` for in-page anchors.
 * - variants: primary (Deep Red fill), secondary (outline Earth Brown), ghost,
 *   whatsapp (WhatsApp-green fill with the WhatsApp glyph — for web-wa CTAs).
 * - `berry` prepends the signature berry dot (ignored on the whatsapp variant,
 *   which shows the WhatsApp icon instead).
 */
import { cta, type CtaSlug } from "../lib/links.ts";

interface Props {
  slug?: CtaSlug;
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "whatsapp";
  size?: "md" | "lg";
  berry?: boolean;
  class?: string;
}

const {
  slug,
  href,
  variant = "primary",
  size = "md",
  berry = false,
  class: className = "",
} = Astro.props;

const url = slug ? cta(slug) : (href ?? "#");
const external = url.startsWith("http");
const isWhatsApp = variant === "whatsapp";
---

<a
  class:list={["btn", `btn--${variant}`, `btn--${size}`, className]}
  href={url}
  {...external ? { target: "_blank", rel: "noopener" } : {}}
>
  {isWhatsApp && (
    <svg class="btn__wa-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
    </svg>
  )}
  {berry && !isWhatsApp && <span class="btn__berry" aria-hidden="true"></span>}
  <span class="btn__label"><slot /></span>
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    line-height: 1;
    text-decoration: none;
    border-radius: var(--radius-pill);
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: background-color var(--dur) var(--ease),
      color var(--dur) var(--ease), border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .btn:hover {
    transform: translateY(-1px);
  }

  .btn--md {
    font-size: var(--fs-small);
    padding: 0.7rem 1.25rem;
  }
  .btn--lg {
    font-size: var(--fs-body);
    padding: 0.9rem 1.65rem;
  }

  .btn--primary {
    background-color: var(--cta-bg);
    color: var(--cta-text);
  }
  .btn--primary:hover {
    background-color: var(--cta-bg-hover);
    color: var(--cta-text);
  }

  .btn--secondary {
    background-color: transparent;
    color: var(--text-default);
    border-color: var(--color-ink);
  }
  .btn--secondary:hover {
    background-color: var(--color-ink);
    color: var(--color-linen);
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--color-primary);
    padding-inline: 0.25rem;
  }
  .btn--ghost:hover {
    color: var(--color-primary-deep);
  }

  .btn--whatsapp {
    background-color: var(--color-whatsapp);
    color: #ffffff;
  }
  .btn--whatsapp:hover {
    background-color: var(--color-whatsapp-hover);
    color: #ffffff;
  }
  .btn__wa-icon {
    width: 1.15em;
    height: 1.15em;
    flex: none;
    display: block;
  }

  .btn__berry {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background-color: currentColor;
    flex: none;
  }
  /* On the filled primary the dot reads better in linen than the text colour. */
  .btn--primary .btn__berry {
    background-color: var(--color-linen);
  }
</style>
