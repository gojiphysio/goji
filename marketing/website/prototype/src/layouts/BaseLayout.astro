---
/**
 * BaseLayout — document shell: <head>, fonts, tokens, skip link, site header
 * and footer. Pass `bare` to drop the header/footer (used by the styleguide).
 */
import "@fontsource-variable/inter";
import "@fontsource/plus-jakarta-sans/400.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "../styles/tokens.css";
import "../styles/base.css";

import LogoLockup from "../components/LogoLockup.astro";
import Button from "../components/Button.astro";
import { SITE } from "../lib/site.ts";

interface Props {
  title?: string;
  description?: string;
  bare?: boolean;
  noindex?: boolean;
}
const {
  title = SITE.seoTitle,
  description = SITE.seoDescription,
  bare = false,
  noindex = false,
} = Astro.props;

const origin = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, origin);
const ogImage = new URL("/og-image.jpg", origin);

// LocalBusiness structured data for local SEO (NAP from SITE).
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  name: SITE.fullName,
  url: origin.href,
  image: ogImage.href,
  email: SITE.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.address.line1,
    addressLocality: "Singapore",
    postalCode: "788887",
    addressCountry: "SG",
  },
  openingHours: "Mo-Sa 08:00-20:00",
  sameAs: ["https://www.instagram.com/gojiphysio/"],
};

const isHome = Astro.url.pathname === "/";
const nav = [
  { href: isHome ? "#about" : "/#about", label: "About" },
  { href: isHome ? "#services" : "/#services", label: "Services" },
  { href: "/conditions", label: "Conditions" },
  { href: isHome ? "#team" : "/#team", label: "Team" },
  { href: isHome ? "#contact" : "/#contact", label: "Find us" },
];

// GA4 (website tracking). Inert until PUBLIC_GA4_ID is set in the Cloudflare
// Pages build env — dev/preview and the un-launched prototype emit no tag.
// NOTE: a PDPA consent mechanism must be in place before enabling in
// production (see business-intelligence/scripts/dashboard/DEPLOY.md).
const GA4_ID = import.meta.env.PUBLIC_GA4_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/brand/logo_mark_transparent.png" />
    <meta name="theme-color" content="#91171d" />

    {/* Open Graph / Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Goji Physiotherapy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    {!bare && <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />}

    {/* GA4 (website tracking). Inert until PUBLIC_GA4_ID is set in the build env. */}
    {
      GA4_ID && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} />
          <script is:inline define:vars={{ GA4_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", GA4_ID);
          </script>
        </Fragment>
      )
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    {
      !bare && (
        <header class="site-header">
          <div class="container site-header__inner">
            <a href="/" class="site-header__logo" aria-label="Goji home">
              <LogoLockup variant="light" height={34} />
            </a>
            <nav class="site-nav" aria-label="Primary">
              {nav.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </nav>
            <div class="site-header__cta">
              <Button slug="web-plato" variant="primary">Book</Button>
            </div>
          </div>
        </header>
      )
    }

    <main id="main">
      <slot />
    </main>

    {
      !bare && (
        <a
          href="https://go.gojiphysio.com/web-wa"
          class="wa-pill"
          aria-label="Chat with us on WhatsApp"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="wa-pill__icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          <span class="wa-pill__text">WhatsApp</span>
        </a>
      )
    }

    {
      !bare && (
        <footer class="site-footer">
          <div class="container site-footer__inner">
            <div class="site-footer__brand">
              <LogoLockup variant="light" height={30} />
              <p class="site-footer__tagline">{SITE.tagline}</p>
            </div>
            <div class="site-footer__meta">
              <p>{SITE.address.line1}<br />{SITE.address.line2}</p>
              <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
              <p>
                <a href="https://www.instagram.com/gojiphysio/" target="_blank" rel="noopener noreferrer">
                  @gojiphysio ↗
                </a>
              </p>
            </div>
          </div>
          <div class="container site-footer__copyright">
            <p>&copy; {new Date().getFullYear()} Goji Health. All rights reserved.</p>
          </div>
        </footer>
      )
    }

    <style>
      .skip-link {
        position: absolute;
        left: var(--space-4);
        top: -3rem;
        background: var(--color-ink);
        color: var(--color-linen);
        padding: 0.5rem 1rem;
        border-radius: var(--radius-sm);
        z-index: 100;
        transition: top var(--dur) var(--ease);
      }
      .skip-link:focus {
        top: var(--space-4);
        color: var(--color-linen);
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background-color: var(--color-ink);
        border-bottom: 1px solid color-mix(in srgb, var(--color-linen) 15%, transparent);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-5);
        min-height: 68px;
      }
      .site-nav {
        display: none;
        gap: var(--space-5);
      }
      .site-nav a {
        font-family: var(--font-display);
        color: color-mix(in srgb, var(--color-linen) 75%, transparent);
        text-decoration: none;
        font-size: var(--fs-small);
        font-weight: var(--weight-medium);
        letter-spacing: -0.01em;
        transition: color var(--dur) var(--ease);
      }
      .site-nav a:hover {
        color: var(--color-linen);
      }
      @media (min-width: 880px) {
        .site-nav {
          display: flex;
        }
      }

      .site-footer {
        background-color: var(--color-ink);
        color: var(--color-linen);
        padding-top: var(--space-8);
        border-top: 1px solid color-mix(in srgb, var(--color-linen) 15%, transparent);
      }
      .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-7);
        justify-content: space-between;
        align-items: start;
      }
      .site-footer__tagline {
        margin-top: var(--space-3);
        font-size: var(--fs-small);
        color: color-mix(in srgb, var(--color-linen) 60%, transparent);
        line-height: var(--lh-body);
        max-width: 28ch;
      }
      .site-footer__meta {
        font-size: var(--fs-small);
        display: grid;
        gap: var(--space-2);
        color: color-mix(in srgb, var(--color-linen) 75%, transparent);
      }
      .site-footer__meta a {
        color: var(--color-linen);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
      .site-footer__copyright {
        margin-top: var(--space-6);
        padding-block: var(--space-4);
        border-top: 1px solid color-mix(in srgb, var(--color-linen) 10%, transparent);
        font-size: var(--fs-caption);
        color: color-mix(in srgb, var(--color-linen) 45%, transparent);
      }

      /* ── Floating WhatsApp pill CTA with radiating glow ── */
      .wa-pill {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 200;
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.6rem 1.1rem 0.6rem 0.85rem;
        border-radius: 9999px;
        background: #25D366;
        color: #ffffff;
        text-decoration: none;
        font-family: var(--font-display);
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        box-shadow: 0 4px 20px rgba(37, 211, 102, 0.45), 0 2px 8px rgba(0,0,0,0.14);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      /* Radiating ring that expands and fades outward */
      .wa-pill::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: #25D366;
        z-index: -1;
        animation: wa-radiate 2.2s ease-out infinite;
      }
      .wa-pill:hover {
        transform: translateY(-2px) scale(1.03);
        box-shadow: 0 6px 30px rgba(37, 211, 102, 0.7), 0 3px 10px rgba(0,0,0,0.18);
        color: #ffffff;
      }
      .wa-pill__icon { flex-shrink: 0; display: block; }
      .wa-pill__text { white-space: nowrap; }
      @keyframes wa-radiate {
        0%   { transform: scale(1);    opacity: 0.55; }
        70%  { transform: scale(1.35); opacity: 0; }
        100% { transform: scale(1.35); opacity: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        .wa-pill::before { animation: none; }
      }
    </style>
  </body>
</html>
