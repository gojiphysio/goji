---
/**
 * BaseLayout — document shell: <head>, fonts, tokens, skip link, site header
 * and footer. Pass `bare` to drop the header/footer (used by the styleguide).
 */
import "@fontsource-variable/newsreader/standard.css";
import "@fontsource-variable/figtree/wght.css";
import newsreaderLatin from "@fontsource-variable/newsreader/files/newsreader-latin-standard-normal.woff2?url";
import figtreeLatin from "@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url";
import { cta } from "../lib/links.ts";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/watercolor.css";

import LogoLockup from "../components/LogoLockup.astro";
import Button from "../components/Button.astro";
import SearchDialog from "../components/SearchDialog.astro";
import { SITE } from "../lib/site.ts";
import { businessSchema } from "../lib/schema.ts";
import type { SearchType } from "../lib/search.ts";

interface Props {
  title?: string;
  description?: string;
  bare?: boolean;
  noindex?: boolean;
  /** Extra JSON-LD blocks (FAQPage, MedicalWebPage, BreadcrumbList, Person …)
   *  rendered alongside the site-wide LocalBusiness schema. Helps AI answer
   *  engines and rich results parse each page's specific content. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Whether this page belongs in site search. Set false for utility pages
   *  (search itself, the booking form, privacy, 404, styleguide) so results
   *  stay content pages people actually want to land on. */
  searchable?: boolean;
  /** Which bucket this page shows under in search results. */
  searchType?: SearchType;
  /** Per-page link-preview image (1200x630 JPG under /public) and its alt
   *  text. Defaults to the site-wide prenatal image. */
  ogImage?: string;
  ogImageAlt?: string;
}
const {
  title = SITE.seoTitle,
  description = SITE.seoDescription,
  bare = false,
  noindex = false,
  schema,
  searchable = true,
  searchType = "Page",
  ogImage: ogImagePath = "/og-image-prenatal.jpg",
  ogImageAlt = "A Goji physiotherapist guiding a pregnant woman through an assisted side stretch",
} = Astro.props;

// Pagefind indexes only what is inside a `data-pagefind-body` element, so
// tagging <main> keeps the header, footer and floating CTA out of every result.
// Repeated in-page CTA blocks are stripped via `exclude_selectors` in
// pagefind.yml. See the website AGENTS.md for the full contract.
const searchAttrs = searchable
  ? { "data-pagefind-body": true, "data-pagefind-filter": `type:${searchType}` }
  : { "data-pagefind-ignore": true };
const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const origin = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, origin);
// Link-preview image. A new filename when it changes, so WhatsApp/Facebook
// caches pick it up instead of serving the old picture.
const ogImage = new URL(ogImagePath, origin);


const isHome = Astro.url.pathname === "/";

// Footer site map. Internal links end in "/" (Cloudflare 308s the bare form).
const footerMap = [
  {
    title: "Care",
    links: [
      { href: "/services/", label: "All services" },
      { href: "/womens-health-physiotherapy-singapore/", label: "Women's health" },
      { href: "/services/pelvic-floor-physiotherapy/", label: "Pelvic floor physiotherapy" },
      { href: "/pathways/postpartum/", label: "Postpartum pathway" },
      { href: "/services/paediatric-physiotherapy/", label: "Paediatric physiotherapy" },
      { href: "/services/clinical-pilates/", label: "Clinical Pilates" },
      { href: "/conditions/", label: "Conditions we treat" },
    ],
  },
  {
    title: "Clinic",
    links: [
      { href: isHome ? "#about" : "/#about", label: "About Goji" },
      { href: isHome ? "#team" : "/#team", label: "Our team" },
      { href: "/media/", label: "Media" },
      { href: "/blog/", label: "Blog" },
      { href: "/physiotherapy-lentor/", label: "Physiotherapy in Lentor" },
      { href: "/book/", label: "Book an appointment" },
    ],
  },
];
const nav = [
  { href: isHome ? "#about" : "/#about", label: "About" },
  { href: "/services/", label: "Services" },
  { href: "/conditions/", label: "Conditions" },
  { href: "/media/", label: "Media" },
  { href: "/blog/", label: "Blog" },
  { href: isHome ? "#team" : "/#team", label: "Team" },
  { href: "/getting-here/", label: "Find us" },
];

// GA4 (website tracking). Inert until PUBLIC_GA4_ID is set in the Cloudflare
// Pages build env — dev/preview and the un-launched prototype emit no tag.
// NOTE: a PDPA consent mechanism must be in place before enabling in
// production (see business-intelligence/scripts/dashboard/DEPLOY.md).
const GA4_ID = import.meta.env.PUBLIC_GA4_ID;

// First-party landing beacon → goji-booking /api/web-event. Captures HOW the
// visitor arrived (utm_*, gclid, fbclid, referrer, and the go-link click-id
// passthrough `?cid`) against a first-party visitor_id + the shared booking
// session_id, so the dashboard funnel can trace origin → surface → CTA → booked.
// Inert until PUBLIC_BOOKING_API is set (same seam the booking form uses), so
// dev/preview/mock builds emit nothing. Same PDPA-consent caveat as GA4.
const BOOKING_API = import.meta.env.PUBLIC_BOOKING_API;

// Google Ads conversion tracking. Inert until PUBLIC_GADS_ID (e.g. "AW-123456789")
// is set; the booking-confirmation event then reports a "booked" conversion so
// Smart Bidding optimises toward booking-producing queries (not cheap brand
// clicks). PUBLIC_GADS_BOOKING_LABEL is the conversion action's label — both come
// from the Website conversion action you create in Google Ads (see
// marketing/ads/google-ads-playbook.md). Same PDPA-consent caveat as GA4.
const GADS_ID = import.meta.env.PUBLIC_GADS_ID;
const GADS_BOOKING_LABEL = import.meta.env.PUBLIC_GADS_BOOKING_LABEL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/brand/logo_mark_transparent.png" />
    <meta name="theme-color" content="#f7f2e0" />

    {/* First paint: preload the two faces above the fold so text paints in
        its own font, and mark the page for the watercolour layer before it
        paints, so scroll-revealed content and painted-in photos start hidden
        instead of flashing on, off, then on again. If the engine never loads,
        drop the mark after 3s and show everything. */}
    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add("gj-js");
      setTimeout(function () { if (!window.Goji) document.documentElement.classList.remove("gj-js"); }, 3000);
    </script>

    {/* Open Graph / Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Goji Physiotherapy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {!bare && <script type="application/ld+json" set:html={JSON.stringify(businessSchema(origin))} />}
    {extraSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    {/* First-party landing beacon (attribution). Inert without PUBLIC_BOOKING_API. */}
    {
      BOOKING_API && (
        <script is:inline define:vars={{ BOOKING_API }}>
          (function () {
            try {
              var qp = new URLSearchParams(location.search);
              var pick = function (k) { return qp.get(k) || ""; };
              var rid = function () { return (crypto.randomUUID ? crypto.randomUUID() : String(Math.random()).slice(2)); };
              var vid = localStorage.getItem("goji_vid");
              if (!vid) { vid = rid(); localStorage.setItem("goji_vid", vid); }
              var sid = sessionStorage.getItem("goji_booking_sid");
              var newSession = false;
              if (!sid) { sid = rid(); sessionStorage.setItem("goji_booking_sid", sid); newSession = true; }
              // First-touch attribution: capture once, never overwrite, and only when
              // there is a real signal (so a direct hit doesn't claim an empty first-touch).
              if (!localStorage.getItem("goji_attr")) {
                var a = {
                  utm_source: pick("utm_source"), utm_medium: pick("utm_medium"),
                  utm_campaign: pick("utm_campaign"), utm_content: pick("utm_content"),
                  utm_term: pick("utm_term"), gclid: pick("gclid"), fbclid: pick("fbclid"),
                  go_click_id: pick("cid"), referrer: document.referrer || "",
                  landing_path: location.pathname || ""
                };
                var extRef = a.referrer && a.referrer.indexOf(location.host) === -1;
                if (a.utm_source || a.gclid || a.fbclid || a.go_click_id || extRef) {
                  localStorage.setItem("goji_attr", JSON.stringify(a));
                }
              }
              var s = {};
              try { s = JSON.parse(localStorage.getItem("goji_attr") || "{}"); } catch (e) {}
              // One payload shape for every event type, so an engagement row is
              // attributable exactly like the arrival row it belongs to.
              var send = function (type, extra) {
                var body = {
                  event_type: type,
                  visitor_id: vid, session_id: sid,
                  utm_source: s.utm_source || pick("utm_source"),
                  utm_medium: s.utm_medium || pick("utm_medium"),
                  utm_campaign: s.utm_campaign || pick("utm_campaign"),
                  utm_content: s.utm_content || pick("utm_content"),
                  utm_term: s.utm_term || pick("utm_term"),
                  gclid: s.gclid || pick("gclid"),
                  fbclid: s.fbclid || pick("fbclid"),
                  go_click_id: s.go_click_id || pick("cid"),
                  referrer: document.referrer || "",
                  landing_path: location.pathname || ""
                };
                if (extra) for (var k in extra) body[k] = extra[k];
                // keepalive (not sendBeacon): the API is cross-origin, and
                // sendBeacon cannot run the CORS preflight a JSON body needs,
                // so the browser would silently drop it on unload.
                fetch(BOOKING_API + "/api/web-event", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(body),
                  keepalive: true
                }).catch(function () {});
              };
              send(newSession ? "session_start" : "page_view");

              // --- Engagement: how long was this page VISIBLE, and how far was
              // it read? Arrival rows alone can't tell a 3-second bounce from a
              // 90-second read, and that distinction decides whether a landing
              // page fails on load or fails to close.
              var maxScroll = 0;
              var measureScroll = function () {
                try {
                  var h = document.documentElement.scrollHeight;
                  if (!h) return;
                  // How far down the page the BOTTOM of the viewport reached, so
                  // a page shorter than the viewport is 100% seen without any
                  // scrolling — no special case to mis-fire.
                  var pct = Math.round(((window.scrollY + window.innerHeight) / h) * 100);
                  if (pct > maxScroll) maxScroll = Math.max(0, Math.min(pct, 100));
                } catch (e) { /* ignore */ }
              };
              // Deliberately NOT measured at init: during first layout
              // scrollHeight is not yet final, which reads as "whole page seen"
              // and pins maxScroll at 100 for the rest of the page's life. The
              // scroll listener and the flush below both measure post-layout.
              window.addEventListener("scroll", measureScroll, { passive: true });

              // Accumulate only foreground time — a tab left open in the
              // background all afternoon is not 4 hours of attention.
              var visibleSince = document.visibilityState === "visible" ? Date.now() : 0;
              var dwell = 0;
              var sent = false;
              var flush = function () {
                if (sent) return;
                sent = true;
                if (visibleSince) { dwell += Date.now() - visibleSince; visibleSince = 0; }
                measureScroll();
                send("page_engagement", { dwell_ms: dwell, scroll_pct: maxScroll });
              };
              document.addEventListener("visibilitychange", function () {
                if (document.visibilityState === "visible") {
                  if (!visibleSince) visibleSince = Date.now();
                } else {
                  // First hide is the exit for our purposes. If they come back
                  // and keep reading we undercount rather than emit a second
                  // row — one row per page load keeps the grain simple.
                  flush();
                }
              });
              // Back button / bfcache / close. visibilitychange covers app
              // switches; pagehide covers navigations that skip it.
              window.addEventListener("pagehide", flush);
            } catch (e) { /* never break the page for analytics */ }
          })();
        </script>
      )
    }

    {/* On-site CTA golden-flow decorator. Appends ?sid=<booking session>&p=<path>
        to our own go-link CTAs (go.gojiphysio.com/web-*) so a WhatsApp/book tap
        can be tied back to the booking session + page it came from (the dashboard
        joins link_click_events.session_id -> booking_funnel_events.session_id).
        A wa.me redirect can't use the ?cid passthrough and cross-origin Referer is
        trimmed to the origin, so we pass session context explicitly. Always on —
        it only rewrites our own links and degrades to just ?p= when no session id
        exists yet. Never breaks the page. */}
    <script is:inline>
      (function () {
        try {
          var PREFIX = "https://go.gojiphysio.com/web-";
          var decorate = function (a) {
            try {
              var href = a.getAttribute("href") || "";
              if (href.indexOf(PREFIX) !== 0) return;
              var sid = "";
              try { sid = sessionStorage.getItem("goji_booking_sid") || ""; } catch (e) {}
              var u = new URL(href);
              if (sid) u.searchParams.set("sid", sid); else u.searchParams.delete("sid");
              u.searchParams.set("p", location.pathname || "");
              a.setAttribute("href", u.toString());
            } catch (e) { /* leave the link as-is */ }
          };
          var decorateAll = function () {
            var links = document.querySelectorAll('a[href^="' + PREFIX + '"]');
            for (var i = 0; i < links.length; i++) decorate(links[i]);
          };
          if (document.readyState !== "loading") decorateAll();
          else document.addEventListener("DOMContentLoaded", decorateAll);
          // Re-decorate at interaction time so late/dynamic links and a session id
          // set after load (e.g. by the booking form) are still captured.
          var onInteract = function (ev) {
            var a = ev.target && ev.target.closest ? ev.target.closest('a[href^="' + PREFIX + '"]') : null;
            if (a) decorate(a);
          };
          document.addEventListener("pointerdown", onInteract, true);
          document.addEventListener("focusin", onInteract, true);
        } catch (e) { /* never break the page for analytics */ }
      })();
    </script>

    {/* GA4 (website tracking). Inert until PUBLIC_GA4_ID is set in the build env. */}
    {
      GA4_ID && (
        <Fragment>
          <script is:inline define:vars={{ GA4_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", GA4_ID);
            // Fetch the gtag library only after the page has loaded, so its
            // ~190 KB doesn't compete with first paint (mobile LCP). Calls made
            // before then queue in dataLayer and are sent once it arrives; gclid
            // is read from the URL whenever it runs.
            (function (id) {
              function load() {
                var s = document.createElement("script");
                s.async = true;
                s.src = "https://www.googletagmanager.com/gtag/js?id=" + id;
                document.head.appendChild(s);
              }
              if (document.readyState === "complete") load();
              else window.addEventListener("load", load, { once: true });
            })(GA4_ID);
          </script>
        </Fragment>
      )
    }

    {/* Google Ads conversion tag. Inert until PUBLIC_GADS_ID is set. Shares the
        gtag/dataLayer shim with GA4; exposes the booking conversion target that
        BookingForm fires on a confirmed booking. */}
    {
      GADS_ID && (
        <Fragment>
          <script is:inline define:vars={{ GADS_ID, GADS_BOOKING_LABEL }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = window.gtag || gtag;
            gtag("js", new Date());
            gtag("config", GADS_ID);
            if (GADS_BOOKING_LABEL) window.__gojiBookingConversion = GADS_ID + "/" + GADS_BOOKING_LABEL;
            // Fetch the gtag library only after the page has loaded, so its
            // ~190 KB doesn't compete with first paint (mobile LCP). Calls made
            // before then queue in dataLayer and are sent once it arrives; gclid
            // is read from the URL whenever it runs.
            (function (id) {
              function load() {
                var s = document.createElement("script");
                s.async = true;
                s.src = "https://www.googletagmanager.com/gtag/js?id=" + id;
                document.head.appendChild(s);
              }
              if (document.readyState === "complete") load();
              else window.addEventListener("load", load, { once: true });
            })(GADS_ID);
          </script>
        </Fragment>
      )
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    {
      !bare && (
        <header class="site-header">
          <div class="container site-header__inner">
            <a href="/" class="site-header__logo" aria-label="Goji home">
              <LogoLockup variant="main" height={52} />
            </a>
            <nav class="site-nav" aria-label="Primary">
              {nav.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </nav>
            <div class="site-header__cta">
              <button type="button" class="nav-search" data-search-open aria-label="Search this site">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" />
                  <path d="M20 20l-3.5-3.5" />
                </svg>
              </button>
              <a
                href="https://go.gojiphysio.com/web-wa"
                class="header-wa"
                aria-label="Chat with us on WhatsApp"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="header-wa__icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
                </svg>
                <span class="header-wa__text">WhatsApp</span>
              </a>
              <Button href="/book/" variant="secondary" class="header-book">Book</Button>
              <details class="mobile-menu">
                <summary class="nav-toggle" aria-label="Menu">
                  <svg class="nav-toggle__open" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h16" />
                  </svg>
                  <svg class="nav-toggle__close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18" />
                  </svg>
                </summary>
                <nav class="site-nav-mobile" aria-label="Primary">
                  <button type="button" class="site-nav-mobile__search" data-search-open>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                      <circle cx="11" cy="11" r="7" />
                      <path d="M20 20l-3.5-3.5" />
                    </svg>
                    Search
                  </button>
                  {nav.map((item) => (
                    <a href={item.href}>{item.label}</a>
                  ))}
                </nav>
              </details>
            </div>
          </div>
        </header>
      )
    }

    <main id="main" {...searchAttrs}>
      <slot />
    </main>

    {!bare && <SearchDialog />}

    {
      !bare && (
        <footer class="site-footer">
          <div class="container site-footer__inner">
            <div class="site-footer__brand">
              <LogoLockup variant="light" height={56} class="site-footer__logo" />
              <p class="site-footer__tagline">{SITE.tagline}</p>
            </div>
            <nav class="site-footer__map" aria-label="Site map">
              {footerMap.map((col) => (
                <div class="site-footer__col">
                  <h2 class="site-footer__heading">{col.title}</h2>
                  <ul>
                    {col.links.map((l) => (
                      <li><a href={l.href}>{l.label}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
              <div class="site-footer__col">
                <h2 class="site-footer__heading">Visit</h2>
                <ul>
                  <li>{SITE.address.line1}<br />{SITE.address.line2}</li>
                  {SITE.hours.map((h) => <li>{h.days}: {h.time}</li>)}
                  <li><a href={cta("web-wa")} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp us on ${SITE.phone}`}>{SITE.phone} (WhatsApp)</a></li>
                  <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
                  <li><a href="/getting-here/">Getting here</a></li>
                  <li><a href={SITE.googleMaps} target="_blank" rel="noopener noreferrer">Open in Google Maps ↗</a></li>
                  <li><a href={SITE.instagram} target="_blank" rel="noopener noreferrer">Instagram @gojiphysio ↗</a></li>
                </ul>
              </div>
            </nav>
          </div>
          <div class="container site-footer__copyright">
            <p>&copy; {new Date().getFullYear()} Goji Health. All rights reserved. &middot; <a href="/privacy/">Privacy</a></p>
          </div>
        </footer>
      )
    }

    <style>
      .skip-link {
        position: absolute;
        left: var(--space-4);
        top: -3rem;
        background: var(--color-ink);
        color: var(--color-linen);
        padding: 0.5rem 1rem;
        border-radius: var(--radius-sm);
        z-index: 100;
        transition: top var(--dur) var(--ease);
      }
      .skip-link:focus {
        top: var(--space-4);
        color: var(--color-linen);
      }

      /* Frosted linen, picking up a hairline once the page scrolls under it. */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background-color: color-mix(in srgb, var(--bg-page) 84%, transparent);
        -webkit-backdrop-filter: saturate(1.2) blur(14px);
        backdrop-filter: saturate(1.2) blur(14px);
      }
      .site-header__logo { flex: none; display: block; }
      .site-header__logo :global(.logo) { margin-inline: -8px; }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-5);
        min-height: 72px;
      }
      .site-nav {
        display: none;
        gap: var(--space-5);
      }
      .site-nav a {
        position: relative;
        font-family: var(--font-body);
        color: var(--text-default);
        text-decoration: none;
        font-size: var(--fs-small);
        font-weight: var(--weight-medium);
        padding-block: 6px;
        white-space: nowrap;
      }
      /* a deep-red underline draws in from the left */
      .site-nav a::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 1.5px;
        background: var(--color-primary);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 400ms var(--ease);
      }
      .site-nav a:hover { color: var(--text-default); }
      .site-nav a:hover::after { transform: scaleX(1); }
      @media (min-width: 880px) {
        .site-nav {
          display: flex;
        }
      }
      /* Seven links fit at 880px only with a tighter gap. */
      @media (min-width: 880px) and (max-width: 1023px) {
        .site-nav {
          gap: var(--space-4);
        }
      }

      .site-footer {
        background-color: var(--bg-closing);
        color: var(--color-linen);
        padding-top: var(--space-8);
      }
      .site-footer :focus-visible { outline-color: var(--color-linen); }
      .site-footer__brand :global(.site-footer__logo) { margin: -14px -10px -10px; }
      .site-footer__inner {
        display: grid;
        gap: var(--space-7);
      }
      @media (min-width: 900px) {
        .site-footer__inner { grid-template-columns: 4fr 8fr; gap: var(--space-9); }
      }
      .site-footer__tagline {
        margin-top: var(--space-3);
        font-size: var(--fs-small);
        color: var(--text-on-dark-soft);
        max-width: 28ch;
      }
      .site-footer__map {
        display: grid;
        gap: var(--space-7) var(--space-6);
        grid-template-columns: 1fr 1fr;
      }
      @media (min-width: 900px) {
        .site-footer__map { grid-template-columns: 1fr 1fr 1.3fr; }
      }
      .site-footer__col:last-child { grid-column: 1 / -1; }
      @media (min-width: 900px) {
        .site-footer__col:last-child { grid-column: auto; }
      }
      .site-footer__heading {
        font-family: var(--font-body);
        font-size: var(--fs-small);
        font-weight: var(--weight-semibold);
        letter-spacing: 0;
        color: var(--color-linen);
        margin-bottom: var(--space-4);
      }
      .site-footer__col ul { list-style: none; padding: 0; display: grid; gap: var(--space-3); }
      .site-footer__col li {
        font-size: var(--fs-small);
        line-height: 1.5;
        color: var(--text-on-dark-soft);
      }
      .site-footer__col a {
        color: var(--text-on-dark-soft);
        text-decoration: none;
        transition: color var(--dur) var(--ease);
      }
      .site-footer__col a:hover { color: var(--color-linen); text-decoration: underline; text-underline-offset: 0.2em; }
      .site-footer__copyright {
        margin-top: var(--space-6);
        padding-block: var(--space-4);
        border-top: 1px solid color-mix(in srgb, var(--color-linen) 10%, transparent);
        font-size: var(--fs-caption);
        color: color-mix(in srgb, var(--color-linen) 45%, transparent);
      }
      .site-footer__copyright a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
      .site-footer__copyright a:hover { color: var(--color-linen); }

      /* Header CTAs: WhatsApp sits next to Book, right of the nav. */
      .site-header__cta {
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }
      /* WhatsApp is the primary action: brand red, glyph in the label colour
         (never WhatsApp green - it clashes with burgundy). */
      .header-wa {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 44px;
        padding: 0 1.1rem;
        border-radius: var(--radius-pill);
        background: var(--cta-bg);
        color: var(--cta-text);
        text-decoration: none;
        font-family: var(--font-body);
        font-weight: var(--weight-semibold);
        font-size: var(--fs-small);
        line-height: 1;
        white-space: nowrap;
        transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
      }
      .header-wa:hover {
        background: var(--cta-bg-hover);
        color: var(--cta-text);
      }
      /* Search trigger. Desktop only - below the desktop-nav breakpoint it
         lives in the hamburger so WhatsApp and Book keep the top bar. */
      .nav-search {
        display: none;
        align-items: center;
        justify-content: center;
        /* 44px: the comfortable-thumb minimum, and most of our traffic is
           on a phone. Matches .nav-toggle beside it. */
        width: 2.75rem;
        height: 2.75rem;
        padding: 0;
        border: none;
        border-radius: var(--radius-sm);
        background: transparent;
        color: var(--text-default);
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition: background var(--dur) var(--ease);
      }
      .nav-search:hover {
        background: var(--color-linen-deep);
      }
      @media (min-width: 880px) {
        .nav-search { display: inline-flex; }
      }

      .header-wa__icon { flex: none; display: block; }
      /* Icon-only on the smallest screens so it sits cleanly next to Book. */
      .header-wa__text { display: none; }
      @media (min-width: 480px) {
        .header-wa__text { display: inline; }
      }

      /* Mobile menu: hamburger toggle + dropdown, shown below the desktop-nav
         breakpoint. Uses <details> so the toggle works without JS. */
      .mobile-menu {
        position: static;
      }
      .nav-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        /* 44px tap target, matching .nav-search. */
        width: 2.75rem;
        height: 2.75rem;
        border-radius: var(--radius-sm);
        color: var(--text-default);
        cursor: pointer;
        list-style: none;
        -webkit-tap-highlight-color: transparent;
      }
      .nav-toggle::-webkit-details-marker { display: none; }
      .nav-toggle:hover {
        background: var(--color-linen-deep);
      }
      .nav-toggle__close { display: none; }
      .mobile-menu[open] .nav-toggle__open { display: none; }
      .mobile-menu[open] .nav-toggle__close { display: block; }

      .site-nav-mobile {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        flex-direction: column;
        background: var(--bg-page);
        border-bottom: 1px solid var(--rule);
        padding: var(--space-2) var(--gutter) var(--space-5);
        box-shadow: var(--shadow-md);
      }
      .mobile-menu[open] .site-nav-mobile { display: flex; }
      .site-nav-mobile a {
        font-family: var(--font-body);
        font-variation-settings: var(--font-body-axes);
        color: var(--text-default);
        text-decoration: none;
        font-size: 1.125rem;
        font-weight: var(--weight-semibold);
        padding: var(--space-3) 0;
        border-bottom: 1px solid var(--rule);
      }
      .site-nav-mobile a:last-child { border-bottom: none; }
      .site-nav-mobile a:hover { color: var(--text-accent); }
      /* Search, first in the menu: styled as a nav row, opens the dialog. */
      .site-nav-mobile__search {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font: inherit;
        font-family: var(--font-body);
        font-variation-settings: var(--font-body-axes);
        color: var(--text-default);
        font-size: 1.125rem;
        font-weight: var(--weight-semibold);
        text-align: left;
        padding: var(--space-3) 0;
        border: none;
        border-bottom: 1px solid var(--rule);
        background: transparent;
        cursor: pointer;
      }
      .site-nav-mobile__search:hover { color: var(--text-accent); }

      /* Desktop: hide the hamburger; the inline nav takes over. */
      @media (min-width: 880px) {
        .mobile-menu { display: none; }
      }
    </style>

    <script>
      // Watercolour engine: paints data-gj-bloom / data-gj-wash / data-gj-veil
      // elements and reveals .gj-reveal / .gj-mark as they scroll into view.
      import "../scripts/goji-watercolor.js";
      (window as unknown as { Goji: { enhance: () => void } }).Goji.enhance();
    </script>

    <script>
      // Close the mobile menu on link tap (for same-page anchors), Escape, or
      // when the viewport grows into the desktop-nav layout.
      const menu = document.querySelector(".mobile-menu");
      if (menu) {
        const close = () => menu.removeAttribute("open");
        menu.querySelectorAll(".site-nav-mobile a, [data-search-open]").forEach((a) =>
          a.addEventListener("click", close),
        );
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") close();
        });
        window
          .matchMedia("(min-width: 880px)")
          .addEventListener("change", (e) => {
            if (e.matches) close();
          });
      }
    </script>
  </body>
</html>
