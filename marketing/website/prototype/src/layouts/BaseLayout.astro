---
/**
 * BaseLayout — document shell: <head>, fonts, tokens, skip link, site header
 * and footer. Pass `bare` to drop the header/footer (used by the styleguide).
 */
import "@fontsource-variable/inter";
import "@fontsource/plus-jakarta-sans/400.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "../styles/tokens.css";
import "../styles/base.css";

import LogoLockup from "../components/LogoLockup.astro";
import Button from "../components/Button.astro";
import { SITE } from "../lib/site.ts";

interface Props {
  title?: string;
  description?: string;
  bare?: boolean;
  noindex?: boolean;
  /** Extra JSON-LD blocks (FAQPage, MedicalWebPage, BreadcrumbList, Person …)
   *  rendered alongside the site-wide LocalBusiness schema. Helps AI answer
   *  engines and rich results parse each page's specific content. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = SITE.seoTitle,
  description = SITE.seoDescription,
  bare = false,
  noindex = false,
  schema,
} = Astro.props;
const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const origin = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, origin);
const ogImage = new URL("/og-image.jpg", origin);

// LocalBusiness structured data for local SEO (NAP from SITE).
const businessSchema = {
  "@context": "https://schema.org",
  "@type": ["MedicalClinic", "LocalBusiness"],
  name: SITE.fullName,
  alternateName: SITE.name,
  url: origin.href,
  image: ogImage.href,
  email: SITE.email,
  telephone: SITE.phoneE164,
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.address.line1,
    addressLocality: "Singapore",
    postalCode: "788887",
    addressCountry: "SG",
  },
  hasMap: SITE.googleMaps,
  areaServed: [
    { "@type": "Place", name: "Lentor, Singapore" },
    { "@type": "Place", name: "Singapore" },
  ],
  medicalSpecialty: "Physiotherapy",
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      opens: "08:00",
      closes: "20:00",
    },
  ],
  availableService: [
    "Physiotherapy",
    "Women's Health Physiotherapy",
    "Pregnancy Physiotherapy",
    "Postnatal Physiotherapy",
    "Mummy & Baby Assessment",
    "Paediatric Physiotherapy",
    "Clinical Pilates",
    "Strength & Conditioning",
    "Lymphoedema Physiotherapy",
    "Vestibular Rehabilitation",
  ].map((name) => ({ "@type": "MedicalTherapy", name })),
  sameAs: [SITE.instagram, SITE.googleMaps],
};

const isHome = Astro.url.pathname === "/";
const nav = [
  { href: isHome ? "#about" : "/#about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/conditions", label: "Conditions" },
  { href: isHome ? "#team" : "/#team", label: "Team" },
  { href: isHome ? "#contact" : "/#contact", label: "Find us" },
];

// GA4 (website tracking). Inert until PUBLIC_GA4_ID is set in the Cloudflare
// Pages build env — dev/preview and the un-launched prototype emit no tag.
// NOTE: a PDPA consent mechanism must be in place before enabling in
// production (see business-intelligence/scripts/dashboard/DEPLOY.md).
const GA4_ID = import.meta.env.PUBLIC_GA4_ID;

// First-party landing beacon → goji-booking /api/web-event. Captures HOW the
// visitor arrived (utm_*, gclid, fbclid, referrer, and the go-link click-id
// passthrough `?cid`) against a first-party visitor_id + the shared booking
// session_id, so the dashboard funnel can trace origin → surface → CTA → booked.
// Inert until PUBLIC_BOOKING_API is set (same seam the booking form uses), so
// dev/preview/mock builds emit nothing. Same PDPA-consent caveat as GA4.
const BOOKING_API = import.meta.env.PUBLIC_BOOKING_API;

// Google Ads conversion tracking. Inert until PUBLIC_GADS_ID (e.g. "AW-123456789")
// is set; the booking-confirmation event then reports a "booked" conversion so
// Smart Bidding optimises toward booking-producing queries (not cheap brand
// clicks). PUBLIC_GADS_BOOKING_LABEL is the conversion action's label — both come
// from the Website conversion action you create in Google Ads (see
// marketing/ads/google-ads-playbook.md). Same PDPA-consent caveat as GA4.
const GADS_ID = import.meta.env.PUBLIC_GADS_ID;
const GADS_BOOKING_LABEL = import.meta.env.PUBLIC_GADS_BOOKING_LABEL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/brand/logo_mark_transparent.png" />
    <meta name="theme-color" content="#91171d" />

    {/* Open Graph / Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Goji Physiotherapy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    {!bare && <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />}
    {extraSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    {/* First-party landing beacon (attribution). Inert without PUBLIC_BOOKING_API. */}
    {
      BOOKING_API && (
        <script is:inline define:vars={{ BOOKING_API }}>
          (function () {
            try {
              var qp = new URLSearchParams(location.search);
              var pick = function (k) { return qp.get(k) || ""; };
              var rid = function () { return (crypto.randomUUID ? crypto.randomUUID() : String(Math.random()).slice(2)); };
              var vid = localStorage.getItem("goji_vid");
              if (!vid) { vid = rid(); localStorage.setItem("goji_vid", vid); }
              var sid = sessionStorage.getItem("goji_booking_sid");
              var newSession = false;
              if (!sid) { sid = rid(); sessionStorage.setItem("goji_booking_sid", sid); newSession = true; }
              // First-touch attribution: capture once, never overwrite, and only when
              // there is a real signal (so a direct hit doesn't claim an empty first-touch).
              if (!localStorage.getItem("goji_attr")) {
                var a = {
                  utm_source: pick("utm_source"), utm_medium: pick("utm_medium"),
                  utm_campaign: pick("utm_campaign"), utm_content: pick("utm_content"),
                  utm_term: pick("utm_term"), gclid: pick("gclid"), fbclid: pick("fbclid"),
                  go_click_id: pick("cid"), referrer: document.referrer || "",
                  landing_path: location.pathname || ""
                };
                var extRef = a.referrer && a.referrer.indexOf(location.host) === -1;
                if (a.utm_source || a.gclid || a.fbclid || a.go_click_id || extRef) {
                  localStorage.setItem("goji_attr", JSON.stringify(a));
                }
              }
              var s = {};
              try { s = JSON.parse(localStorage.getItem("goji_attr") || "{}"); } catch (e) {}
              fetch(BOOKING_API + "/api/web-event", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  event_type: newSession ? "session_start" : "page_view",
                  visitor_id: vid, session_id: sid,
                  utm_source: s.utm_source || pick("utm_source"),
                  utm_medium: s.utm_medium || pick("utm_medium"),
                  utm_campaign: s.utm_campaign || pick("utm_campaign"),
                  utm_content: s.utm_content || pick("utm_content"),
                  utm_term: s.utm_term || pick("utm_term"),
                  gclid: s.gclid || pick("gclid"),
                  fbclid: s.fbclid || pick("fbclid"),
                  go_click_id: s.go_click_id || pick("cid"),
                  referrer: document.referrer || "",
                  landing_path: location.pathname || ""
                }),
                keepalive: true
              }).catch(function () {});
            } catch (e) { /* never break the page for analytics */ }
          })();
        </script>
      )
    }

    {/* GA4 (website tracking). Inert until PUBLIC_GA4_ID is set in the build env. */}
    {
      GA4_ID && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} />
          <script is:inline define:vars={{ GA4_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", GA4_ID);
          </script>
        </Fragment>
      )
    }

    {/* Google Ads conversion tag. Inert until PUBLIC_GADS_ID is set. Shares the
        gtag/dataLayer shim with GA4; exposes the booking conversion target that
        BookingForm fires on a confirmed booking. */}
    {
      GADS_ID && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GADS_ID}`} />
          <script is:inline define:vars={{ GADS_ID, GADS_BOOKING_LABEL }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = window.gtag || gtag;
            gtag("js", new Date());
            gtag("config", GADS_ID);
            if (GADS_BOOKING_LABEL) window.__gojiBookingConversion = GADS_ID + "/" + GADS_BOOKING_LABEL;
          </script>
        </Fragment>
      )
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    {
      !bare && (
        <header class="site-header">
          <div class="container site-header__inner">
            <a href="/" class="site-header__logo" aria-label="Goji home">
              <LogoLockup variant="light" height={34} />
            </a>
            <nav class="site-nav" aria-label="Primary">
              {nav.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </nav>
            <div class="site-header__cta">
              <a
                href="https://go.gojiphysio.com/web-wa"
                class="header-wa"
                aria-label="Chat with us on WhatsApp"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="header-wa__icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
                </svg>
                <span class="header-wa__text">WhatsApp</span>
              </a>
              <Button href="/book" variant="primary">Book</Button>
            </div>
          </div>
        </header>
      )
    }

    <main id="main">
      <slot />
    </main>

    {
      !bare && (
        <footer class="site-footer">
          <div class="container site-footer__inner">
            <div class="site-footer__brand">
              <LogoLockup variant="light" height={30} />
              <p class="site-footer__tagline">{SITE.tagline}</p>
            </div>
            <div class="site-footer__meta">
              <p>{SITE.address.line1}<br />{SITE.address.line2}</p>
              <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
              <p>
                <a href="https://www.instagram.com/gojiphysio/" target="_blank" rel="noopener noreferrer">
                  @gojiphysio ↗
                </a>
              </p>
            </div>
          </div>
          <div class="container site-footer__copyright">
            <p>&copy; {new Date().getFullYear()} Goji Health. All rights reserved. &middot; <a href="/privacy">Privacy</a></p>
          </div>
        </footer>
      )
    }

    <style>
      .skip-link {
        position: absolute;
        left: var(--space-4);
        top: -3rem;
        background: var(--color-ink);
        color: var(--color-linen);
        padding: 0.5rem 1rem;
        border-radius: var(--radius-sm);
        z-index: 100;
        transition: top var(--dur) var(--ease);
      }
      .skip-link:focus {
        top: var(--space-4);
        color: var(--color-linen);
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background-color: var(--color-ink);
        border-bottom: 1px solid color-mix(in srgb, var(--color-linen) 15%, transparent);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-5);
        min-height: 68px;
      }
      .site-nav {
        display: none;
        gap: var(--space-5);
      }
      .site-nav a {
        font-family: var(--font-display);
        color: color-mix(in srgb, var(--color-linen) 75%, transparent);
        text-decoration: none;
        font-size: var(--fs-small);
        font-weight: var(--weight-medium);
        letter-spacing: -0.01em;
        transition: color var(--dur) var(--ease);
      }
      .site-nav a:hover {
        color: var(--color-linen);
      }
      @media (min-width: 880px) {
        .site-nav {
          display: flex;
        }
      }

      .site-footer {
        background-color: var(--color-ink);
        color: var(--color-linen);
        padding-top: var(--space-8);
        border-top: 1px solid color-mix(in srgb, var(--color-linen) 15%, transparent);
      }
      .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-7);
        justify-content: space-between;
        align-items: start;
      }
      .site-footer__tagline {
        margin-top: var(--space-3);
        font-size: var(--fs-small);
        color: color-mix(in srgb, var(--color-linen) 60%, transparent);
        line-height: var(--lh-body);
        max-width: 28ch;
      }
      .site-footer__meta {
        font-size: var(--fs-small);
        display: grid;
        gap: var(--space-2);
        color: color-mix(in srgb, var(--color-linen) 75%, transparent);
      }
      .site-footer__meta a {
        color: var(--color-linen);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
      .site-footer__copyright {
        margin-top: var(--space-6);
        padding-block: var(--space-4);
        border-top: 1px solid color-mix(in srgb, var(--color-linen) 10%, transparent);
        font-size: var(--fs-caption);
        color: color-mix(in srgb, var(--color-linen) 45%, transparent);
      }
      .site-footer__copyright a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
      .site-footer__copyright a:hover { color: var(--color-linen); }

      /* Header CTAs: WhatsApp sits next to Book, right of the nav. */
      .site-header__cta {
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }
      .header-wa {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.7rem 1rem;
        border-radius: var(--radius-pill);
        background: var(--color-whatsapp);
        color: #ffffff;
        text-decoration: none;
        font-family: var(--font-body);
        font-weight: var(--weight-semibold);
        font-size: var(--fs-small);
        line-height: 1;
        white-space: nowrap;
        transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
      }
      .header-wa:hover {
        background: var(--color-whatsapp-hover);
        color: #ffffff;
        transform: translateY(-1px);
      }
      .header-wa__icon { flex: none; display: block; }
      /* Icon-only on the smallest screens so it sits cleanly next to Book. */
      .header-wa__text { display: none; }
      @media (min-width: 480px) {
        .header-wa__text { display: inline; }
      }
    </style>
  </body>
</html>
