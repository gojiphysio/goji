# Cross-cutting ignores for the Goji monorepo.
# Per-project ignores live in each subproject's own .gitignore
# (e.g. business-intelligence/.gitignore).

# OS / editor cruft
.DS_Store
*.swp
*~

# Python
__pycache__/
*.py[cod]

# Machine-specific Claude Code state, in any subproject
**/.claude/settings.local.json
.gstack/

# Regenerable handoff bundle (build artifact)
marketing/goji-website-handoff.zip

# Generated ad review PDFs (regenerate via marketing/ads/import/review_sheet.py + make-pdf)
marketing/ads/*.pdf
