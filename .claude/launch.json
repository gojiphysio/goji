{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "4232"
      ],
      "cwd": "marketing/website",
      "port": 4232
    },
    {
      "name": "website-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4233"
      ],
      "cwd": "marketing/website",
      "port": 4233
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "DASHBOARD_USER=dev DASHBOARD_PASS=dev DASHBOARD_DEV=1 python3 app.py"
      ],
      "cwd": "business-intelligence/scripts/dashboard",
      "port": 8080
    },
    {
      "name": "careers-api-dev",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--with-requirements",
        "careers/requirements.txt",
        "--with",
        "pytest",
        "python",
        "-m",
        "careers.dev_server"
      ],
      "cwd": "business-intelligence/scripts",
      "port": 8090
    },
    {
      "name": "website-careers-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PUBLIC_CAREERS_API=http://localhost:8090 npm run dev -- --port 4234"
      ],
      "cwd": "marketing/website",
      "port": 4234
    }
  ]
}
